<< "D12 PA dim 0 empty True" << endl;
RAP = kk[t0];
IAP = ideal((15)*t0*t0,(139)*t0*t0,(122)*t0*t0,(22)*t0*t0,(85)*t0*t0,(25)*t0*t0,(107)*t0*t0,(64)*t0*t0,(81)*t0*t0,(58)*t0*t0,(137)*t0*t0,(110)*t0*t0,(51)*t0*t0,(181)*t0*t0,(94)*t0*t0);
<< "D12 AP dim 1 empty " << (saturate(IAP, ideal vars RAP) == ideal(1_RAP)) << endl;
RAA = kk[t0];
IAA = ideal((118)*t0*t0,(125)*t0*t0,(177)*t0*t0,(120)*t0*t0,(138)*t0*t0,(64)*t0*t0,(59)*t0*t0,(132)*t0*t0,(80)*t0*t0,(45)*t0*t0,(96)*t0*t0,(3)*t0*t0,(43)*t0*t0,(137)*t0*t0,(169)*t0*t0);

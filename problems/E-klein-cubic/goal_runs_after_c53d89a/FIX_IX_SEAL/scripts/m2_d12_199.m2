kk = ZZ/199;
RPP = kk[t0,t1];
IPP = ideal((21)*t0*t0+(45)*t0*t1+(66)*t1*t1,(66)*t0*t0+(55)*t0*t1+(162)*t1*t1,(24)*t0*t0+(62)*t0*t1+(117)*t1*t1,(19)*t0*t0+(185)*t0*t1+(139)*t1*t1,(92)*t0*t0+(107)*t0*t1+(102)*t1*t1,(31)*t0*t0+(58)*t0*t1+(13)*t1*t1,(61)*t0*t0+(150)*t0*t1+(189)*t1*t1,(103)*t0*t0+(40)*t0*t1+(119)*t1*t1,(55)*t0*t0+(154)*t0*t1+(174)*t1*t1,(178)*t0*t0+(113)*t0*t1+(12)*t1*t1,(150)*t0*t0+(153)*t0*t1+(29)*t1*t1,(177)*t0*t0+(57)*t0*t1+(158)*t1*t1,(85)*t0*t0+(113)*t0*t1+(129)*t1*t1,(6)*t0*t0+(55)*t0*t1+(60)*t1*t1,(86)*t0*t0+(180)*t0*t1+(28)*t1*t1);

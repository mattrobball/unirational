kk = ZZ/353;
RPP = kk[t0,t1];
IPP = ideal((114)*t0*t0+(20)*t0*t1+(344)*t1*t1,(146)*t0*t0+(97)*t0*t1+(340)*t1*t1,(304)*t0*t0+(267)*t0*t1+(137)*t1*t1,(63)*t0*t0+(352)*t0*t1+(275)*t1*t1,(218)*t0*t0+(4)*t0*t1+(17)*t1*t1,(24)*t0*t0+(288)*t0*t1+(210)*t1*t1,(79)*t0*t0+(99)*t0*t1+(145)*t1*t1,(92)*t0*t0+(226)*t0*t1+(344)*t1*t1,(223)*t0*t0+(37)*t0*t1+(247)*t1*t1,(101)*t0*t0+(42)*t0*t1+(80)*t1*t1,(307)*t0*t0+(248)*t0*t1+(345)*t1*t1,(114)*t0*t0+(195)*t0*t1+(40)*t1*t1,(296)*t0*t0+(216)*t0*t1+(130)*t1*t1,(259)*t0*t0+(18)*t0*t1+(270)*t1*t1,(89)*t0*t0+(105)*t0*t1+(271)*t1*t1);
<< "D12 PP dim 2 empty " << (saturate(IPP, ideal vars RPP) == ideal(1_RPP)) << endl;
<< "D12 PA dim 0 empty True" << endl;
RAP = kk[t0];
IAP = ideal((345)*t0*t0,(160)*t0*t0,(70)*t0*t0,(99)*t0*t0,(332)*t0*t0,(139)*t0*t0,(78)*t0*t0,(3)*t0*t0,(93)*t0*t0,(67)*t0*t0,(269)*t0*t0,(341)*t0*t0,(211)*t0*t0,(16)*t0*t0,(262)*t0*t0);
<< "D12 AP dim 1 empty " << (saturate(IAP, ideal vars RAP) == ideal(1_RAP)) << endl;
RAA = kk[t0];
IAA = ideal((270)*t0*t0,(248)*t0*t0,(285)*t0*t0,(277)*t0*t0,(91)*t0*t0,(339)*t0*t0,(15)*t0*t0,(340)*t0*t0,(303)*t0*t0,(298)*t0*t0,(11)*t0*t0,(52)*t0*t0,(27)*t0*t0,(166)*t0*t0,(159)*t0*t0);
<< "D12 AA dim 1 empty " << (saturate(IAA, ideal vars RAA) == ideal(1_RAA)) << endl;

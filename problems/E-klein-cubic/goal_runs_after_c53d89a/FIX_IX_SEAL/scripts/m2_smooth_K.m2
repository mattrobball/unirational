kk = toField(QQ[z]/(z^10+z^9+z^8+z^7+z^6+z^5+z^4+z^3+z^2+z+1));
S = kk[a0,a1,a2,a3,a4];
A = matrix{{0,((1/1))*a4,((-1/1))*a3,((1/1))*a2,((-1/1))*a1,((1/1))*a0},{((-1/1))*a4,0,((-2/1))*a1,0,0,((2/1))*a3},{((1/1))*a3,((2/1))*a1,0,0,((2/1))*a2,0},{((-1/1))*a2,0,0,0,((-2/1))*a0,((2/1))*a4},{((1/1))*a1,0,((-2/1))*a2,((2/1))*a0,0,0},{((-1/1))*a0,((-2/1))*a3,0,((-2/1))*a4,0,0}};
pf6 = pfaffians(6, A);
<< "PF6 nonzero " << (pf6 != 0) << endl;
lv = new MutableHashTable;
for u from 0 to 5 do for v from u+1 to 5 do lv#(u,v) = (gens pfaffians(4, submatrix'(A, {u,v}, {u,v})))_(0,0);
q0 = ((1/1))*lv#(0,5)+((-2/1))*lv#(3,4);
q1 = ((-1/1))*lv#(0,4)+((-2/1))*lv#(1,2);
q2 = ((1/1))*lv#(0,3)+((2/1))*lv#(2,4);
q3 = ((-1/1))*lv#(0,2)+((2/1))*lv#(1,5);
q4 = ((1/1))*lv#(0,1)+((2/1))*lv#(3,5);
J = pf6 + ideal(q0,q1,q2,q3,q4);
<< "JSYS empty " << (saturate(J, ideal vars S) == ideal(1_S)) << endl;

module

public import V14Formalization.WeilLambda2
public import V14Formalization.IntrinsicV14Action

/-!
# The intrinsic `V₁₄` over any field with a primitive 11th root of unity

`IntrinsicHeadline.intrinsicV14` is `Proj (Sym (M*) ⧸ I)` for `M ⊆ ⋀²U` the
`10′` summand of the even Weil representation — but over the fixed field
`ℚ(ζ₁₁) = AdjoinRoot Φ₁₁`, which is this project's carrier rather than a
condition a reader can check.  This file releases that.

The construction takes a field `F` together with a primitive 11th root of unity
and returns the same object.  The root is what is actually consumed: `U` itself
(even functions `𝔽₁₁ → F`) needs no root at all, and neither does `⋀²U`; the
root enters only through `ψ`, the Gauss sum, and hence the Weil operators.  So
`F` is required to be

* of characteristic zero, and
* equipped with a primitive 11th root of unity `ζ`,

which `BaseFieldCriteria` proves is exactly the same data as a ring map
`ℚ(ζ₁₁) → F`, in both directions.  The hypothesis is stated on the intrinsic
side; `AdjoinRoot Φ₁₁` does not occur.

`ofPrimitiveRoot` is the reader-facing entry point: it takes `hζ` and produces
the target directly.
-/

noncomputable section

open CategoryTheory
open scoped AlgebraicGeometry

namespace V14Formalization
namespace IntrinsicV14Field

open AlgebraicGeometry Module
open V14Formalization.WeilLambda2
open V14Formalization.WeilRep (HasCycl11)

variable (F : Type) [Field F] [CharZero F] [HasCycl11 F]

/-- The inclusion of the `10′` summand `M ⊆ ⋀²U`. -/
@[expose] public def inclM : ↥(Msub F) →ₗ[F] Lambda2U F := (Msub F).subtype

public theorem inclM_dualMap_surjective : Function.Surjective ((inclM F).dualMap) :=
  LinearMap.dualMap_surjective_of_injective
    (f := inclM F) (Submodule.injective_subtype (Msub F))

/-- The `PSL(2,11)`-representation on the `10′` summand. -/
@[expose] public def repM : Representation F PSL2F11 ↥(Msub F) where
  toFun g := LinearMap.restrict (ambientAct F g) fun v hv => ambientAct_mem F g hv
  map_one' := by
    refine LinearMap.ext fun x => ?_
    apply Subtype.ext
    show (pslLambda2Hom F 1) (x : Lambda2U F) = _
    rw [map_one]
    rfl
  map_mul' := by
    intro a b
    refine LinearMap.ext fun x => ?_
    apply Subtype.ext
    show (pslLambda2Hom F (a * b)) (x : Lambda2U F) =
      ((LinearMap.restrict (ambientAct F a) (fun v hv => ambientAct_mem F a hv))
        ((LinearMap.restrict (ambientAct F b) (fun v hv => ambientAct_mem F b hv)) x) :
        Lambda2U F)
    rw [map_mul]
    rfl

public theorem inclM_repM (g : PSL2F11) (x : ↥(Msub F)) :
    inclM F (repM F g x) = ambientAct F g (inclM F x) := rfl

/-- Every element of `PSL(2,11)` acts on `M` through the exterior square of an
endomorphism of `U`: lift it to `SL(2,11)`, where the Weil representation
lives.  The lift is not unique — the two lifts differ by `−I` — which is why
`Covers` is existential. -/
public theorem coversM (g : PSL2F11) :
    IntrinsicV14.Covers F (WeilRep.U F) (inclM F) (repM F g) := by
  obtain ⟨t, rfl⟩ :=
    QuotientGroup.mk_surjective (s := Subgroup.center SLG) g
  refine ⟨WeilHom.weilUHom t, fun x => ?_⟩
  rw [inclM_repM]
  show pslLambda2Hom F (QuotientGroup.mk t) (inclM F x) = _
  rw [pslLambda2_mk]
  rfl

/-- **The intrinsic `V₁₄` of the even Weil representation, over `Spec F`.**

`Proj (Sym (M*) ⧸ I)` with `I` generated by the `⋀⁴`-components of
`ω ↦ ω ∧ ω`, carrying its `PSL(2,11)`-action by functoriality of `Proj`.  No
basis of `U`, no basis of `M`, no matrix and no Plücker coordinate enters the
definition, and no field other than `F`. -/
@[expose] public def intrinsicV14 : Action (Over (Spec (.of F))) PSL2F11 :=
  IntrinsicV14.actionOver F (WeilRep.U F) (inclM F) (repM F) (coversM F)

end IntrinsicV14Field

namespace IntrinsicV14Field

open AlgebraicGeometry
open V14Formalization.WeilRep (HasCycl11)

/-- The intrinsic `V₁₄` attached to a characteristic-zero field and a chosen
primitive 11th root of unity in it.

This is the reader-facing form of the target: the hypothesis is a property of
`F` and an element of `F`, with no reference to `AdjoinRoot Φ₁₁` or to any
other carrier of this development.  `BaseFieldCriteria.algebraOfPrimitiveRoot`
and `BaseFieldCriteria.isPrimitiveRoot_zetaOf` say this hypothesis and
`[Algebra ℚ(ζ₁₁) F]` are the same data. -/
@[expose] public def ofPrimitiveRoot {F : Type} [Field F] [CharZero F] {ζ : F}
    (hζ : IsPrimitiveRoot ζ 11) : Action (Over (Spec (.of F))) WeilLambda2.PSL2F11 :=
  letI : HasCycl11 F := ⟨ζ, hζ⟩
  intrinsicV14 F

end IntrinsicV14Field
end V14Formalization

public theorem identity
    {S : Type*} [CommRing S] [Algebra ℚ S] (z : S)
    (hPhi : evalPolyAt z Phi11 = 0) (y : Fin 4 → S) :
    y 2 * linearOne (evalA z) (evalB z) y =
      ∑ q : Fin 8, evalPolyAt z (reverseCoeff_poly (2 : Fin 8) q) *
        evalQuadratic z q y := by
  have hcoeff : (fun m : Fin 10 => evalPolyAt z (targetCoeff_poly m)) =
      (fun m => ∑ q : Fin 8, evalPolyAt z (reverseCoeff_poly (2 : Fin 8) q) *
        evalPolyAt z (Qcoeff_poly q m)) := by
    funext m
    fin_cases m
    · exact eval_relation_0 z hPhi
    · exact eval_relation_1 z hPhi
    · exact eval_relation_2 z hPhi
    · exact eval_relation_3 z hPhi
    · exact eval_relation_4 z hPhi
    · exact eval_relation_5 z hPhi
    · exact eval_relation_6 z hPhi
    · exact eval_relation_7 z hPhi
    · exact eval_relation_8 z hPhi
    · exact eval_relation_9 z hPhi
  have htarget : (fun m : Fin 10 => evalPolyAt z (targetCoeff_poly m)) =
      bilinearCoeffs (fun i : Fin 4 => if i.val = 2 then 1 else 0)
        ![0, 1, evalA z, evalB z] := by
    funext m
    fin_cases m <;>
      simp [targetCoeff_poly, bilinearCoeffs, evalA, evalB, evalC, evalD,
        a_poly, b_poly, c_poly, d_poly, evalPolyAt, interpQ, toPolyZ]
  have hlhs : y 2 * linearOne (evalA z) (evalB z) y =
      quadValue (fun m : Fin 10 => evalPolyAt z (targetCoeff_poly m)) y := by
    rw [htarget, quadValue_bilinearCoeffs]
    simp [dotProduct, Fin.sum_univ_succ, linearOne, linearTwo] <;>
      ring
  rw [hlhs, hcoeff]
  simp only [evalQuadratic, quadValue, dotProduct, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro q _
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro m _
  ring


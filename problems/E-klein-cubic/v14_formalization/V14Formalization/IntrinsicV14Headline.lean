public import V14Formalization.IntrinsicV14Compare
public import V14Formalization.IntrinsicV14Field
public import V14Formalization.FaithfulHeadline

/-!
# No equivariant rational map to the *intrinsic* `V₁₄`

The statement below names only

* `ℙ(V) = Proj (Sym (V*))` for a faithful representation `V` of `PSL(2,11)`;
* the intrinsic `V₁₄ = Proj (Sym (M*) ⧸ I)`, where `I` is generated by the
  `⋀⁴`-components of `ω ↦ ω ∧ ω` for `M ⊆ ⋀²U` the `10′` summand;
* the notion of an equivariant rational map over `Spec k`.

No `projectorMatrix`, no `grassmannianLinearSection`, no `lambda2Basis` and no
Plücker coordinate occurs in it.  They occur in the *proof*: the comparison
morphism of `IntrinsicV14Compare` is equivariant, so a hypothetical equivariant
rational map to the intrinsic `V₁₄` composes with it to give one to the
coordinate `V₁₄`, contradicting
`SchemeGeometry.noEquivariantRationalMap_projectiveSpaceOfRep`.  The certificate corpus
is therefore still load-bearing, and none of it is restated.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 8000

noncomputable section

open CategoryTheory
open scoped AlgebraicGeometry

namespace V14Formalization
namespace IntrinsicHeadline

open AlgebraicGeometry Module GeometricV14Carrier

/-! ## The data, instantiated from `IntrinsicV14Field` at `F = k`

Everything from `inclM` through `intrinsicV14` is the general construction of
`IntrinsicV14Field` applied at the concrete cyclotomic field `k`; the proofs
live only there. -/

/-- The inclusion of the `10′` summand `M ⊆ ⋀²U`. -/
@[expose] public def inclM : ↥Msub →ₗ[k] Lambda2U := IntrinsicV14Field.inclM k

public theorem inclM_dualMap_surjective : Function.Surjective (inclM.dualMap) :=
  IntrinsicV14Field.inclM_dualMap_surjective k

/-! ## The action -/

/-- The `PSL(2,11)`-representation on the `10′` summand. -/
@[expose] public def repM : Representation k PSL2F11 ↥Msub :=
  IntrinsicV14Field.repM k

public theorem inclM_repM (g : PSL2F11) (x : ↥Msub) :
    inclM (repM g x) = ambientAct g (inclM x) :=
  IntrinsicV14Field.inclM_repM k g x

/-- Every element of `PSL(2,11)` acts on `M` through the exterior square of an
endomorphism of `U`: lift it to `SL(2,11)`, where the Weil representation
lives. -/
public theorem coversM (g : PSL2F11) : IntrinsicV14.Covers k U inclM (repM g) :=
  IntrinsicV14Field.coversM k g

/-- **The intrinsic `V₁₄` of the Weil representation, with its
`PSL(2,11)`-action, over `Spec k`.**  `Proj (Sym (M*) ⧸ I)` with `I` generated
by the `⋀⁴`-components of `ω ↦ ω ∧ ω`; no basis and no Plücker coordinate
enters its definition. -/
@[expose] public def intrinsicV14 : Action (Over (Spec (.of k))) PSL2F11 :=
  IntrinsicV14Field.intrinsicV14 k

/-! ## The comparison, at the actual data -/

public theorem lex2_uBasisCore :
    Lambda4Coordinates.lex2 Lambda2Coordinates.uBasisCore = Lambda2Coordinates.lambda2Basis :=
  rfl

public theorem projectorMatrix_mulVec_inclM (x : ↥Msub) :
    V14SchemeModel.projectorMatrix.mulVec
        ((Lambda4Coordinates.lex2 Lambda2Coordinates.uBasisCore).equivFun (inclM x)) =
      (Lambda4Coordinates.lex2 Lambda2Coordinates.uBasisCore).equivFun (inclM x) := by
  rw [lex2_uBasisCore]
  refine (SchemeGeometry.projectorLinearCuts_vanish_iff k
    V14SchemeModel.projectorMatrix _).1 fun i => ?_
  have h := (V14SchemeModel.projectorLinearCuts_vanish_iff_mem_Msub (inclM x)).2 x.2 i
  simpa [Basis.equivFun_apply] using h

public theorem two_ne_zero_k : (2 : k) ≠ 0 := by
  have h : (2 : k) = ((2 : ℕ) : k) := by norm_num
  rw [h]
  exact Nat.cast_ne_zero.mpr (by norm_num)

/-- The comparison morphism from the intrinsic `V₁₄` to the coordinate one. -/
@[expose] public def compareMor :
    IntrinsicV14.scheme k U inclM ⟶ V14SchemeModel.v14Scheme :=
  IntrinsicV14Compare.compare inclM Lambda2Coordinates.uBasisCore
    V14SchemeModel.projectorMatrix inclM_dualMap_surjective two_ne_zero_k
    projectorMatrix_mulVec_inclM

public theorem compareMor_ι :
    compareMor ≫ V14SchemeModel.v14Schemeι =
      IntrinsicV14Compare.toAmbient14 inclM Lambda2Coordinates.uBasisCore inclM_dualMap_surjective :=
  IntrinsicV14Compare.compare_ι _ _ _ _ _ _

public instance compareMor_isOver : compareMor.IsOver (Spec (.of k)) where
  comp_over := by
    change compareMor ≫
      (V14SchemeModel.v14Schemeι ≫ BConicBundleMultisections.ProjectiveSpace.toSpec 14 k) = _
    rw [← Category.assoc, compareMor_ι,
      IntrinsicV14Compare.toAmbient14_toSpec inclM Lambda2Coordinates.uBasisCore inclM_dualMap_surjective]
    rfl

/-! ## The comparison is equivariant -/

public theorem toMatrix_lambda2_mulVec (g : PSL2F11) (x : ↥Msub) (j : Fin 15) :
    (Lambda4Coordinates.lex2 Lambda2Coordinates.uBasisCore).equivFun (inclM (repM g x)) j =
      ∑ l : Fin 15,
        (Lambda2Coordinates.lambda2MatrixRepresentation.ρ g :
          Matrix (Fin 15) (Fin 15) k) j l *
          (Lambda4Coordinates.lex2 Lambda2Coordinates.uBasisCore).equivFun (inclM x) l := by
  rw [lex2_uBasisCore, inclM_repM]
  have h := LinearMap.toMatrix_mulVec_repr Lambda2Coordinates.lambda2Basis
    Lambda2Coordinates.lambda2Basis (GeometricFanoCarrier.pslLambda2Hom g) (inclM x)
  have hj := congrFun h j
  rw [Lambda2Coordinates.lambda2MatrixRepresentation_coe]
  simpa [Matrix.mulVec, dotProduct, Basis.equivFun_apply, ambientAct] using hj.symm

public theorem compareMor_equivariant (g : PSL2F11) :
    (intrinsicV14.ρ g).left ≫ compareMor =
      compareMor ≫ (V14SchemeModel.actionOver.ρ g).left := by
  refine (cancel_mono V14SchemeModel.v14Schemeι).1 ?_
  have hleft : (intrinsicV14.ρ g).left =
      IntrinsicV14.schemeMap k U inclM (repM g) (repM g⁻¹) (coversM g)
        (IntrinsicV14.repInvComp repM g) := rfl
  have step := IntrinsicV14Compare.schemeMap_comp_toAmbient14 inclM
    Lambda2Coordinates.uBasisCore inclM_dualMap_surjective (repM g) (coversM g)
    (Lambda2Coordinates.lambda2MatrixRepresentation.ρ g) (repM g⁻¹)
    ((Lambda2Coordinates.lambda2MatrixRepresentation.ρ g)⁻¹ : Matrix (Fin 15) (Fin 15) k)
    (IntrinsicV14.repInvComp repM g) (by simp) (toMatrix_lambda2_mulVec g)
  calc ((intrinsicV14.ρ g).left ≫ compareMor) ≫ V14SchemeModel.v14Schemeι
      = (intrinsicV14.ρ g).left ≫ (compareMor ≫ V14SchemeModel.v14Schemeι) :=
        Category.assoc _ _ _
    _ = (intrinsicV14.ρ g).left ≫ IntrinsicV14Compare.toAmbient14 inclM
          Lambda2Coordinates.uBasisCore inclM_dualMap_surjective :=
        congrArg (fun m => (intrinsicV14.ρ g).left ≫ m) compareMor_ι
    _ = IntrinsicV14.schemeMap k U inclM (repM g) (repM g⁻¹) (coversM g)
            (IntrinsicV14.repInvComp repM g) ≫
          IntrinsicV14Compare.toAmbient14 inclM Lambda2Coordinates.uBasisCore inclM_dualMap_surjective :=
        congrArg (fun m => m ≫ IntrinsicV14Compare.toAmbient14 inclM
          Lambda2Coordinates.uBasisCore inclM_dualMap_surjective) hleft
    _ = IntrinsicV14Compare.toAmbient14 inclM Lambda2Coordinates.uBasisCore inclM_dualMap_surjective ≫ SchemeGeometry.projectiveActionHom
              Lambda2Coordinates.lambda2MatrixRepresentation.ρ g := step
    _ = (compareMor ≫ V14SchemeModel.v14Schemeι) ≫ SchemeGeometry.projectiveActionHom
              Lambda2Coordinates.lambda2MatrixRepresentation.ρ g :=
        congrArg (fun m => m ≫ SchemeGeometry.projectiveActionHom
          Lambda2Coordinates.lambda2MatrixRepresentation.ρ g) compareMor_ι.symm
    _ = compareMor ≫ (V14SchemeModel.v14Schemeι ≫ SchemeGeometry.projectiveActionHom
              Lambda2Coordinates.lambda2MatrixRepresentation.ρ g) := Category.assoc _ _ _
    _ = compareMor ≫ ((V14SchemeModel.actionOver.ρ g).left ≫ V14SchemeModel.v14Schemeι) :=
        congrArg (fun m => compareMor ≫ m)
          (V14SchemeModel.actionOver_hom_v14Schemeι g).symm
    _ = (compareMor ≫ (V14SchemeModel.actionOver.ρ g).left) ≫ V14SchemeModel.v14Schemeι :=
        (Category.assoc _ _ _).symm

/-! ## The theorem -/

/-- **There is no `PSL(2,11)`-equivariant rational map from `ℙ(V)` to the
intrinsic `V₁₄`.**

`V` is any faithful linear representation, `ℙ(V) = Proj (Sym (V*))` carries its
action by functoriality, and the target is `Proj (Sym (M*) ⧸ I)` for the
Plücker ideal `I` of the wedge pairing on the `10′` summand `M ⊆ ⋀²U`.  Nothing
in the statement mentions a basis, a matrix, or a coordinate. -/
public theorem noEquivariantRationalMap_intrinsicV14
    {V : Type} [AddCommGroup V] [Module k V] [FiniteDimensional k V] [Nontrivial V]
    (R : FaithfulLinearRep k PSL2F11 V) :
    ¬ SchemeGeometry.HasEquivariantRationalMap (SchemeGeometry.projectiveSpaceOfRep R) intrinsicV14 := by
  intro h
  exact SchemeGeometry.noEquivariantRationalMap_projectiveSpaceOfRep R
    (SchemeGeometry.hasEquivariantRationalMap_of_hom compareMor compareMor_isOver
      compareMor_equivariant h)

end IntrinsicHeadline
end V14Formalization

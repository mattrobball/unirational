module

public import V14Formalization.MultiProjectiveZeroLocus
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor

/-!
# When does `Proj.map` land in a projective zero locus?

`AlgebraicGeometry.Proj.map F hF : Proj ℬ ⟶ ℙⁿ` is the morphism attached to a
graded ring map `F` out of the homogeneous coordinate ring of `ℙⁿ`.  This file
proves the one thing needed to factor it through a closed subscheme:

    F H = 0  →  projectiveZeroLocusIdeal n R H ≤ (Proj.map F hF).ker

for `H` homogeneous.  With `Scheme.IdealSheafData.ker_subschemeι` and
`IsClosedImmersion.lift` this is exactly the statement that the morphism
factors through the hypersurface `H = 0`, and taking a supremum over a finite
family gives the factorization through any projective zero locus family.

The proof never computes an ideal sheaf.  `J ≤ f.ker` is `J.comap f = ⊥` by the
`map`/`comap` Galois connection, and `= ⊥` is checked on the affine cover of
`Proj ℬ` by `D₊(F Xᵢ)`, where `Proj.awayι_comp_map` turns the composite into
`Spec` of `HomogeneousLocalization.Away.map F Xᵢ`.  On that chart the
hypersurface ideal is generated by the single section `H / Xᵢ^d`, which
`Away.map F Xᵢ` sends to `F H / (F Xᵢ)^d = 0`.
-/

noncomputable section

open CategoryTheory
open scoped AlgebraicGeometry HomogeneousIdeal

universe u v

namespace V14Formalization
namespace SchemeGeometry

open AlgebraicGeometry BConicBundleMultisections HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

/-! ## Two small pieces of `IdealSheafData` hygiene -/

/-- `ofIdealTop` is monotone. -/
public theorem ofIdealTop_mono {X : Scheme.{u}} {I J : Ideal Γ(X, ⊤)} (h : I ≤ J) :
    Scheme.IdealSheafData.ofIdealTop I ≤ Scheme.IdealSheafData.ofIdealTop J := by
  refine Scheme.IdealSheafData.le_def.mpr fun U => ?_
  rw [Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal]
  exact Ideal.map_mono h

/-- An ideal sheaf that restricts to zero on every member of an affine open
cover is zero. -/
public theorem idealSheaf_eq_bot_of_comap {X : Scheme.{u}} (J : X.IdealSheafData)
    {ι : Type*} (W : ι → Scheme.{u}) (f : ∀ i, W i ⟶ X)
    [∀ i, IsOpenImmersion (f i)] [∀ i, IsAffine (W i)]
    (hcov : ⨆ i, (f i).opensRange = ⊤)
    (h : ∀ i, J.comap (f i) = ⊥) : J = ⊥ := by
  have himage : ∀ i : ι, (f i) ''ᵁ (⊤ : (W i).Opens) = (f i).opensRange := fun i =>
    TopologicalSpace.Opens.ext (by simp)
  refine le_antisymm ?_ bot_le
  refine Scheme.IdealSheafData.le_of_iSup_eq_top
    (fun i => ⟨(f i) ''ᵁ (⊤ : (W i).Opens),
      (isAffineOpen_top (W i)).image_of_isOpenImmersion (f i)⟩) ?_ fun i => ?_
  · simpa only [himage] using hcov
  · set T : (W i).affineOpens := ⟨(⊤ : (W i).Opens), isAffineOpen_top (W i)⟩ with hT
    have hcomap := congrArg (fun K : (W i).IdealSheafData => K.ideal T) (h i)
    rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion J (f i) T] at hcomap
    have hsurj : Function.Surjective ((f i).appIso T.1).inv.hom :=
      (ConcreteCategory.bijective_of_isIso ((f i).appIso T.1).inv).2
    have himg := congrArg (Ideal.map ((f i).appIso T.1).inv.hom) hcomap
    rw [Ideal.map_comap_of_surjective _ hsurj] at himg
    refine le_of_eq (himg.trans ?_)
    simp

/-! ## The setting -/

variable {n : ℕ} {R : Type u} [CommRing R]
variable {B σ : Type u} [CommRing B] [SetLike σ B] [AddSubgroupClass σ B]
  {ℬ : ℕ → σ} [GradedRing ℬ]
variable (F : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R →+*ᵍ ℬ)
  (hF : ℬ₊ ≤ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)₊.map F)

omit [AddSubgroupClass σ B] [GradedRing ℬ] in
/-- The images of the coordinates are homogeneous of degree one. -/
public theorem mem_one_map_X (i : Fin (n + 1)) :
    F (MvPolynomial.X i) ∈ ℬ 1 :=
  GradedFunLike.map_mem F (by simpa using MvPolynomial.isHomogeneous_X R i)

include hF in
/-- The irrelevant ideal of `ℬ` is spanned by the images of the coordinates, so
the `D₊(F Xᵢ)` cover `Proj ℬ`. -/
public theorem irrelevant_le_span_map_X :
    (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤
      Ideal.span (Set.range (fun i : Fin (n + 1) => F (MvPolynomial.X i))) := by
  have h1 : (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤
      Ideal.map F (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)).toIdeal := hF
  refine h1.trans ?_
  refine (Ideal.map_mono (ProjectiveSpace.irrelevant_le_span_X n R)).trans ?_
  rw [Ideal.map_span]
  refine Ideal.span_mono ?_
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  exact ⟨i, rfl⟩

include hF in
public theorem iSup_opensRange_awayι_map_X :
    ⨆ i : Fin (n + 1),
        (Proj.awayι ℬ (F (MvPolynomial.X i)) (mem_one_map_X F i) Nat.one_pos).opensRange
      = ⊤ := by
  have h : ∀ i : Fin (n + 1),
      (Proj.awayι ℬ (F (MvPolynomial.X i)) (mem_one_map_X F i) Nat.one_pos).opensRange
        = Proj.basicOpen ℬ (F (MvPolynomial.X i)) :=
    fun i => Proj.opensRange_awayι ℬ _ (mem_one_map_X F i) Nat.one_pos
  simp only [h]
  exact Proj.iSup_basicOpen_eq_top ℬ (fun i : Fin (n + 1) => F (MvPolynomial.X i))
    (irrelevant_le_span_map_X F hF)

/-! ## The chart computation -/

/-- Two fractions with the same denominator and equal numerators agree. -/
public theorem away_mk_congr {t : B} {d : ℕ} (ht : t ∈ ℬ d) (m : ℕ) {x y : B}
    (hx : x ∈ ℬ (m • d)) (hy : y ∈ ℬ (m • d)) (h : x = y) :
    HomogeneousLocalization.Away.mk ℬ ht m x hx =
      HomogeneousLocalization.Away.mk ℬ ht m y hy := by
  subst h; rfl

/-- A fraction with zero numerator is zero. -/
public theorem away_mk_zero {t : B} {d : ℕ} (ht : t ∈ ℬ d) (m : ℕ)
    (h0 : (0 : B) ∈ ℬ (m • d)) :
    HomogeneousLocalization.Away.mk ℬ ht m 0 h0 = 0 := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
    Localization.mk_zero]

/-- The chart equation of a homogeneous polynomial is the fraction `H / Xᵢ^d`. -/
public theorem hypersurfaceChartEquation_eq_mk (i : Fin (n + 1))
    {H : MvPolynomial (Fin (n + 1)) R} {d : ℕ} (hH : H.IsHomogeneous d) :
    ProjectiveSpace.hypersurfaceChartEquation n R i H =
      HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
        (MvPolynomial.isHomogeneous_X R i) d H (by simpa using hH) := by
  have hcomp := ProjectiveSpace.mvPolynomialToStandardChart_comp_chartDehomogenization n R i
  have h := ProjectiveSpace.mvPolynomialToStandardChart_chartDehomogenization_of_isHomogeneous
    n R i hH
  show MvPolynomial.aeval (fun l ↦ ProjectiveSpace.normalizedCoordinate n R i l) H = _
  rw [← hcomp, AlgHom.comp_apply, h]

/-- **The chart computation.**  If `F` kills a homogeneous `H`, then the
`i`-th chart equation of `H` dies in the chart ring of `Proj ℬ`. -/
public theorem awayMap_hypersurfaceChartEquation (i : Fin (n + 1))
    {H : MvPolynomial (Fin (n + 1)) R} {d : ℕ} (hH : H.IsHomogeneous d) (hF0 : F H = 0) :
    HomogeneousLocalization.Away.map F (MvPolynomial.X i)
        (ProjectiveSpace.hypersurfaceChartEquation n R i H) = 0 := by
  rw [hypersurfaceChartEquation_eq_mk i hH, HomogeneousLocalization.Away.map_mk]
  refine Eq.trans (away_mk_congr _ _ _ ?_ hF0) (away_mk_zero _ _ _)
  simpa using Submodule.zero_mem _

/-! ## The factorization -/

include hF in
/-- **A `Proj.map` that kills a homogeneous polynomial lands in its zero
locus.**  Stated as the containment of ideal sheaves that
`IsClosedImmersion.lift` consumes. -/
public theorem projectiveZeroLocusIdeal_le_ker
    {H : MvPolynomial (Fin (n + 1)) R} {d : ℕ} (hH : H.IsHomogeneous d) (hF0 : F H = 0) :
    ProjectiveSpace.projectiveZeroLocusIdeal n R H ≤ (Proj.map F hF).ker := by
  rw [← Scheme.IdealSheafData.map_bot (Proj.map F hF),
    Scheme.IdealSheafData.le_map_iff_comap_le, le_bot_iff]
  refine idealSheaf_eq_bot_of_comap _
    (fun j : Fin (n + 1) =>
      Spec (CommRingCat.of (HomogeneousLocalization.Away ℬ (F (MvPolynomial.X j)))))
    (fun j => Proj.awayι ℬ (F (MvPolynomial.X j)) (mem_one_map_X F j) Nat.one_pos)
    (iSup_opensRange_awayι_map_X F hF) fun j => ?_
  rw [← Scheme.IdealSheafData.comap_comp]
  rw [Proj.awayι_comp_map F hF Nat.one_pos (MvPolynomial.X j)
    (by simpa using MvPolynomial.isHomogeneous_X R j)]
  rw [Scheme.IdealSheafData.comap_comp]
  rw [show Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
        (MvPolynomial.X j) (by simpa using MvPolynomial.isHomogeneous_X R j) Nat.one_pos
      = ProjectiveSpace.standardChartι n R j from rfl]
  rw [ProjectiveSpace.projectiveZeroLocusIdeal_comap_standardChartι n R H hH j]
  rw [← le_bot_iff, ← Scheme.IdealSheafData.le_map_iff_comap_le,
    Scheme.IdealSheafData.map_bot, Scheme.ker_of_isAffine]
  refine ofIdealTop_mono ?_
  show Ideal.span {ProjectiveSpace.hypersurfaceChartEquationSection n R j H} ≤ _
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
  apply (Scheme.ΓSpecIso
    (CommRingCat.of (HomogeneousLocalization.Away ℬ (F (MvPolynomial.X j))))).commRingCatIsoToRingEquiv.injective
  rw [map_zero]
  have hnat := Scheme.ΓSpecIso_naturality
    (CommRingCat.ofHom (HomogeneousLocalization.Away.map F (MvPolynomial.X j)))
  have happ := congrArg (fun m : CommRingCat.of _ ⟶ CommRingCat.of _ =>
      m.hom (ProjectiveSpace.hypersurfaceChartEquationSection n R j H)) hnat
  refine happ.trans ?_
  show (HomogeneousLocalization.Away.map F (MvPolynomial.X j))
      ((ProjectiveSpace.hypersurfaceChartΓIso n R j).hom
        (ProjectiveSpace.hypersurfaceChartEquationSection n R j H)) = 0
  rw [ProjectiveSpace.hypersurfaceChartΓIso_hom_equationSection]
  exact awayMap_hypersurfaceChartEquation F j hH hF0

include hF in
/-- The family version: a `Proj.map` killing every member of a homogeneous
family lands in their common zero locus. -/
public theorem projectiveZeroLocusFamilyIdeal_le_ker {ι : Type v}
    (E : ι → MvPolynomial (Fin (n + 1)) R) (deg : ι → ℕ)
    (hdeg : ∀ s, (E s).IsHomogeneous (deg s)) (h0 : ∀ s, F (E s) = 0) :
    projectiveZeroLocusFamilyIdeal n R E ≤ (Proj.map F hF).ker :=
  iSup_le fun s => projectiveZeroLocusIdeal_le_ker F hF (hdeg s) (h0 s)

/-- **The factorization.**  `Proj.map F hF` through the closed subscheme cut out
by a homogeneous family that `F` kills. -/
@[expose] public noncomputable def liftToZeroLocusFamily {ι : Type v}
    (E : ι → MvPolynomial (Fin (n + 1)) R) (deg : ι → ℕ)
    (hdeg : ∀ s, (E s).IsHomogeneous (deg s)) (h0 : ∀ s, F (E s) = 0) :
    Proj ℬ ⟶ projectiveZeroLocusFamily n R E :=
  IsClosedImmersion.lift (projectiveZeroLocusFamilyι n R E) (Proj.map F hF)
    (by
      rw [ker_projectiveZeroLocusFamilyι]
      exact projectiveZeroLocusFamilyIdeal_le_ker F hF E deg hdeg h0)

@[reassoc (attr := simp)]
public theorem liftToZeroLocusFamily_ι {ι : Type v}
    (E : ι → MvPolynomial (Fin (n + 1)) R) (deg : ι → ℕ)
    (hdeg : ∀ s, (E s).IsHomogeneous (deg s)) (h0 : ∀ s, F (E s) = 0) :
    liftToZeroLocusFamily F hF E deg hdeg h0 ≫ projectiveZeroLocusFamilyι n R E
      = Proj.map F hF :=
  IsClosedImmersion.lift_fac _ _ _

end SchemeGeometry
end V14Formalization

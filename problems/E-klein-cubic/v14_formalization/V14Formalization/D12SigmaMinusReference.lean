theorem pullback_B_relation :
    pullback_B_raw - BB_poly =
      Phi11 * pullback_B_quotient := by
  rw [pullback_B_quotient, Finset.mul_sum]
  have hsum :
      (∑ i : Fin 17, Phi11 * pullback_B_quotientTerm i) =
      ∑ i : Fin 17, match i.val with
        | 0 => pullback_B_product_0
        | 1 => pullback_B_product_1
        | 2 => pullback_B_product_2
        | 3 => pullback_B_product_3
        | 4 => pullback_B_product_4
        | 5 => pullback_B_product_5
        | 6 => pullback_B_product_6
        | 7 => pullback_B_product_7
        | 8 => pullback_B_product_8
        | 9 => pullback_B_product_9
        | 10 => pullback_B_product_10
        | 11 => pullback_B_product_11
        | 12 => pullback_B_product_12
        | 13 => pullback_B_product_13
        | 14 => pullback_B_product_14
        | 15 => pullback_B_product_15
        | 16 => pullback_B_product_16
        | _ => 0 := by
    apply Finset.sum_congr rfl
    intro i _
    fin_cases i
    · exact pullback_B_product_eq_0
    · exact pullback_B_product_eq_1
    · exact pullback_B_product_eq_2
    · exact pullback_B_product_eq_3
    · exact pullback_B_product_eq_4
    · exact pullback_B_product_eq_5
    · exact pullback_B_product_eq_6
    · exact pullback_B_product_eq_7
    · exact pullback_B_product_eq_8
    · exact pullback_B_product_eq_9
    · exact pullback_B_product_eq_10
    · exact pullback_B_product_eq_11
    · exact pullback_B_product_eq_12
    · exact pullback_B_product_eq_13
    · exact pullback_B_product_eq_14
    · exact pullback_B_product_eq_15
    · exact pullback_B_product_eq_16
  rw [hsum]
  simp only [Fin.sum_univ_succ]
  simp [pullback_B_raw, BB_poly,
    pullback_B_product_0, pullback_B_product_1, pullback_B_product_2, pullback_B_product_3, pullback_B_product_4,
    pullback_B_product_5, pullback_B_product_6, pullback_B_product_7, pullback_B_product_8, pullback_B_product_9,
    pullback_B_product_10, pullback_B_product_11, pullback_B_product_12, pullback_B_product_13, pullback_B_product_14,
    pullback_B_product_15, pullback_B_product_16]
  all_goals simp (disch := decide) only [interp_one, interp_ofNat,
    interp_pow_two, interp_neg, interp_mul, interp_add_gen,
    interp_sub_gen, Nat.reduceMul]
  all_goals apply interp_eq
  all_goals decide


theorem eval_pullback_B
    {S : Type*} [CommRing S] [Algebra ℚ S] (z : S)
    (hPhi : evalPolyAt z Phi11 = 0) :
    evalPolyAt z pullback_B_raw =
      evalPolyAt z BB_poly := by
  have h := congrArg (evalPolyAt z) pullback_B_relation
  simp only [map_sub, map_mul, hPhi, zero_mul, sub_eq_zero] at h
  exact h


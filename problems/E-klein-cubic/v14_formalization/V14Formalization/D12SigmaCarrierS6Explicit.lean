      S6_explicit_row5 (5 : Fin 6) := by
  have hj : (5 : Fin 6).val ≠ 0 := by decide
  have ha : (((((5 : Fin 6).val : ZMod 11) *
      ((5 : Fin 6).val : ZMod 11))).val = 3) := by decide
  have hb : ((-((((5 : Fin 6).val : ZMod 11) *
      ((5 : Fin 6).val : ZMod 11)))).val = 8) := by decide
  simp only [S6_poly, Matrix.of_apply, if_neg hj,
    D12U6Semantic.phasePoly]
  rw [ha, hb]
  rfl

theorem row_5 (j : Fin 6) :
    S6_poly (5 : Fin 6) j = S6_explicit_row5 j := by
  fin_cases j
  · exact entry_5_0
  · exact entry_5_1
  · exact entry_5_2
  · exact entry_5_3
  · exact entry_5_4
  · exact entry_5_5

def S6_explicit_poly : Matrix (Fin 6) (Fin 6) (Polynomial ℚ) :=
  Matrix.of fun i =>
    match i.val with
    | 0 => S6_explicit_row0
    | 1 => S6_explicit_row1
    | 2 => S6_explicit_row2
    | 3 => S6_explicit_row3
    | 4 => S6_explicit_row4
    | 5 => S6_explicit_row5
    | _ => S6_explicit_row0

theorem S6_poly_eq_explicit :
    S6_poly = S6_explicit_poly := by
  apply Matrix.ext
  intro i j
  fin_cases i
  · exact row_0 j
  · exact row_1 j
  · exact row_2 j
  · exact row_3 j
  · exact row_4 j
  · exact row_5 j

end V14Formalization.D12SigmaCarrierS6Explicit

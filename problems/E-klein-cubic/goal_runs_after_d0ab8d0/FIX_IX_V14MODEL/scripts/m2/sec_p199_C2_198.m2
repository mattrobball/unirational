kk = ZZ/199;
R = kk[x0,x1,x2,x3];
I = saturate ideal(12*x0*x0+109*x0*x1+74*x0*x2+108*x0*x3+176*x1*x1+15*x1*x2+101*x1*x3+99*x2*x3, 173*x0*x1+99*x0*x2+161*x1*x1+164*x1*x2+175*x1*x3+99*x3*x3, 35*x0*x0+109*x0*x1+111*x0*x2+196*x0*x3+99*x1*x1+100*x1*x3+100*x2*x3+100*x3*x3, 99*x0*x0+99*x0*x1+73*x0*x2+88*x0*x3+161*x1*x2+23*x1*x3+164*x2*x2+160*x2*x3+98*x3*x3, 110*x0*x0+187*x0*x1+26*x0*x2+112*x0*x3+176*x1*x1+91*x1*x2+78*x1*x3+15*x2*x2+116*x2*x3+101*x3*x3, 159*x0*x0+131*x0*x1+125*x0*x2+12*x0*x3+161*x1*x1+126*x1*x2+37*x1*x3+164*x2*x2+140*x2*x3+175*x3*x3, 99*x0*x1+12*x0*x3+99*x1*x1+99*x1*x2+197*x1*x3+100*x2*x2+74*x2*x3+108*x3*x3, 187*x0*x0+188*x0*x1+78*x0*x2+79*x0*x3+101*x1*x1+117*x1*x2+192*x1*x3+14*x2*x2+120*x2*x3+91*x3*x3, 185*x0*x1+100*x0*x2+164*x0*x3+195*x1*x1+87*x1*x2+152*x1*x3+100*x2*x2+188*x2*x3+103*x3*x3, 100*x0*x0+1*x0*x1+186*x0*x2+101*x0*x3+100*x1*x1+196*x1*x2+1*x1*x3+87*x2*x2+63*x2*x3+100*x3*x3, 113*x0*x0+19*x0*x1+50*x0*x2+161*x0*x3+142*x1*x1+184*x1*x2+138*x1*x3+95*x2*x2+83*x2*x3+55*x3*x3, 186*x0*x0+2*x0*x1+154*x0*x2+64*x0*x3+129*x1*x1+114*x1*x2+99*x1*x3+73*x2*x2+114*x2*x3+144*x3*x3, 85*x0*x0+15*x0*x1+68*x0*x2+54*x0*x3+37*x1*x1+76*x1*x2+106*x1*x3+95*x2*x2+52*x2*x3+53*x3*x3, 167*x0*x0+89*x0*x1+72*x0*x2+147*x0*x3+57*x1*x1+109*x1*x2+188*x1*x3+195*x2*x2+184*x2*x3+106*x3*x3, 113*x0*x0+100*x0*x1+78*x0*x2+62*x0*x3+51*x1*x1+111*x1*x2+69*x1*x3+77*x2*x2+195*x2*x3+81*x3*x3);
if I == ideal(1_R) then print("C2[198]|EMPTY") else (
  cs = minimalPrimes I;
  s := "C2[198]|dim " | toString(dim I - 1) | "|deg " | toString degree I | "|ncomp " | toString(#cs);
  for c in cs do s = s | "|(d" | toString(dim c - 1) | " e" | toString degree c | (if dim c == 2 then " g" | toString genus c else "") | ")";
  print s;)

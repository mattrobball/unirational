kk = ZZ/199;
R = kk[x0,x1,x2,x3];
I = saturate ideal(38*x0*x0+61*x0*x1+121*x0*x2+198*x0*x3+116*x1*x1+39*x1*x2+169*x1*x3+99*x2*x3, 103*x0*x1+99*x0*x2+168*x1*x1+60*x1*x2+134*x1*x3+99*x3*x3, 6*x0*x0+8*x0*x1+20*x0*x2+77*x0*x3+99*x1*x1+99*x1*x3+79*x2*x3+173*x3*x3, 63*x0*x0+100*x0*x1+24*x0*x2+8*x0*x3+168*x1*x2+83*x1*x3+60*x2*x2+95*x2*x3+30*x3*x3, 20*x0*x0+92*x0*x1+119*x0*x2+58*x0*x3+83*x1*x1+80*x1*x2+167*x1*x3+192*x2*x2+197*x2*x3+167*x3*x3, 128*x0*x0+63*x0*x1+98*x0*x2+36*x0*x3+31*x1*x1+17*x1*x2+184*x1*x3+127*x2*x2+142*x2*x3+196*x3*x3, 63*x0*x1+38*x0*x3+100*x1*x1+120*x1*x2+69*x1*x3+100*x2*x2+121*x2*x3+198*x3*x3, 12*x0*x0+182*x0*x1+82*x0*x2+59*x0*x3+43*x1*x1+85*x1*x2+46*x1*x3+165*x2*x2+141*x2*x3+147*x3*x3, 171*x0*x1+136*x0*x2+193*x0*x3+41*x1*x1+40*x1*x2+179*x1*x3+79*x2*x2+153*x2*x3+59*x3*x3, 177*x0*x0+126*x0*x1+163*x0*x2+85*x0*x3+100*x1*x1+82*x1*x2+52*x1*x3+85*x2*x2+130*x2*x3+158*x3*x3, 66*x0*x0+132*x0*x1+173*x0*x2+54*x0*x3+139*x1*x1+118*x1*x2+127*x1*x3+183*x2*x2+119*x2*x3+121*x3*x3, 108*x0*x0+63*x0*x1+196*x0*x2+2*x0*x3+54*x1*x1+6*x1*x2+179*x1*x3+183*x2*x2+84*x2*x3+178*x3*x3, 21*x0*x0+41*x0*x1+32*x0*x2+114*x0*x3+150*x1*x1+9*x1*x2+194*x1*x3+6*x2*x2+65*x2*x3+60*x3*x3, 154*x0*x0+169*x0*x1+134*x0*x2+105*x0*x3+70*x1*x1+131*x1*x2+48*x1*x3+112*x2*x2+91*x2*x3+38*x3*x3, 110*x0*x0+65*x0*x1+81*x0*x2+190*x0*x3+175*x1*x1+11*x1*x2+119*x1*x3+37*x2*x2+7*x2*x3+70*x3*x3);
if I == ideal(1_R) then print("C3[1]|EMPTY") else (
  cs = minimalPrimes I;
  s := "C3[1]|dim " | toString(dim I - 1) | "|deg " | toString degree I | "|ncomp " | toString(#cs);
  for c in cs do s = s | "|(d" | toString(dim c - 1) | " e" | toString degree c | (if dim c == 2 then " g" | toString genus c else "") | ")";
  print s;)

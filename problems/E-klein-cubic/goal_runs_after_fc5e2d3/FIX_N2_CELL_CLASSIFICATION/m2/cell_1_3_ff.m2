kkbase = ZZ/100057;
omv = 1140_kkbase; kpv = 74361_kkbase; kmv = 63219_kkbase;
R = kkbase[c0,c1,c2,c3,c4,c5,c6,c7,w];
om = omv; kp = kpv; km = kmv;
I = ideal(c0*c4^2*om - c1*c4^2*om - c1*c4^2 + c2*c4*c6,-c0*c6^2*om - c0*c6^2 + c1*c6^2*om + c3*c4*c6,c0*c2^2 + c1*c2^2 + c2*c4*c7,c0^3*kp + 2*c0*c2*c3 + 2*c0*c4*c5*om - 2*c0*c6*c7*om - 2*c0*c6*c7 + c1^3*km + 2*c1*c2*c3 - 2*c1*c4*c5*om - 2*c1*c4*c5 + 2*c1*c6*c7*om + c2*c5*c6 + c3*c4*c7,c0*c3^2 + c1*c3^2 + c3*c5*c6,-c0*c7^2*om - c0*c7^2 + c1*c7^2*om + c2*c5*c7,c0*c5^2*om - c1*c5^2*om - c1*c5^2 + c3*c5*c7);
print("CELL m=1 r=3 nvars=8 neqs=7");
print("dimI=" | toString dim I);
J = I + ideal(1 - w*c2);
print("EXACT-m coeff c2 -> " | (if J == ideal(1_R) then "cannot be nonzero (EMPTY)" else ("CAN be nonzero: dim=" | toString dim J)));
J = I + ideal(1 - w*c3);
print("EXACT-m coeff c3 -> " | (if J == ideal(1_R) then "cannot be nonzero (EMPTY)" else ("CAN be nonzero: dim=" | toString dim J)));
J = I + ideal(1 - w*c4);
print("EXACT-m coeff c4 -> " | (if J == ideal(1_R) then "cannot be nonzero (EMPTY)" else ("CAN be nonzero: dim=" | toString dim J)));
J = I + ideal(1 - w*c5);
print("EXACT-m coeff c5 -> " | (if J == ideal(1_R) then "cannot be nonzero (EMPTY)" else ("CAN be nonzero: dim=" | toString dim J)));
J = I + ideal(1 - w*c6);
print("EXACT-m coeff c6 -> " | (if J == ideal(1_R) then "cannot be nonzero (EMPTY)" else ("CAN be nonzero: dim=" | toString dim J)));
J = I + ideal(1 - w*c7);
print("EXACT-m coeff c7 -> " | (if J == ideal(1_R) then "cannot be nonzero (EMPTY)" else ("CAN be nonzero: dim=" | toString dim J)));

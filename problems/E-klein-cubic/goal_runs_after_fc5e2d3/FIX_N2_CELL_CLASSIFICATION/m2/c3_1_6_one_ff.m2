  print("  plane order 3 (maxexp 3) coef 5 : " | (if (J0 + ideal(1-w*(v6))) == ideal(1_R) then "forced zero" else "CAN BE NONZERO"));
  print("  plane order 3 (maxexp 3) coef 6 : " | (if (J0 + ideal(1-w*(v5))) == ideal(1_R) then "forced zero" else "CAN BE NONZERO"));
  print("  plane order 3 (maxexp 3) coef 7 : " | (if (J0 + ideal(1-w*(v6))) == ideal(1_R) then "forced zero" else "CAN BE NONZERO"));
  print("  plane order 3 (maxexp 3) coef 8 : " | (if (J0 + ideal(1-w*(v8))) == ideal(1_R) then "forced zero" else "CAN BE NONZERO"));
);

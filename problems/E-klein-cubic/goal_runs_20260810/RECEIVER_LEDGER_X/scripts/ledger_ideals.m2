-- RECEIVER_LEDGER_X : ideal-theoretic recomputation of X^H
-- generated by scripts/emit_m2.py ; run with:  M2 --script scripts/ledger_ideals.m2
nfail = 0;

kk = GF 331;
R = kk[x0,x1,x2,x3,x4];
F = x0^2*x1 + x1^2*x2 + x2^2*x3 + x3^2*x4 + x4^2*x0;
xx = matrix{{x0},{x1},{x2},{x3},{x4}};
fixIdeal = (M) -> minors(2, xx | M*xx);

-- row 1  (|H| = 1)
I = saturate(ideal(F));
dp = if I == ideal(1_R) then -1 else dim I - 1;
dg = if dp < 0 then 0 else degree I;
rad = if dp < 0 then true else (I == radical I);
<< "ROW 1 p=331 projdim " << dp << " degree " << dg << " radical " << rad << endl;
if dp != 3 or dg != 3 then (nfail = nfail + 1; << "FAIL 1 p=331 expected projdim 3 degree 3" << endl;) else << "PASS 1 p=331" << endl;

-- row C2  (|H| = 2)
I = saturate(ideal(F) + fixIdeal(matrix{{233,131,71,106,122},{131,71,106,122,233},{71,106,122,233,131},{106,122,233,131,71},{122,233,131,71,106}}));
dp = if I == ideal(1_R) then -1 else dim I - 1;
dg = if dp < 0 then 0 else degree I;
rad = if dp < 0 then true else (I == radical I);
<< "ROW C2 p=331 projdim " << dp << " degree " << dg << " radical " << rad << endl;
if dp != 1 or dg != 4 then (nfail = nfail + 1; << "FAIL C2 p=331 expected projdim 1 degree 4" << endl;) else << "PASS C2 p=331" << endl;


I = saturate(ideal(F) + fixIdeal(matrix{{634,0,0,0,0},{0,418,0,0,0},{0,0,658,0,0},{0,0,0,147,0},{0,0,0,0,81}}) + fixIdeal(matrix{{0,0,0,0,220},{9,0,0,0,0},{0,457,0,0,0},{0,0,612,0,0},{0,0,0,68,0}}));
dp = if I == ideal(1_R) then -1 else dim I - 1;
dg = if dp < 0 then 0 else degree I;
rad = if dp < 0 then true else (I == radical I);
<< "ROW F55 p=661 projdim " << dp << " degree " << dg << " radical " << rad << endl;
if dp != -1 or dg != 0 then (nfail = nfail + 1; << "FAIL F55 p=661 expected projdim -1 degree 0" << endl;) else << "PASS F55 p=661" << endl;

<< "M2 failures: " << nfail << endl;
<< (if nfail == 0 then "LEDGER_IDEALS_M2_OK" else "LEDGER_IDEALS_M2_FAILED") << endl;

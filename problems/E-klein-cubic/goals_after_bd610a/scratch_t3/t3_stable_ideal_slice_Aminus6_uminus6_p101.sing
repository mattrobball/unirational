ideal J=7496192000*Z^6-52290461509632*Z^5+11255510823558912*Z^4-390879388669351936*Z^3+9952790175318655728*Z^2-695267365283514324504*Z+8639408520488202974741,4030602169669717822209294131931312764451152742758311680*Y+86654977056823592354857770490990491777152000*Z^5-565747803811134210428655188687095077066014593792*Z^4-131973092077583177896068831516611009612016058694272*Z^3-732512136146356093349001882713368507520005268503520*Z^2-1489011481139225082488637956894969686080823840817916332*Z-441636661489121721671045144894380804058911894105405850903,9596671832546947195736414599836458962978935101805504*B+22170836073344482613407460311059481512064000*Z^5-153033608984833679349219013696308480956565388544*Z^4+22181502330847543735419926342336056513347346911616*Z^3-99980770982352917077369356175059400203246779619232*Z^2+39709514706853178344170817361967375055970092472561588*Z+48078126801117383846615483445507938530336231462805783;
K=std(K); J=std(J);
print("INPUTS"); print(dim(K)); print(degree(K)); print(dim(J)); print(degree(J)); print(reduce(K,J));
for (int ii=1; ii<=3; ii++)
{
  for (int jj=ii+1; jj<=3; jj++)
  {
    print("PAIR_"+string(ii)+"_"+string(jj));
    ideal Pair=std(K+ideal(J[ii],J[jj]));
    ideal remJ=simplify(reduce(J,Pair),2);
    if (size(remJ)==0)
    {
      print("GENERATES_J_OK");
      ideal cJ=std(K+ideal(J[ii])*J);
      ideal remStable=simplify(reduce(J*J,cJ),2);
      if (size(remStable)==0) { print("STABLE_J2_EQ_cJ_OK"); }
      else { print("STABLE_J2_EQ_cJ_FAIL_GLOBAL"); }
      ideal StableWitness=std(quotient(cJ,J*J));
      ideal StableUnit=std(StableWitness+J);
      poly remOneStable=reduce(1,StableUnit);
      if (remOneStable==0) { print("STABLE_J2_EQ_cJ_OK_LOCAL_AT_J"); }
      else { print("STABLE_J2_EQ_cJ_FAIL_LOCAL_AT_J"); }
      ideal Cond=std(quotient(K+ideal(J[ii]),ideal(J[jj])));
      ideal remCondInJ=simplify(reduce(Cond,J),2);
      ideal remJInCond=simplify(reduce(J,Cond),2);
      if ((size(remCondInJ)==0) && (size(remJInCond)==0)) { print("COLON_c_BY_d_EQ_J_OK"); }
      else
      {
        print("COLON_c_BY_d_EQ_J_FAIL_GLOBAL");
      }
      ideal CondInJWitness=std(quotient(J,Cond));
      ideal JInCondWitness=std(quotient(Cond,J));
      poly remOneCondInJ=reduce(1,std(CondInJWitness+J));
      poly remOneJInCond=reduce(1,std(JInCondWitness+J));
      if ((remOneCondInJ==0) && (remOneJInCond==0)) { print("COLON_c_BY_d_EQ_J_OK_LOCAL_AT_J"); }
      else { print("COLON_c_BY_d_EQ_J_FAIL_LOCAL_AT_J"); }
    }
    else { print("GENERATES_J_FAIL"); print(remJ); }
  }
}
quit;

if d==0 and e==6 then (
  gy=gs#1; bg=gs#2;
  cy=coefficient(Y,gy); cb=coefficient(B,bg);
  ys=apply(0..5, j -> coefficient(Z^j,gy)/cy);
  bs=apply(0..5, j -> coefficient(Z^j,bg)/cb);

  J=fglm(gb I,S);
  gs=flatten entries gens J;
  g=gs#0;
  cs=apply(0..6, j -> coefficient(Z^j,g));
);
<< "SAMPLE A=5 u=3 dim=" << d << " degree=" << e << " coeffs=";
scan(cs, c -> << toExternalString c << ",");
<< endl;

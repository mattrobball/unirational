  gy=gs#1; bg=gs#2;
  cy=coefficient(Y,gy); cb=coefficient(B,bg);
  ys=apply(0..5, j -> coefficient(Z^j,gy)/cy);
  bs=apply(0..5, j -> coefficient(Z^j,bg)/cb);
  << "YREL A=1 u=9 coeffs=";
  scan(ys, c -> << toExternalString c << ",");
  << endl;
  << "BREL A=1 u=9 coeffs=";
  scan(bs, c -> << toExternalString c << ",");
  << endl;
);
exit 0;

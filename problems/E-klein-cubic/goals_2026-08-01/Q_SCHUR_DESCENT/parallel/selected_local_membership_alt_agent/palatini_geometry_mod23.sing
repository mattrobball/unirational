ring r=23,(x0,x1,x2,x3,x4,x5),dp;
poly I4=5*x5^4+15*x4*x5^3+14*x4^2*x5^2+8*x4^3*x5+5*x4^4+15*x3*x5^3+5*x3*x4*x5^2+18*x3*x4^2*x5+15*x3*x4^3+14*x3^2*x5^2+5*x3^2*x4*x5+14*x3^2*x4^2+8*x3^3*x5+8*x3^3*x4+5*x3^4+15*x2*x5^3+5*x2*x4*x5^2+18*x2*x4^2*x5+15*x2*x4^3+5*x2*x3*x5^2+11*x2*x3*x4*x5+5*x2*x3*x4^2+18*x2*x3^2*x5+18*x2*x3^2*x4+15*x2*x3^3+14*x2^2*x5^2+5*x2^2*x4*x5+14*x2^2*x4^2+5*x2^2*x3*x5+5*x2^2*x3*x4+14*x2^2*x3^2+8*x2^3*x5+8*x2^3*x4+8*x2^3*x3+5*x2^4+15*x1*x5^3+5*x1*x4*x5^2+18*x1*x4^2*x5+15*x1*x4^3+5*x1*x3*x5^2+12*x1*x3*x4*x5+5*x1*x3*x4^2+18*x1*x3^2*x5+18*x1*x3^2*x4+15*x1*x3^3+5*x1*x2*x5^2+12*x1*x2*x4*x5+5*x1*x2*x4^2+11*x1*x2*x3*x5+12*x1*x2*x3*x4+5*x1*x2*x3^2+5*x1*x2^2*x5+5*x1*x2^2*x4+5*x1*x2^2*x3+8*x1*x2^3+14*x1^2*x5^2+5*x1^2*x4*x5+14*x1^2*x4^2+5*x1^2*x3*x5+5*x1^2*x3*x4+14*x1^2*x3^2+18*x1^2*x2*x5+18*x1^2*x2*x4+18*x1^2*x2*x3+14*x1^2*x2^2+8*x1^3*x5+8*x1^3*x4+8*x1^3*x3+15*x1^3*x2+5*x1^4+15*x0*x5^3+5*x0*x4*x5^2+5*x0*x4^2*x5+8*x0*x4^3+5*x0*x3*x5^2+16*x0*x3*x4*x5+18*x0*x3*x4^2+18*x0*x3^2*x5+18*x0*x3^2*x4+15*x0*x3^3+5*x0*x2*x5^2+12*x0*x2*x4*x5+18*x0*x2*x4^2+12*x0*x2*x3*x5+7*x0*x2*x3*x4+5*x0*x2*x3^2+5*x0*x2^2*x5+5*x0*x2^2*x4+5*x0*x2^2*x3+8*x0*x2^3+5*x0*x1*x5^2+16*x0*x1*x4*x5+18*x0*x1*x4^2+12*x0*x1*x3*x5+12*x0*x1*x3*x4+5*x0*x1*x3^2+11*x0*x1*x2*x5+7*x0*x1*x2*x4+12*x0*x1*x2*x3+5*x0*x1*x2^2+18*x0*x1^2*x5+18*x0*x1^2*x4+18*x0*x1^2*x3+5*x0*x1^2*x2+15*x0*x1^3+14*x0^2*x5^2+18*x0^2*x4*x5+14*x0^2*x4^2+5*x0^2*x3*x5+18*x0^2*x3*x4+14*x0^2*x3^2+18*x0^2*x2*x5+5*x0^2*x2*x4+18*x0^2*x2*x3+14*x0^2*x2^2+5*x0^2*x1*x5+18*x0^2*x1*x4+5*x0^2*x1*x3+18*x0^2*x1*x2+14*x0^2*x1^2+8*x0^3*x5+15*x0^3*x4+8*x0^3*x3+15*x0^3*x2+8*x0^3*x1+5*x0^4;
ideal J=diff(I4,x0),diff(I4,x1),diff(I4,x2),diff(I4,x3),diff(I4,x4),diff(I4,x5);
print("RAW_JACOBIAN_GENERATORS="+string(size(J)));
print("RAW_JACOBIAN_FIRST_TERMS="+string(size(J[1])));
ideal Graw=std(J);
print("RAW_JACOBIAN_AFFINE_DIM="+string(dim(Graw)));
ideal G=Graw;
print("PALATINI_I4_TERMS="+string(size(I4)));
print("SINGULAR_IDEAL_GENERATORS="+string(size(J)));
print("SINGULAR_AFFINE_DIM="+string(dim(G)));
print("SINGULAR_PROJECTIVE_DIM="+string(dim(G)-1));
print("SINGULAR_PROJECTIVE_DEGREE_BEGIN");
degree(G);
print("SINGULAR_PROJECTIVE_DEGREE_END");
print("SINGULAR_HILBERT_FIRST="+string(hilb(G,1)));
print("SINGULAR_HILBERT_SECOND="+string(hilb(G,2)));
list FL=factorize(I4);
print("I4_FACTOR_COUNT_WITH_UNIT="+string(size(FL[1])));
for (int i=1;i<=size(FL[1]);i++)
{
  print("I4_FACTOR="+string(i)+" MULT="+string(FL[2][i])+" DEG="+string(deg(FL[1][i])));
}
quit;

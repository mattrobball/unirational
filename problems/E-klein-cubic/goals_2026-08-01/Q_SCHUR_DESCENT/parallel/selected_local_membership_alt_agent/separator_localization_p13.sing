poly q=a3b8-3ab6y4+3a4b2y5-4a3b3y5-a2b4y5+4ab5y5-6a5y6+3a4by6+3a3b2y6+2ab4y6-2b5y6-6a4y7+5a3by7+a2b2y7+5ab3y7-3b4y7-a3y8+2a2by8-3ab2y8+6b3y8+3a2y9+aby9-b2y9-2ay10-by10-5y11-5a5b5-3a4b6+3a3b7+6a2b8-4ab9+5a6b3y+5a5b4y+6a4b5y+4a3b6y+6a2b7y+6ab8y+a7by2+4a6b2y2+4a5b3y2+2a4b4y2-a3b5y2-3a2b6y2-5ab7y2-3b8y2-3a7y3-5a6by3-3a5b2y3+3a4b3y3-2a3b4y3+3ab6y3-6a5by4-3a3b3y4-4a2b4y4+ab5y4-6b6y4+5a5y5+6a4by5+a3b2y5-6a2b3y5+6ab4y5-6b5y5+3a2b2y6+4ab3y6-2b4y6-4a3y7+5a2by7+3b3y7-2a2y8-aby8+2b2y8-3ay9+6by9-4y10+4a9+a7b2+6a6b3+a4b5+6a3b6-3a2b7+5ab8-4b9-3a8y+3a6b2y-5a5b3y+4a4b4y-4a3b5y-5a2b6y-ab7y+6b8y-3a7y2+2a6by2+4a5b2y2+2a4b3y2-6a3b4y2+a2b5y2+5ab6y2+2a6y3+2a5by3-5a4b2y3+2a3b3y3+5a2b4y3-4ab5y3+3b6y3-3a5y4+2a4by4+a3b2y4-6ab4y4-5b5y4-3a4y5-4a3by5-5a2b2y5+4ab3y5-6b4y5-6a3y6+a2by6+2b3y6-6a2y7-4aby7-4b2y7-3ay8-5by8-6y9+6a8+6a7b+2a5b3+3a4b4+3a3b5+3a2b6-b8+4a7y+6a6by+6a5b2y-5a4b3y-2a3b4y-3a2b5y-6b7y+a6y2+a5by2-2a4b2y2-a3b3y2-4a2b4y2+6ab5y2-4b6y2-6a5y3+3a4by3+5a3b2y3+4a2b3y3+6ab4y3+5b5y3+a3by4-3a2b2y4-3ab3y4+6b4y4-4a3y5+6a2by5+5ab2y5-3b3y5+4a2y6-2aby6-5b2y6-4ay7+3by7+2y8+2a6b-6a5b2+4a4b3+3a3b4-a2b5+4ab6+5b7+5a6y-6a5by+4a4b2y-4a3b3y+5a2b4y-3ab5y+6b6y-a5y2+4a4by2-5a3b2y2-5ab4y2+4b5y2+4a4y3-3a3by3+6a2b2y3-6ab3y3-6b4y3+3a3y4-6a2by4+4ab2y4-6b3y4+a2y5+aby5+2b2y5-ay6+3by6-3y7+a6+6a3b3-4a2b4+5ab5-3b6+5a5y-3a4by+a3b2y+4a2b3y+4ab4y+2b5y-6a4y2+3a3by2+2ab3y2+6b4y2+3a3y3+2a2by3-2ab2y3-5b3y3-6a2y4-2aby4-4b2y4+5ay5-5by5+2y6-4a5+5a4b-2ab4-3b5-2a4y+a3by+4ab3y+2b4y+3a3y2+4a2by2-ab2y2-2b3y2+5aby3+2b2y3+2ay4-3by4+y5-3a4-6a3b+4a2b2-b4+2a3y+3ab2y-4a2y2+6aby2+5b2y2-4ay3-6by3+3y4-2a3-5a2b+2ab2-3a2y+2aby-2b2y-5ay2+4by2+6a2-ab-5b2-4ay-3y2+5a+b+5y+5;
print("SEPARATOR_TERMS="); print(size(q));
print("SEPARATOR_AT_ORIGIN="); print(subst(subst(subst(q,a,0),b,0),y,0));
ideal K=JU,w*q-1;
option(noredSB); option(prot);
print("START_SEPARATOR_LOCALIZATION_GB");
ideal GK=groebner(K);
print("SEPARATOR_LOCALIZATION_GB_DONE");
print("SEPARATOR_LOCALIZATION_GB_SIZE="); print(size(GK));
print("START_SEPARATOR_LOCALIZATION_REDUCE");
poly r=reduce(PU,GK);
print("SEPARATOR_LOCALIZATION_REDUCE_DONE");
if (r==0) { print("SEPARATOR_LOCALIZATION_P_ZERO=true"); } else { print("SEPARATOR_LOCALIZATION_P_ZERO=false"); }
print("SEPARATOR_LOCALIZATION_PROBE_DONE");
quit;

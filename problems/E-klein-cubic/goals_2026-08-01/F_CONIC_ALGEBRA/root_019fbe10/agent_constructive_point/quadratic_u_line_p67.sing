option(redSB);
option(prot);
ring r=(67,s),(a0,a1,a2,b0,b1,b2,lam,invlam),dp;
ideal I=a0^3 - 8*a0*b0^2 - 9*a0*b0 + 7*a0 + b0^3*(8 - 32*s) + b0^2*(25*s - 12) + b0*(-30*s - 28) + lam*(13*s^6 + 12*s^5 + 16*s^4 + 6*s^3 + 7*s^2 + 24*s + 30) - 8*s + 9,
3*a0^2*a1 - 16*a0*b0*b1 - 9*a0*b1 - 8*a1*b0^2 - 9*a1*b0 + 7*a1 + b0^2*b1*(24 - 29*s) + b0*b1*(-17*s - 24) + b1*(-30*s - 28) + lam*(8*s^5 + 4*s^4 + 20*s^3 - 23*s^2 - 22*s - 31),
3*a0^2*a2 + 3*a0*a1^2 - 16*a0*b0*b2 - 8*a0*b1^2 - 9*a0*b2 - 16*a1*b0*b1 - 9*a1*b1 - 8*a2*b0^2 - 9*a2*b0 + 7*a2 + b0^2*b2*(24 - 29*s) + b0*b1^2*(24 - 29*s) + b0*b2*(-17*s - 24) + b1^2*(25*s - 12) + b2*(-30*s - 28) + lam*(-22*s^5 - 22*s^4 - 29*s^3 - 13*s^2 + 27*s - 8),
6*a0*a1*a2 - 16*a0*b1*b2 + a1^3 - 16*a1*b0*b2 - 8*a1*b1^2 - 9*a1*b2 - 16*a2*b0*b1 - 9*a2*b1 + b0*b1*b2*(9*s - 19) + b1^3*(8 - 32*s) + b1*b2*(-17*s - 24) + lam*(s^4 + 7*s^3 + 32*s^2 + 29*s + 31),
3*a0*a2^2 - 8*a0*b2^2 + 3*a1^2*a2 - 16*a1*b1*b2 - 16*a2*b0*b2 - 8*a2*b1^2 - 9*a2*b2 + b0*b2^2*(24 - 29*s) + b1^2*b2*(24 - 29*s) + b2^2*(25*s - 12) + lam*(8*s^4 - 21*s^3 + 7*s^2 - 6*s + 17),
3*a1*a2^2 - 8*a1*b2^2 - 16*a2*b1*b2 + b1*b2^2*(24 - 29*s) + lam*(-12*s^3 - 33*s^2 - 24*s - 21),
a2^3 - 8*a2*b2^2 + b2^3*(8 - 32*s) + lam*(-29*s^2 - 28*s - 18),
invlam*lam - 1;
print("INPUT_READY");
ideal G=std(I);
print("STD_DONE");
print("DIM="+string(dim(G)));
print("VDIM="+string(vdim(G)));
print("LM="+string(lead(G)));
quit;

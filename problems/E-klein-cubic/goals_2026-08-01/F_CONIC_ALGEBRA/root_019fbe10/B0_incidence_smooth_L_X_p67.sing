ideal I=31*A*w^3 + A*w^2*y + 28*A*w^2 + 9*A*w*y^2 + 15*A*w*y + 11*A*y^3 + 33*A*y^2 - 24*J*w^3 + 11*J*w^2*y - 13*J*w^2 - 23*J*w*y^2 - 14*J*w*y + 17*J*y^3 + 22*J*y^2 - 8*T*w^3 - 30*T*w^2*y + 25*T*w*y^2 - 32*T*y^3 + 24*w^3 - 32*w^2*y + 18*w^2 + 5*w*y^2 + 18*w*y - 13*y^3 + 27*y^2 + 1,31*w^3 + w^2*y + 28*w^2 + 9*w*y^2 + 15*w*y + 11*y^3 + 33*y^2,-24*w^3 + 11*w^2*y - 13*w^2 - 23*w*y^2 - 14*w*y + 17*y^3 + 22*y^2,-8*w^3 - 30*w^2*y + 25*w*y^2 - 32*y^3,A*w^2 + 18*A*w*y + 15*A*w + 33*A*y^2 + 66*A*y + 11*J*w^2 - 46*J*w*y - 14*J*w + 51*J*y^2 + 44*J*y - 30*T*w^2 + 50*T*w*y - 96*T*y^2 - 32*w^2 + 10*w*y + 18*w - 39*y^2 + 54*y,93*A*w^2 + 2*A*w*y + 56*A*w + 9*A*y^2 + 15*A*y - 72*J*w^2 + 22*J*w*y - 26*J*w - 23*J*y^2 - 14*J*y - 24*T*w^2 - 60*T*w*y + 25*T*y^2 + 72*w^2 - 64*w*y + 36*w + 5*y^2 + 18*y;

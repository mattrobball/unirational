ring R=(89,r),(y,w,l0,l2),dp;
option(redSB);
ideal I=10*l0*r^2*w^3 + 30*l0*r^2*w^2*y + l0*r^2*w^2 + 4*l0*r^2*w*y^2 - 10*l0*r^2*w*y - 14*l0*r^2*y^3 - 35*l0*r^2*y^2 + 17*l0*w^3 - 32*l0*w^2*y - 7*l0*w^2 + 22*l0*w*y^2 + 16*l0*w*y + 30*l0*y^3 - 14*l0*y^2 + l0 + 28*l2*w^3 - 27*l2*w^2*y + 6*l2*w*y^2 - 22*l2*y^3 - 41*r*w^3 - 27*r*w^2*y - 9*r*w*y^2 - 17*r*y^3 + 15*w^3 + 11*w^2*y + 23*w^2 - 25*w*y^2 - 23*w*y + 19*y^3 + 28*y^2,30*l0*r^2*w^2 + 8*l0*r^2*w*y - 10*l0*r^2*w - 42*l0*r^2*y^2 - 70*l0*r^2*y - 32*l0*w^2 + 44*l0*w*y + 16*l0*w + 90*l0*y^2 - 28*l0*y - 27*l2*w^2 + 12*l2*w*y - 66*l2*y^2 - 27*r*w^2 - 18*r*w*y - 51*r*y^2 + 11*w^2 - 50*w*y - 23*w + 57*y^2 + 56*y,30*l0*r^2*w^2 + 60*l0*r^2*w*y + 2*l0*r^2*w + 4*l0*r^2*y^2 - 10*l0*r^2*y + 51*l0*w^2 - 64*l0*w*y - 14*l0*w + 22*l0*y^2 + 16*l0*y + 84*l2*w^2 - 54*l2*w*y + 6*l2*y^2 - 123*r*w^2 - 54*r*w*y - 9*r*y^2 + 45*w^2 + 22*w*y + 46*w - 25*y^2 - 23*y,10*r^2*w^3 + 30*r^2*w^2*y + r^2*w^2 + 4*r^2*w*y^2 - 10*r^2*w*y - 14*r^2*y^3 - 35*r^2*y^2 + 17*w^3 - 32*w^2*y - 7*w^2 + 22*w*y^2 + 16*w*y + 30*y^3 - 14*y^2 + 1,28*w^3 - 27*w^2*y + 6*w*y^2 - 22*y^3;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("NET_NORMALITY_X_l1_P89_DONE");
quit;

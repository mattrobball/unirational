ring R=(89,r),(X,w,l1,l2),dp;
option(redSB);
ideal I=X^3 + 23*X*l1*w^2 - 23*X*l1*w + 28*X*l1 + X*r^2*w^2 - 10*X*r^2*w - 35*X*r^2 - 7*X*w^2 + 16*X*w - 14*X - 41*l1*r*w^3 - 27*l1*r*w^2 - 9*l1*r*w - 17*l1*r + 15*l1*w^3 + 11*l1*w^2 - 25*l1*w + 19*l1 + 28*l2*w^3 - 27*l2*w^2 + 6*l2*w - 22*l2 + 10*r^2*w^3 + 30*r^2*w^2 + 4*r^2*w - 14*r^2 + 17*w^3 - 32*w^2 + 22*w + 30,3*X^2 + 23*l1*w^2 - 23*l1*w + 28*l1 + r^2*w^2 - 10*r^2*w - 35*r^2 - 7*w^2 + 16*w - 14,46*X*l1*w - 23*X*l1 + 2*X*r^2*w - 10*X*r^2 - 14*X*w + 16*X - 123*l1*r*w^2 - 54*l1*r*w - 9*l1*r + 45*l1*w^2 + 22*l1*w - 25*l1 + 84*l2*w^2 - 54*l2*w + 6*l2 + 30*r^2*w^2 + 60*r^2*w + 4*r^2 + 51*w^2 - 64*w + 22,23*X*w^2 - 23*X*w + 28*X - 41*r*w^3 - 27*r*w^2 - 9*r*w - 17*r + 15*w^3 + 11*w^2 - 25*w + 19,28*w^3 - 27*w^2 + 6*w - 22;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("NET_NORMALITY_y_l0_P89_DONE");
quit;

ring R=89,(y,w),dp;
option(redSB);
ideal I=23*w^3 - 43*w^2*y + 16*w^2 + 11*w*y^2 + 3*w*y - 38*y^3 - 21*y^2 + 1,14*w^3 - 19*w^2*y - 36*w*y^2 + 21*y^3,-36*w^3 - 43*w^2*y + 5*w^2 + 22*w*y^2 - 5*w*y - 18*y^3 - 21*y^2,35*w^3 + 8*w^2*y - 12*w*y^2 + 33*y^3;
ideal G=std(I);
poly n=reduce(1,G);
if (n==0) { print("BASEPOINT_EMPTY=1"); } else { print("BASEPOINT_EMPTY=0"); }
print("B0_FOUR_FORM_BASEPOINT_X_P89_DONE");
quit;

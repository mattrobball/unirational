ring R=(89,r),(X,y,l0,l2),dp;
option(redSB);
ideal I=X^3*l0 - 35*X*l0*r^2*y^2 - 10*X*l0*r^2*y + X*l0*r^2 - 14*X*l0*y^2 + 16*X*l0*y - 7*X*l0 + 28*X*y^2 - 23*X*y + 23*X - 14*l0*r^2*y^3 + 4*l0*r^2*y^2 + 30*l0*r^2*y + 10*l0*r^2 + 30*l0*y^3 + 22*l0*y^2 - 32*l0*y + 17*l0 - 22*l2*y^3 + 6*l2*y^2 - 27*l2*y + 28*l2 - 17*r*y^3 - 9*r*y^2 - 27*r*y - 41*r + 19*y^3 - 25*y^2 + 11*y + 15,3*X^2*l0 - 35*l0*r^2*y^2 - 10*l0*r^2*y + l0*r^2 - 14*l0*y^2 + 16*l0*y - 7*l0 + 28*y^2 - 23*y + 23,-70*X*l0*r^2*y - 10*X*l0*r^2 - 28*X*l0*y + 16*X*l0 + 56*X*y - 23*X - 42*l0*r^2*y^2 + 8*l0*r^2*y + 30*l0*r^2 + 90*l0*y^2 + 44*l0*y - 32*l0 - 66*l2*y^2 + 12*l2*y - 27*l2 - 51*r*y^2 - 18*r*y - 27*r + 57*y^2 - 50*y + 11,X^3 - 35*X*r^2*y^2 - 10*X*r^2*y + X*r^2 - 14*X*y^2 + 16*X*y - 7*X - 14*r^2*y^3 + 4*r^2*y^2 + 30*r^2*y + 10*r^2 + 30*y^3 + 22*y^2 - 32*y + 17,-22*y^3 + 6*y^2 - 27*y + 28;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("NET_NORMALITY_w_l1_P89_DONE");
quit;

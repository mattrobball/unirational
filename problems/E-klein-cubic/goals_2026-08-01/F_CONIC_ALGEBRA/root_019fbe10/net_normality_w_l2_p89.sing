ring R=(89,r),(X,y,l0,l1),dp;
option(redSB);
ideal I=X^3*l0 - 35*X*l0*r^2*y^2 - 10*X*l0*r^2*y + X*l0*r^2 - 14*X*l0*y^2 + 16*X*l0*y - 7*X*l0 + 28*X*l1*y^2 - 23*X*l1*y + 23*X*l1 - 14*l0*r^2*y^3 + 4*l0*r^2*y^2 + 30*l0*r^2*y + 10*l0*r^2 + 30*l0*y^3 + 22*l0*y^2 - 32*l0*y + 17*l0 - 17*l1*r*y^3 - 9*l1*r*y^2 - 27*l1*r*y - 41*l1*r + 19*l1*y^3 - 25*l1*y^2 + 11*l1*y + 15*l1 - 22*y^3 + 6*y^2 - 27*y + 28,3*X^2*l0 - 35*l0*r^2*y^2 - 10*l0*r^2*y + l0*r^2 - 14*l0*y^2 + 16*l0*y - 7*l0 + 28*l1*y^2 - 23*l1*y + 23*l1,-70*X*l0*r^2*y - 10*X*l0*r^2 - 28*X*l0*y + 16*X*l0 + 56*X*l1*y - 23*X*l1 - 42*l0*r^2*y^2 + 8*l0*r^2*y + 30*l0*r^2 + 90*l0*y^2 + 44*l0*y - 32*l0 - 51*l1*r*y^2 - 18*l1*r*y - 27*l1*r + 57*l1*y^2 - 50*l1*y + 11*l1 - 66*y^2 + 12*y - 27,X^3 - 35*X*r^2*y^2 - 10*X*r^2*y + X*r^2 - 14*X*y^2 + 16*X*y - 7*X - 14*r^2*y^3 + 4*r^2*y^2 + 30*r^2*y + 10*r^2 + 30*y^3 + 22*y^2 - 32*y + 17,28*X*y^2 - 23*X*y + 23*X - 17*r*y^3 - 9*r*y^2 - 27*r*y - 41*r + 19*y^3 - 25*y^2 + 11*y + 15;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("NET_NORMALITY_w_l2_P89_DONE");
quit;

ring R=89,(L,A,B,T),dp;
option(redSB);
ideal I=44*A^3 + 21*A^2*L + 15*A^2 - 3*A*B*L - 15*A*L^2 + 43*A*L*T - 9*A*L + 21*A - 41*B^2*L + 30*B*L^2 - 41*B*L*T + 21*B*L - 41*L^3 + 15*L^2*T - 11*L^2 + 12*L*T^2 - 34*L*T + 41*L,
21*A^2 - 3*A*B - 30*A*L + 43*A*T - 9*A - 41*B^2 + 60*B*L - 41*B*T + 21*B - 123*L^2 + 30*L*T - 22*L + 12*T^2 - 34*T + 41,
132*A^2 + 42*A*L + 30*A - 3*B*L - 15*L^2 + 43*L*T - 9*L + 21,
-3*A*L - 82*B*L + 30*L^2 - 41*L*T + 21*L,
15*A^2 - 9*A*L + 42*A + 21*B*L - 11*L^2 - 34*L*T + 82*L,
43*A*L - 41*B*L + 15*L^2 + 24*L*T - 34*L;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("INFINITY_Q4_SMOOTH_Y_P89_DONE");
quit;

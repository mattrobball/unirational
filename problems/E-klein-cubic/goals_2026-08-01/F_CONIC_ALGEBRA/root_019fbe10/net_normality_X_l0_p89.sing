ring R=(89,r),(y,w,l1,l2),dp;
option(redSB);
ideal I=-41*l1*r*w^3 - 27*l1*r*w^2*y - 9*l1*r*w*y^2 - 17*l1*r*y^3 + 15*l1*w^3 + 11*l1*w^2*y + 23*l1*w^2 - 25*l1*w*y^2 - 23*l1*w*y + 19*l1*y^3 + 28*l1*y^2 + 28*l2*w^3 - 27*l2*w^2*y + 6*l2*w*y^2 - 22*l2*y^3 + 10*r^2*w^3 + 30*r^2*w^2*y + r^2*w^2 + 4*r^2*w*y^2 - 10*r^2*w*y - 14*r^2*y^3 - 35*r^2*y^2 + 17*w^3 - 32*w^2*y - 7*w^2 + 22*w*y^2 + 16*w*y + 30*y^3 - 14*y^2 + 1,-27*l1*r*w^2 - 18*l1*r*w*y - 51*l1*r*y^2 + 11*l1*w^2 - 50*l1*w*y - 23*l1*w + 57*l1*y^2 + 56*l1*y - 27*l2*w^2 + 12*l2*w*y - 66*l2*y^2 + 30*r^2*w^2 + 8*r^2*w*y - 10*r^2*w - 42*r^2*y^2 - 70*r^2*y - 32*w^2 + 44*w*y + 16*w + 90*y^2 - 28*y,-123*l1*r*w^2 - 54*l1*r*w*y - 9*l1*r*y^2 + 45*l1*w^2 + 22*l1*w*y + 46*l1*w - 25*l1*y^2 - 23*l1*y + 84*l2*w^2 - 54*l2*w*y + 6*l2*y^2 + 30*r^2*w^2 + 60*r^2*w*y + 2*r^2*w + 4*r^2*y^2 - 10*r^2*y + 51*w^2 - 64*w*y - 14*w + 22*y^2 + 16*y,-41*r*w^3 - 27*r*w^2*y - 9*r*w*y^2 - 17*r*y^3 + 15*w^3 + 11*w^2*y + 23*w^2 - 25*w*y^2 - 23*w*y + 19*y^3 + 28*y^2,28*w^3 - 27*w^2*y + 6*w*y^2 - 22*y^3;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("NET_NORMALITY_X_l0_P89_DONE");
quit;

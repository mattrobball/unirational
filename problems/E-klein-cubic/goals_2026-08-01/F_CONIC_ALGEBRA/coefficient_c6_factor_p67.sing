ring R=67,(A,B,Y,Z),dp;
poly C=171478296*A^5*B^2 + 829230775704*A^4*B^2 - 1122403392*A^3*B^3 + 191318760000*A^3*B^2*Y - 561201696*A^3*B^2*Z - 52998893312688*A^3*B^2 + 108669055680*A^2*B^3 + 11019960576*A^2*B^2*Y^2 - 8969329578816*A^2*B^2*Y + 54334527840*A^2*B^2*Z + 1258459983265680*A^2*B^2 + 1836660096*A*B^4 + 11019960576*A*B^3*Y + 1836660096*A*B^3*Z - 2867944739904*A*B^3 - 330598817280*A*B^2*Y^2 + 5509980288*A*B^2*Y*Z + 139206896986176*A*B^2*Y + 459165024*A*B^2*Z^2 - 1433972369952*A*B^2*Z - 13201384156314120*A*B^2 - 27549901440*B^4 - 165299408640*B^3*Y - 27549901440*B^3*Z + 22356745018560*B^3 + 2479491129600*B^2*Y^2 - 82649704320*B^2*Y*Z - 715705114559040*B^2*Y - 6887475360*B^2*Z^2 + 11178372509280*B^2*Z + 51628506689215800*B^2;
list L=factorize(C,1);
ideal I=L[1];
print("FACTOR_COUNT="+string(size(I)));
int i;
for (i=1; i<=size(I); i=i+1) {
  print("FACTOR_"+string(i)+"_DEG="+string(deg(I[i])));
  print("FACTOR_"+string(i)+"="+string(I[i]));
}
print("COEFFICIENT_C6_FACTOR_DONE");
quit;

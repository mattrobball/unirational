ring R=(67,r),(y,w),dp;
option(redSB);
ideal I=4*r^2*w^3 - 8*r^2*w^2*y - 27*r^2*w^2 + 26*r^2*w*y^2 - 13*r^2*w*y - 23*r^2*y^3 - 10*r^2*y^2 + 20*w^3 + 10*w^2*y - 10*w^2 + 21*w*y^2 + 29*w*y + 13*y^3 - 14*y^2 + 1,
-29*r*w^3 - 20*r*w^2*y - 9*r*w*y^2 + 25*r*y^3 + 26*w^3 + 28*w^2*y - 18*w^2 - 6*w*y^2 + 27*w*y + 5*y^3 + 15*y^2,
-17*w^3 + 10*w^2*y - 24*w*y^2 - 15*y^3;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); print(G); }
print("INFINITY_NET_BASEPOINT_X_P67_DONE");
quit;

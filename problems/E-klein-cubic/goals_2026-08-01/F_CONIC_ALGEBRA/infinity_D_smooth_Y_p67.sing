ring R=67,(L,A,B,T),dp;
option(redSB);
ideal I=27*A^3 + 12*A^2*L - 4*A^2 - 12*A*B*L + 17*A*L^2 - 6*A*L*T - 15*A*L + 20*A - 19*B^2*L - 25*B*L^2 - 19*B*L*T + 20*B*L + 4*L^3 + 21*L^2*T + 31*L^2 + 12*L*T^2 + 10*L*T - 32*L,
12*A^2 - 12*A*B + 34*A*L - 6*A*T - 15*A - 19*B^2 - 50*B*L - 19*B*T + 20*B + 12*L^2 + 42*L*T + 62*L + 12*T^2 + 10*T - 32,
81*A^2 + 24*A*L - 8*A - 12*B*L + 17*L^2 - 6*L*T - 15*L + 20,
-12*A*L - 38*B*L - 25*L^2 - 19*L*T + 20*L,
-4*A^2 - 15*A*L + 40*A + 20*B*L + 31*L^2 + 10*L*T - 64*L,
-6*A*L - 19*B*L + 21*L^2 + 24*L*T + 10*L;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); }
print("INFINITY_D_SMOOTH_Y_P67_DONE");
quit;

ring R=(89,r),(y,w),dp;
option(redSB);
ideal I=10*r^2*w^3 + 30*r^2*w^2*y + r^2*w^2 + 4*r^2*w*y^2 - 10*r^2*w*y - 14*r^2*y^3 - 35*r^2*y^2 + 17*w^3 - 32*w^2*y - 7*w^2 + 22*w*y^2 + 16*w*y + 30*y^3 - 14*y^2 + 1,
-41*r*w^3 - 27*r*w^2*y - 9*r*w*y^2 - 17*r*y^3 + 15*w^3 + 11*w^2*y + 23*w^2 - 25*w*y^2 - 23*w*y + 19*y^3 + 28*y^2,
28*w^3 - 27*w^2*y + 6*w*y^2 - 22*y^3;
ideal G=std(I);
print("DIM="+string(dim(G)));
poly n=reduce(1,G);
if (n==0) { print("UNIT=1"); } else { print("UNIT=0"); print(G); }
print("INFINITY_NET_BASEPOINT_X_P89_DONE");
quit;

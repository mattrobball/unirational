  ((-1)*om)*B7^2+((-1)*om)*B2+((-2)+(-2)*om)*B2*B7+((-2))*B2*B7^2+((6)*om)*B2*B7^3+((2)*om)*B2^2*B7+((4)+(4)*om)*B2^2*B7^2+((4))*B2^2*B7^3+((-4)*om)*B2^2*B7^4+((-1)+(-1)*om)*B2^3+((-13/24)+(-61/12)*om+(2/3)*kp+(1/3)*om*kp)*B2^3*B7^2+((-4)+(-4)*om)*B2^3*B7^3,
  ((1)*om)*B7+((-1)+(-1)*om)*B2+((-2)*om)*B2*B7^2+((-13/72)+(-13/36)*om+(2/9)*kp+(4/9)*om*kp)*B2^2*B7^2
);

kk = toField(QQ[om,kp]/ideal(om^2+om+1, 8*kp^2-13*kp-4));
R = kk[P0,R0,B0,B1,B2,B3,B4,w, MonomialOrder=>GRevLex];
I = ideal(((1))*B0*B2*B4+((-1)+(-1)*om)*R0*B4^2+((1)*om)*P0*B4^2,((1))*B1*B2*B4+((1)*om)*R0*B2^2+((-1)+(-1)*om)*P0*B2^2,((1))*B2^2*B4+((1))*B0*B3*B4+((1))*B0*B1*B2+((1))*R0*B4^2+((-2)+(-2)*om)*R0*B1*B4+((1))*R0*B0^2+((1))*P0*B4^2+((2)*om)*P0*B1*B4+((1))*P0*B0^2,((1))*B2*B3*B4+((1))*B1*B3*B4+((1))*B1^2*B2+((1))*B0*B2*B3+((1))*B0^2*B4+((1)*om)*R0*B4^2+((-2)+(-2)*om)*R0*B3*B4+((2)*om)*R0*B2*B3+((-1)+(-1)*om)*R0*B2^2+((2))*R0*B0*B1+((13/8)+(-1)*kp)*R0^3+((-1)+(-1)*om)*P0*B4^2+((2)*om)*P0*B3*B4+((-2)+(-2)*om)*P0*B2*B3+((1)*om)*P0*B2^2+((2))*P0*B0*B1+((1)*kp)*P0^3,((1))*B2*B4^2+((1))*B1*B2*B3+((1))*B0*B1*B4+((1))*R0*B2^2+((1))*R0*B1^2+((2)*om)*R0*B0*B2+((1))*P0*B2^2+((1))*P0*B1^2+((-2)+(-2)*om)*P0*B0*B2,((1))*B2*B3*B4+((1))*B1*B2^2+((1))*B0*B4^2+((1))*B0*B1*B3+((2))*R0*B1*B4+((-1)+(-1)*om)*R0*B1^2+((2))*R0*B0*B2+((1)*om)*R0*B0^2+((2))*P0*B1*B4+((1)*om)*P0*B1^2+((2))*P0*B0*B2+((-1)+(-1)*om)*P0*B0^2,((1))*B3^2*B4+((1))*B2^2*B3+((1))*B1*B4^2+((1))*B1*B2*B3+((1))*B1^2*B3+((1))*B0*B3^2+((1))*B0*B2*B4+((1))*B0*B1*B4+((1))*B0^2*B2+((1))*B0^2*B1+((2))*R0*B3*B4+((1)*om)*R0*B3^2+((2)*om)*R0*B2*B4+((-2)+(-2)*om)*R0*B2*B3+((2)*om)*R0*B1*B4+((-2)+(-2)*om)*R0*B1*B3+((2))*R0*B1*B2+((-2)+(-2)*om)*R0*B0*B4+((2))*R0*B0*B3+((2)*om)*R0*B0*B1+((-1)+(-1)*om)*R0*B0^2+((39/8)*om+(-3)*om*kp)*R0^3+((2))*P0*B3*B4+((-1)+(-1)*om)*P0*B3^2+((-2)+(-2)*om)*P0*B2*B4+((2)*om)*P0*B2*B3+((-2)+(-2)*om)*P0*B1*B4+((2)*om)*P0*B1*B3+((2))*P0*B1*B2+((2)*om)*P0*B0*B4+((2))*P0*B0*B3+((-2)+(-2)*om)*P0*B0*B1+((1)*om)*P0*B0^2+((-3)*kp+(-3)*om*kp)*P0^3,((1))*B3*B4^2+((1))*B2*B3^2+((1))*B1*B3^2+((1))*B1*B2*B4+((1))*B1^2*B4+((1))*B0*B3*B4+((1))*B0*B2^2+((1))*B0*B1*B2+((1))*B0*B1^2+((1))*B0^2*B3+((2)*om)*R0*B3*B4+((-1)+(-1)*om)*R0*B3^2+((-2)+(-2)*om)*R0*B2*B4+((2))*R0*B2*B3+((2))*R0*B1*B3+((2)*om)*R0*B1*B2+((1)*om)*R0*B1^2+((2))*R0*B0*B4+((2)*om)*R0*B0*B3+((-2)+(-2)*om)*R0*B0*B2+((-2)+(-2)*om)*R0*B0*B1+((-39/8)+(-39/8)*om+(3)*kp+(3)*om*kp)*R0^3+((-2)+(-2)*om)*P0*B3*B4+((1)*om)*P0*B3^2+((2)*om)*P0*B2*B4+((2))*P0*B2*B3+((2))*P0*B1*B3+((-2)+(-2)*om)*P0*B1*B2+((-1)+(-1)*om)*P0*B1^2+((2))*P0*B0*B4+((-2)+(-2)*om)*P0*B0*B3+((2)*om)*P0*B0*B2+((2)*om)*P0*B0*B1+((3)*om*kp)*P0^3,((1))*B4^3+((1))*B3^3+((1))*B2^3+((3))*B1*B3*B4+((1))*B1^3+((3))*B0*B2*B3+((3))*B0*B1*B3+((1))*B0^3+((3))*R0*B3^2+((6))*R0*B2*B4+((6)*om)*R0*B1*B3+((-6)+(-6)*om)*R0*B1*B2+((6)*om)*R0*B0*B4+((-6)+(-6)*om)*R0*B0*B3+((39/4)+(-6)*kp)*R0^3+((3))*P0*B3^2+((6))*P0*B2*B4+((-6)+(-6)*om)*P0*B1*B3+((6)*om)*P0*B1*B2+((-6)+(-6)*om)*P0*B0*B4+((6)*om)*P0*B0*B3+((6)*kp)*P0^3);
print("### r=5 lam=one free=7 eqs=9");
J = I + ideal(w);
d = dim J;
print("CONE-DIM " | toString d | (if d == 0 then "  ZERO-ONLY" else "  NONTRIVIAL"));
if d > 0 then (
  print("CONE-DEGREE " | toString degree J);
  print("PO2 P0 : " | (if (I + ideal(1-w*P0)) == ideal(1_R) then "forced-zero" else "CAN-BE-NONZERO"));
  print("PO2 R0 : " | (if (I + ideal(1-w*R0)) == ideal(1_R) then "forced-zero" else "CAN-BE-NONZERO"));
  print("PO2 B0 : " | (if (I + ideal(1-w*B0)) == ideal(1_R) then "forced-zero" else "CAN-BE-NONZERO"));
  print("PO2 B1 : " | (if (I + ideal(1-w*B1)) == ideal(1_R) then "forced-zero" else "CAN-BE-NONZERO"));
  print("PO1 B2 : " | (if (I + ideal(1-w*B2)) == ideal(1_R) then "forced-zero" else "CAN-BE-NONZERO"));
  print("PO3 B3 : " | (if (I + ideal(1-w*B3)) == ideal(1_R) then "forced-zero" else "CAN-BE-NONZERO"));

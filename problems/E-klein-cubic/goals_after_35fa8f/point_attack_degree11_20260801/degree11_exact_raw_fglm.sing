LIB "nfmodstd.lib";
ideal J=nfmodStd(I);
attrib(J,"isSB",1);
if (reduce(1,J)==0) { print("UNIT"); } else { print("NONUNIT_DP"); }
print("INPUT_REMAINDER"); reduce(I,J);
print("DIM_DP"); dim(J); print("VDIM_DP"); vdim(J);
def Rdp=basering;
ring Rlp=(0,u),(a1,a2,a3,a4),lp;
minpoly=u^4+12*u^2+256;
setring Rlp;
ideal L=fglm(Rdp,J);
attrib(L,"isSB",1);
print("LEX_BASIS"); L;
print("DIM_LP"); dim(L); print("VDIM_LP"); vdim(L);
quit;

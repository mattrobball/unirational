ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("Kt|dim=%s|mult=%s|vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
LIB "primdec.lib";
if (dim(J)==0) {
  ideal rad=radical(I); ideal Jr=std(rad);
  print(sprintf("Kt|rad_vdim=%s|nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));
}
ring rlex=(0,z),(a,b,c,d),lp;
ideal Ilex=fetch(r,I);
ideal Glex=std(Ilex);
print(sprintf("Kt|lex_size=%s", string(size(Glex))));
if(size(Glex)>0){
  print(sprintf("Kt|lex_G1_deg=%s", string(deg(Glex[1]))));
  list fac=factorize(Glex[1]);
  print(sprintf("Kt|nfac=%s", string(size(fac[1]))));
  for(int i=1;i<=size(fac[1]);i++){
    print(sprintf("Kt|fac%s_deg=%s|fac%s_mult=%s", string(i), string(deg(fac[1][i])), string(i), string(fac[2][i])));
  }
}

LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = -313740*a^3 - 9925578*a^2*b + 306720*a^2 + 1354860*a*b^2 + 91213740*a*b + 58347888*a - 88535*b^3 + 595464*b^2 + 325436040*b + 151303140;
poly f1 = -941220*a^2*c - 9925578*a^2*d + 21874770*a^2 - 19851156*a*b*c + 2709720*a*b*d + 96849390*a*b + 613440*a*c + 91213740*a*d - 140691420*a + 1354860*b^2*c - 265605*b^2*d - 25095798*b^2 + 91213740*b*c + 1190928*b*d - 168009048*b + 58347888*c + 325436040*d + 11084942338;
poly f2 = -941220*a*c^2 - 19851156*a*c*d + 43749540*a*c + 1354860*a*d^2 + 96849390*a*d - 964748082*a - 9925578*b*c^2 + 2709720*b*c*d + 96849390*b*c - 265605*b*d^2 - 50191596*b*d - 2144490363*b + 306720*c^2 + 91213740*c*d - 140691420*c + 595464*d^2 - 168009048*d + 3862922352;
poly f3 = -313740*c^3 - 9925578*c^2*d + 21874770*c^2 + 1354860*c*d^2 + 96849390*c*d - 964748082*c - 88535*d^3 - 25095798*d^2 - 2144490363*d - 128269894;
ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("chart4|dim=%s|mult=%s|vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad = radical(I);
ideal Jr = std(rad);
print(sprintf("chart4|rad_vdim=%s|nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

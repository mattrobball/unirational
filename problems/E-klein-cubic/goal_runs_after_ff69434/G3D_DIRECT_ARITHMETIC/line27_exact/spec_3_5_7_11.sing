LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = 195716070*a^3 - 12980331405*a^2*b + 741132720*a^2 - 1503809118495*a*b^2 + 34900662150*a*b - 2084131350*a - 458923074789*b^3 - 471885803631*b^2 + 7887102795*b - 47558700;
poly f1 = 587148210*a^2*c - 12980331405*a^2*d + 1505878740*a^2 - 25960662810*a*b*c - 3007618236990*a*b*d - 83396217654*a*b + 1482265440*a*c + 34900662150*a*d + 28880524980*a - 1503809118495*b^2*c - 1376769224367*b^2*d + 2920050856395*b^2 + 34900662150*b*c - 943771607262*b*d - 62809437150*b - 2084131350*c + 7887102795*d + 113767740;
poly f2 = 587148210*a*c^2 - 25960662810*a*c*d + 3011757480*a*c - 1503809118495*a*d^2 - 83396217654*a*d + 144498936690*a - 12980331405*b*c^2 - 3007618236990*b*c*d - 83396217654*b*c - 1376769224367*b*d^2 + 5840101712790*b*d + 4922693857055*b + 741132720*c^2 + 34900662150*c*d + 28880524980*c - 471885803631*d^2 - 62809437150*d + 15549356160;
poly f3 = 195716070*c^3 - 12980331405*c^2*d + 1505878740*c^2 - 1503809118495*c*d^2 - 83396217654*c*d + 144498936690*c - 458923074789*d^3 + 2920050856395*d^2 + 4922693857055*d + 47435096880;
ideal I=f0,f1,f2,f3;
ideal J=std(I);
print(sprintf("t=(3, 5, 7, 11) dim=%s mult=%s vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad=radical(I); ideal Jr=std(rad);
print(sprintf("t=(3, 5, 7, 11) rad_vdim=%s nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = 1616533425*a^3 - 52492030884*a^2*b + 3174799860*a^2 - 7991480944371*a*b^2 + 114385889574*a*b - 4186665954*a - 4306636585879*b^3 - 2003673063630*b^2 + 22964128380*b - 11207025;
poly f1 = 4849600275*a^2*c - 52492030884*a^2*d + 8365497264*a^2 - 104984061768*a*b*c - 15982961888742*a*b*d - 381707592480*a*b + 6349599720*a*c + 114385889574*a*d + 86089247370*a - 7991480944371*b^2*c - 12919909757637*b^2*d + 15794069625198*b^2 + 114385889574*b*c - 4007346127260*b*d - 233902864080*b - 4186665954*c + 22964128380*d + 353652480;
poly f2 = 4849600275*a*c^2 - 104984061768*a*c*d + 16730994528*a*c - 7991480944371*a*d^2 - 381707592480*a*d + 539410886460*a - 52492030884*b*c^2 - 15982961888742*b*c*d - 381707592480*b*c - 12919909757637*b*d^2 + 31588139250396*b*d + 19015361114228*b + 3174799860*c^2 + 114385889574*c*d + 86089247370*c - 2003673063630*d^2 - 233902864080*d + 41827200534;
poly f3 = 1616533425*c^3 - 52492030884*c^2*d + 8365497264*c^2 - 7991480944371*c*d^2 - 381707592480*c*d + 539410886460*c - 4306636585879*d^3 + 15794069625198*d^2 + 19015361114228*d + 141717985560;
ideal I=f0,f1,f2,f3;
ideal J=std(I);
print(sprintf("t=(4, 1, 2, 3) dim=%s mult=%s vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad=radical(I); ideal Jr=std(rad);
print(sprintf("t=(4, 1, 2, 3) rad_vdim=%s nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

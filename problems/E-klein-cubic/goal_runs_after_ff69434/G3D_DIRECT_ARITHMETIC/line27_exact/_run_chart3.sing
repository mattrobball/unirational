LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = -313740*a^3 + 21874770*a^2*b + 306720*a^2 - 964748082*a*b^2 - 140691420*a*b + 58347888*a - 128269894*b^3 + 3862922352*b^2 + 11084942338*b + 151303140;
poly f1 = -941220*a^2*c + 21874770*a^2*d - 9925578*a^2 + 43749540*a*b*c - 1929496164*a*b*d + 96849390*a*b + 613440*a*c - 140691420*a*d + 91213740*a - 964748082*b^2*c - 384809682*b^2*d - 2144490363*b^2 - 140691420*b*c + 7725844704*b*d - 168009048*b + 58347888*c + 11084942338*d + 325436040;
poly f2 = -941220*a*c^2 + 43749540*a*c*d - 19851156*a*c - 964748082*a*d^2 + 96849390*a*d + 1354860*a + 21874770*b*c^2 - 1929496164*b*c*d + 96849390*b*c - 384809682*b*d^2 - 4288980726*b*d - 25095798*b + 306720*c^2 - 140691420*c*d + 91213740*c + 3862922352*d^2 - 168009048*d + 595464;
poly f3 = -313740*c^3 + 21874770*c^2*d - 9925578*c^2 - 964748082*c*d^2 + 96849390*c*d + 1354860*c - 128269894*d^3 - 2144490363*d^2 - 25095798*d - 88535;
ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("chart3|dim=%s|mult=%s|vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad = radical(I);
ideal Jr = std(rad);
print(sprintf("chart3|rad_vdim=%s|nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

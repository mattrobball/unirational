LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = -83790*a^3 - 3325131*a^2*b + 220320*a^2 - 221297433*a*b^2 + 24686118*a*b - 5508162*a + 43226161*b^3 - 188797605*b^2 + 7775235*b - 353700;
poly f1 = -251370*a^2*c - 3325131*a^2*d - 445572*a^2 - 6650262*a*b*c - 442594866*a*b*d - 32192370*a*b + 440640*a*c + 24686118*a*d + 37100340*a - 221297433*b^2*c + 129678483*b^2*d + 371697597*b^2 + 24686118*b*c - 377595210*b*d - 30539430*b - 5508162*c + 7775235*d + 102060;
poly f2 = -251370*a*c^2 - 6650262*a*c*d - 891144*a*c - 221297433*a*d^2 - 32192370*a*d + 70960050*a - 3325131*b*c^2 - 442594866*b*c*d - 32192370*b*c + 129678483*b*d^2 + 743395194*b*d + 2403238111*b + 220320*c^2 + 24686118*c*d + 37100340*c - 188797605*d^2 - 30539430*d + 27748512;
poly f3 = -83790*c^3 - 3325131*c^2*d - 445572*c^2 - 221297433*c*d^2 - 32192370*c*d + 70960050*c + 43226161*d^3 + 371697597*d^2 + 2403238111*d + 62104320;
ideal I=f0,f1,f2,f3;
ideal J=std(I);
print(sprintf("t=(1, 1, 1, 1) dim=%s mult=%s vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad=radical(I); ideal Jr=std(rad);
print(sprintf("t=(1, 1, 1, 1) rad_vdim=%s nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

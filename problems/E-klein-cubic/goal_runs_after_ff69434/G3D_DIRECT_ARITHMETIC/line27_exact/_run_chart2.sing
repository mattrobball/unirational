LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = 151303140*a^3 + 325436040*a^2*b + 58347888*a^2 + 595464*a*b^2 + 91213740*a*b + 306720*a - 88535*b^3 + 1354860*b^2 - 9925578*b - 313740;
poly f1 = 453909420*a^2*c + 325436040*a^2*d + 11084942338*a^2 + 650872080*a*b*c + 1190928*a*b*d - 168009048*a*b + 116695776*a*c + 91213740*a*d - 140691420*a + 595464*b^2*c - 265605*b^2*d - 25095798*b^2 + 91213740*b*c + 2709720*b*d + 96849390*b + 306720*c - 9925578*d + 21874770;
poly f2 = 453909420*a*c^2 + 650872080*a*c*d + 22169884676*a*c + 595464*a*d^2 - 168009048*a*d + 3862922352*a + 325436040*b*c^2 + 1190928*b*c*d - 168009048*b*c - 265605*b*d^2 - 50191596*b*d - 2144490363*b + 58347888*c^2 + 91213740*c*d - 140691420*c + 1354860*d^2 + 96849390*d - 964748082;
poly f3 = 151303140*c^3 + 325436040*c^2*d + 11084942338*c^2 + 595464*c*d^2 - 168009048*c*d + 3862922352*c - 88535*d^3 - 25095798*d^2 - 2144490363*d - 128269894;
ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("chart2|dim=%s|mult=%s|vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad = radical(I);
ideal Jr = std(rad);
print(sprintf("chart2|rad_vdim=%s|nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

option(redSB);
ring r0 = 10007, (a,b,c,d), dp;
poly f0 = -88535*a^3 - 25095798*a^2*b + 1354860*a^2 - 2144490363*a*b^2 + 96849390*a*b - 9925578*a - 128269894*b^3 - 964748082*b^2 + 21874770*b - 313740;
poly f1 = -265605*a^2*c - 25095798*a^2*d + 595464*a^2 - 50191596*a*b*c - 4288980726*a*b*d - 168009048*a*b + 2709720*a*c + 96849390*a*d + 91213740*a - 2144490363*b^2*c - 384809682*b^2*d + 3862922352*b^2 + 96849390*b*c - 1929496164*b*d - 140691420*b - 9925578*c + 21874770*d + 306720;
poly f2 = -265605*a*c^2 - 50191596*a*c*d + 1190928*a*c - 2144490363*a*d^2 - 168009048*a*d + 325436040*a - 25095798*b*c^2 - 4288980726*b*c*d - 168009048*b*c - 384809682*b*d^2 + 7725844704*b*d + 11084942338*b + 1354860*c^2 + 96849390*c*d + 91213740*c - 964748082*d^2 - 140691420*d + 58347888;
poly f3 = -88535*c^3 - 25095798*c^2*d + 595464*c^2 - 2144490363*c*d^2 - 168009048*c*d + 325436040*c - 128269894*d^3 + 3862922352*d^2 + 11084942338*d + 151303140;
poly Gcub = -313740*y1^3 + 306720*y1^2*y2 - 9925578*y1^2*y3 + 21874770*y1^2*y4 + 58347888*y1*y2^2 + 91213740*y1*y2*y3 - 140691420*y1*y2*y4 + 1354860*y1*y3^2 + 96849390*y1*y3*y4 - 964748082*y1*y4^2 + 151303140*y2^3 + 325436040*y2^2*y3 + 11084942338*y2^2*y4 + 595464*y2*y3^2 - 168009048*y2*y3*y4 + 3862922352*y2*y4^2 - 88535*y3^3 - 25095798*y3^2*y4 - 2144490363*y3*y4^2 - 128269894*y4^3;

ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("Fp dim=%s vdim=%s", string(dim(J)), string(vdim(J))));
ring rlex = 10007, (a,b,c,d), lp;
ideal Ilex = fetch(r0, I);
ideal Glex = std(Ilex);
poly m = Glex[1]/leadcoef(Glex[1]);
list fm = factorize(m);
int nlin=0;
poly lin0;
for (int k=1; k<=size(fm[1]); k++) {
  if (deg(fm[1][k])==1) {
    nlin=nlin+1;
    if (nlin==1) { lin0 = fm[1][k]/leadcoef(fm[1][k]); }
  }
}
print(sprintf("n_linear_factors=%s", string(nlin)));
if (nlin>0) {
  // lin0 = d - r  (monic), r = -subst(lin0,d,0) as poly constant
  poly rdpoly = -subst(lin0, d, 0);
  poly pa = subst(Glex[4], d, rdpoly); pa = pa/leadcoef(pa);
  poly pb = subst(Glex[3], d, rdpoly); pb = pb/leadcoef(pb);
  poly pc = subst(Glex[2], d, rdpoly); pc = pc/leadcoef(pc);
  poly a0p = -subst(pa, a, 0);
  poly b0p = -subst(pb, b, 0);
  poly c0p = -subst(pc, c, 0);
  print(sprintf("point a=%s b=%s c=%s d=%s", string(a0p), string(b0p), string(c0p), string(rdpoly)));
  setring r0;
  poly aa = imap(rlex, a0p);
  poly bb = imap(rlex, b0p);
  poly cc = imap(rlex, c0p);
  poly dd = imap(rlex, rdpoly);
  poly e0 = subst(subst(subst(subst(f0,a,aa),b,bb),c,cc),d,dd);
  poly e1 = subst(subst(subst(subst(f1,a,aa),b,bb),c,cc),d,dd);
  poly e2 = subst(subst(subst(subst(f2,a,aa),b,bb),c,cc),d,dd);
  poly e3 = subst(subst(subst(subst(f3,a,aa),b,bb),c,cc),d,dd);
  print(sprintf("chart_eqs %s %s %s %s", string(e0), string(e1), string(e2), string(e3)));
  // Line: y1=s, y2=t, y3=a*s+c*t, y4=b*s+d*t  (chart pivots 0,1)
  // Check G at several (s:t)
  poly Gcheck;
  int ok=1;
  list stlist = list(list(1,0), list(0,1), list(1,1), list(1,2), list(2,1), list(3,5));
  for (int i=1; i<=size(stlist); i++) {
    poly ss = stlist[i][1];
    poly tt = stlist[i][2];
    poly y1 = ss;
    poly y2 = tt;
    poly y3 = aa*ss + cc*tt;
    poly y4 = bb*ss + dd*tt;
    Gcheck = subst(subst(subst(subst(Gcub,y1,y1),y2,y2),y3,y3),y4,y4);
    // careful: subst name collision - use different approach
  }
  // manual evaluation
  for (int i=1; i<=size(stlist); i++) {
    number ss = stlist[i][1];
    number tt = stlist[i][2];
    number yy1 = ss;
    number yy2 = tt;
    number yy3 = number(aa)*ss + number(cc)*tt;
    number yy4 = number(bb)*ss + number(dd)*tt;
    poly Ge = subst(subst(subst(subst(Gcub, y1, yy1), y2, yy2), y3, yy3), y4, yy4);
    if (Ge != 0) { ok=0; print(sprintf("FAIL at s=%s t=%s G=%s", string(ss), string(tt), string(Ge))); }
  }
  print(sprintf("line_on_cubic_ok=%s", string(ok)));
}
print("done");

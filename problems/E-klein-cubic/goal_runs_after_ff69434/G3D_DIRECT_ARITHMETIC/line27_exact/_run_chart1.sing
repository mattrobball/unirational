LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = 151303140*a^3 + 11084942338*a^2*b + 58347888*a^2 + 3862922352*a*b^2 - 140691420*a*b + 306720*a - 128269894*b^3 - 964748082*b^2 + 21874770*b - 313740;
poly f1 = 453909420*a^2*c + 11084942338*a^2*d + 325436040*a^2 + 22169884676*a*b*c + 7725844704*a*b*d - 168009048*a*b + 116695776*a*c - 140691420*a*d + 91213740*a + 3862922352*b^2*c - 384809682*b^2*d - 2144490363*b^2 - 140691420*b*c - 1929496164*b*d + 96849390*b + 306720*c + 21874770*d - 9925578;
poly f2 = 453909420*a*c^2 + 22169884676*a*c*d + 650872080*a*c + 3862922352*a*d^2 - 168009048*a*d + 595464*a + 11084942338*b*c^2 + 7725844704*b*c*d - 168009048*b*c - 384809682*b*d^2 - 4288980726*b*d - 25095798*b + 58347888*c^2 - 140691420*c*d + 91213740*c - 964748082*d^2 + 96849390*d + 1354860;
poly f3 = 151303140*c^3 + 11084942338*c^2*d + 325436040*c^2 + 3862922352*c*d^2 - 168009048*c*d + 595464*c - 128269894*d^3 - 2144490363*d^2 - 25095798*d - 88535;
ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("chart1|dim=%s|mult=%s|vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad = radical(I);
ideal Jr = std(rad);
print(sprintf("chart1|rad_vdim=%s|nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

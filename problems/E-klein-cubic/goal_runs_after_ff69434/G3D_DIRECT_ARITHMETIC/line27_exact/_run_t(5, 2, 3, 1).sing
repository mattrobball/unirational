poly f3 = 446215510890*c^3 - 12393434012580*c^2*d + 1615103497800*c^2 - 1885491005230500*c*d^2 - 70460108477100*c*d + 102671297069400*c - 1469708782370615*d^3 + 3767443376882004*d^2 + 3604378214117510*d + 21389195137500;

LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = 446215510890*a^3 - 12393434012580*a^2*b + 605095505280*a^2 - 1885491005230500*a*b^2 + 21588483823380*a*b - 629789076180*a - 1469708782370615*b^3 - 384545063656650*b^2 + 4232287870650*b - 1751509440;

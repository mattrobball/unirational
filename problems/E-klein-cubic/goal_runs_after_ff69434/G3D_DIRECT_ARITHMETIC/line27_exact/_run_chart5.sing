LIB "primdec.lib";
option(redSB);
ring r = 0, (a,b,c,d), dp;
poly f0 = -313740*a^3 + 306720*a^2*b - 9925578*a^2 + 58347888*a*b^2 + 91213740*a*b + 1354860*a + 151303140*b^3 + 325436040*b^2 + 595464*b - 88535;
poly f1 = -941220*a^2*c + 306720*a^2*d + 21874770*a^2 + 613440*a*b*c + 116695776*a*b*d - 140691420*a*b - 19851156*a*c + 91213740*a*d + 96849390*a + 58347888*b^2*c + 453909420*b^2*d + 11084942338*b^2 + 91213740*b*c + 650872080*b*d - 168009048*b + 1354860*c + 595464*d - 25095798;
poly f2 = -941220*a*c^2 + 613440*a*c*d + 43749540*a*c + 58347888*a*d^2 - 140691420*a*d - 964748082*a + 306720*b*c^2 + 116695776*b*c*d - 140691420*b*c + 453909420*b*d^2 + 22169884676*b*d + 3862922352*b - 9925578*c^2 + 91213740*c*d + 96849390*c + 325436040*d^2 - 168009048*d - 2144490363;
poly f3 = -313740*c^3 + 306720*c^2*d + 21874770*c^2 + 58347888*c*d^2 - 140691420*c*d - 964748082*c + 151303140*d^3 + 11084942338*d^2 + 3862922352*d - 128269894;
ideal I = f0,f1,f2,f3;
ideal J = std(I);
print(sprintf("chart5|dim=%s|mult=%s|vdim=%s", string(dim(J)), string(mult(J)), string(vdim(J))));
ideal rad = radical(I);
ideal Jr = std(rad);
print(sprintf("chart5|rad_vdim=%s|nprim=%s", string(vdim(Jr)), string(size(primdecGTZ(I)))));

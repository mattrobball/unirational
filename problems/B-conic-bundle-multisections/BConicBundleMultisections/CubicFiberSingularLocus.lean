/-!
# Projective elimination on points: the locus of a nontrivial common zero is closed

Input (i) of the split of obligation 1 (`ResidualYNonvanishing.lean`): the parameters over which the
plane cubic fibre is singular form a Zariski-closed subset.  This module proves the general fact it
is an instance of, over an algebraically closed field:

> for a finite family of forms whose coefficients lie in a commutative ring `A`, the set of points
> of `A` at which the forms acquire a common nonzero zero is cut out by a set `S ⊆ A`.

`exists_defining_set_forms_no_common_zero` below.  Points are ring homomorphisms `φ : A →+* k`; for
`A = k[x₀, x₁, x₂]` and `φ = eval x` this is the statement wanted, and `S` is the set of
certificates.

## The proof avoids scheme theory

The textbook route is properness: `Z = {(x, [r]) : f_i(x, r) = 0} ⊆ 𝔸ⁿ × ℙᵐ` is closed and `ℙᵐ` is
complete, so the image of `Z` in `𝔸ⁿ` is closed.  Mathlib has the properness input
(`Proj.toSpecZero` is `UniversallyClosed`), but not the bridge: building `Z` as a closed subscheme
of a relative `Proj`, computing the fibres of `Proj (A[r]/J) → Spec A`, and converting a closed
subset of `Spec A` back into a condition on `k`-points all have to be written from scratch.

The classical *elimination-theoretic* proof needs none of that, and is what is formalised here.  For
each `N` consider the `k`-linear map

```
⨁_i k[r]_{N - dᵢ} → k[r]_N ,        (gᵢ) ↦ Σ gᵢ fᵢ(x)
```

whose matrix in the monomial bases has entries *polynomial in the parameter*.  Then

* if some maximal minor is nonzero at `x`, the map is onto, so every monomial of degree `N` lies in
  the ideal generated by the `fᵢ(x)`, and a common zero `r` would force `r_j^N = 0` for every `j`;
* conversely, if the `fᵢ(x)` have no common nonzero zero, the Nullstellensatz gives `X_j^{M_j}` in
  their ideal, hence every monomial of large enough degree, hence surjectivity, hence a nonzero
  maximal minor.

So `S` := all maximal minors of all these matrices, and the two directions above are exactly the two
directions of the required equivalence.  The only nonelementary input is Mathlib's Nullstellensatz
`MvPolynomial.vanishingIdeal_zeroLocus_eq_radical`; algebraic closure is used there and nowhere
else.

The equivalence is genuinely an *iff*, which is what the consumer needs: `V(S)` is the singular
locus exactly, not merely a closed set containing it.  See the docstring of
`exists_defining_set_nonsingularCubicFiber` for why one-sided information would not compose.
-/

@[expose] public section

namespace BConicBundleMultisections

noncomputable section

open MvPolynomial

universe u v w

/-! ### A determinant criterion for spanning

A finite family of vectors in `k^D` spans if and only if some `D`-indexed choice from the family has
nonzero determinant.  This is the only linear algebra used, and it is where the *certificates* come
from: the determinant is a polynomial in the entries, so a choice witnessing spanning at one point
is a polynomial witnessing spanning near it. -/

theorem span_eq_top_iff_exists_det_ne_zero {k : Type u} [Field k] {D : Type v} {J : Type w}
    [Fintype D] [DecidableEq D] (v : J → D → k) :
    Submodule.span k (Set.range v) = ⊤ ↔
      ∃ c : D → J, (Matrix.of fun i j => v (c j) i).det ≠ 0 := by
  classical
  have hmat : ∀ c : D → J,
      (Pi.basisFun k D).toMatrix (fun j => v (c j)) = Matrix.of fun i j => v (c j) i := by
    intro c
    ext i j
    simp [Module.Basis.toMatrix]
  have hbasis : ∀ c : D → J,
      (Pi.basisFun k D).det (fun j => v (c j)) = (Matrix.of fun i j => v (c j) i).det := by
    intro c
    rw [Module.Basis.det_apply, hmat]
  constructor
  · intro hspan
    obtain ⟨κ, a, -, ha_span, ha_li⟩ := exists_linearIndependent' k v
    have hsp : Submodule.span k (Set.range (v ∘ a)) = ⊤ := by rw [ha_span, hspan]
    let b : Module.Basis κ k (D → k) := Module.Basis.mk ha_li hsp.ge
    haveI : Finite κ := Module.Finite.finite_basis b
    haveI : Fintype κ := Fintype.ofFinite κ
    have hcard : Fintype.card D = Fintype.card κ := by
      rw [← Module.finrank_fintype_fun_eq_card k (η := D), Module.finrank_eq_card_basis b]
    let e : D ≃ κ := Fintype.equivOfCardEq hcard
    refine ⟨a ∘ e, ?_⟩
    rw [← hbasis]
    have hli' : LinearIndependent k (fun i : D => v ((a ∘ e) i)) :=
      ha_li.comp e e.injective
    have hsp' : Submodule.span k (Set.range fun i : D => v ((a ∘ e) i)) = ⊤ := by
      have hrange : (Set.range fun i : D => v ((a ∘ e) i)) = Set.range (v ∘ a) := by
        rw [show (fun i : D => v ((a ∘ e) i)) = (v ∘ a) ∘ (e : D → κ) from rfl, Set.range_comp,
          Set.range_eq_univ.mpr e.surjective, Set.image_univ]
      rw [hrange, hsp]
    exact fun h => ((Module.Basis.is_basis_iff_det _).mp ⟨hli', hsp'⟩).ne_zero h
  · rintro ⟨c, hc⟩
    rw [← hbasis] at hc
    have hunit : IsUnit ((Pi.basisFun k D).det fun j => v (c j)) := (isUnit_iff_ne_zero).mpr hc
    obtain ⟨-, hsp⟩ := (Module.Basis.is_basis_iff_det _).mpr hunit
    refine le_antisymm le_top ?_
    rw [← hsp]
    exact Submodule.span_mono (by rintro _ ⟨j, rfl⟩; exact ⟨c j, rfl⟩)

/-! ### The spanning family in a fixed degree

For each degree `N`, the products `ν · fᵢ` with `deg ν = N - dᵢ` span the degree-`N` part of the
ideal generated by the `fᵢ`.  Their coefficient vectors at the degree-`N` monomials are the columns
of the matrix whose minors are the certificates. -/

section Family

variable {k : Type u} [Field k] {A : Type w} [CommRing A]
variable {σ : Type v} [Fintype σ] [DecidableEq σ] {m : ℕ}

/-- The monomials of degree `N` in the variables `σ`. -/
def monomsOfDeg (σ : Type v) [Fintype σ] [DecidableEq σ] (N : ℕ) : Finset (σ →₀ ℕ) :=
  Finset.finsuppAntidiag Finset.univ N

theorem mem_monomsOfDeg {N : ℕ} {μ : σ →₀ ℕ} : μ ∈ monomsOfDeg σ N ↔ μ.degree = N := by
  rw [monomsOfDeg, Finset.mem_finsuppAntidiag]
  constructor
  · rintro ⟨h, -⟩
    rw [Finsupp.degree_eq_sum]
    exact h
  · intro h
    exact ⟨by rw [← Finsupp.degree_eq_sum]; exact h, Finset.subset_univ _⟩

/-- Index of the spanning family in degree `N`: a form together with a monomial multiplier of the
complementary degree. -/
abbrev famIndex (σ : Type v) [Fintype σ] [DecidableEq σ] (d : Fin m → ℕ) (N : ℕ) : Type v :=
  Σ i : Fin m, {ν : σ →₀ ℕ // ν ∈ monomsOfDeg σ (N - d i)}

/-- The member `ν · fᵢ` of the spanning family. -/
def famPoly (f : Fin m → MvPolynomial σ A) (d : Fin m → ℕ) (N : ℕ) (p : famIndex σ d N) :
    MvPolynomial σ A :=
  monomial p.2.1 1 * f p.1

/-- The coordinate vector of a family member: its coefficients at the degree-`N` monomials. -/
def famVec (g : Fin m → MvPolynomial σ k) (d : Fin m → ℕ) (N : ℕ) (p : famIndex σ d N) :
    monomsOfDeg σ N → k :=
  fun μ => coeff μ.1 (famPoly g d N p)

/-- The square matrix cut out of the family by a selection `c` of one member per degree-`N`
monomial.  Its determinant is a certificate. -/
def famMatrix (f : Fin m → MvPolynomial σ A) (d : Fin m → ℕ) (N : ℕ)
    (c : monomsOfDeg σ N → famIndex σ d N) :
    Matrix (monomsOfDeg σ N) (monomsOfDeg σ N) A :=
  Matrix.of fun μ ν => coeff μ.1 (famPoly f d N (c ν))

/-- **The certificate set**: all maximal minors, over all degrees and all selections. -/
def elimCertificates (f : Fin m → MvPolynomial σ A) (d : Fin m → ℕ) : Set A :=
  {Δ | ∃ N : ℕ, (∀ i, d i ≤ N) ∧
    ∃ c : monomsOfDeg σ N → famIndex σ d N, Δ = (famMatrix f d N c).det}

theorem famPoly_isHomogeneous {g : Fin m → MvPolynomial σ A} {d : Fin m → ℕ} {N : ℕ}
    (hg : ∀ i, (g i).IsHomogeneous (d i)) (hdN : ∀ i, d i ≤ N) (p : famIndex σ d N) :
    (famPoly g d N p).IsHomogeneous N := by
  have h1 : (monomial p.2.1 (1 : A)).IsHomogeneous (N - d p.1) :=
    isHomogeneous_monomial _ (mem_monomsOfDeg.mp p.2.2)
  have h2 := h1.mul (hg p.1)
  rwa [Nat.sub_add_cancel (hdN p.1)] at h2

/-- A homogeneous polynomial of degree `N` is determined by its coefficients at the degree-`N`
monomials. -/
theorem eq_of_isHomogeneous_of_coeff_eq {p q : MvPolynomial σ A} {N : ℕ}
    (hp : p.IsHomogeneous N) (hq : q.IsHomogeneous N)
    (h : ∀ μ ∈ monomsOfDeg σ N, coeff μ p = coeff μ q) : p = q := by
  ext μ
  by_cases hμ : μ.degree = N
  · exact h μ (mem_monomsOfDeg.mpr hμ)
  · rw [hp.coeff_eq_zero hμ, hq.coeff_eq_zero hμ]

omit [Fintype σ] [DecidableEq σ] in
/-- Multiplying by a form of degree `e` only sees the degree-`(N - e)` part of the other factor, as
far as degree-`N` coefficients are concerned. -/
theorem coeff_mul_eq_coeff_homogeneousComponent_mul {G c : MvPolynomial σ A} {e N : ℕ}
    (hG : G.IsHomogeneous e) (he : e ≤ N) {τ : σ →₀ ℕ} (hτ : τ.degree = N) :
    coeff τ (c * G) = coeff τ (homogeneousComponent (N - e) c * G) := by
  classical
  rw [coeff_mul, coeff_mul]
  refine Finset.sum_congr rfl fun x hx => ?_
  rw [Finset.mem_antidiagonal] at hx
  by_cases hb : x.2.degree = e
  · have hsum : x.1.degree + x.2.degree = N := by
      rw [← map_add, hx, hτ]
    have hx1 : x.1.degree = N - e := by omega
    rw [coeff_homogeneousComponent, if_pos hx1]
  · rw [hG.coeff_eq_zero hb, mul_zero, mul_zero]

/-- The degree-`e` part of `c`, times a form, expanded over the degree-`e` monomials. -/
theorem homogeneousComponent_mul_eq_sum {G c : MvPolynomial σ A} {e : ℕ} :
    homogeneousComponent e c * G
      = ∑ ν ∈ monomsOfDeg σ e, (coeff ν c) • (monomial ν 1 * G) := by
  classical
  have hexp : homogeneousComponent e c = ∑ ν ∈ monomsOfDeg σ e, monomial ν (coeff ν c) := by
    rw [homogeneousComponent_apply]
    refine Finset.sum_subset (fun ν hν => ?_) (fun ν hν hν' => ?_)
    · exact mem_monomsOfDeg.mpr (Finset.mem_filter.mp hν).2
    · have hc0 : coeff ν c = 0 := by
        by_contra hne
        exact hν' (Finset.mem_filter.mpr ⟨mem_support_iff.mpr hne, mem_monomsOfDeg.mp hν⟩)
      rw [hc0, monomial_zero]
  rw [hexp, Finset.sum_mul]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [← smul_mul_assoc, smul_monomial, smul_eq_mul, mul_one]

/-- **The coefficient vectors of the family compute the coefficients of an ideal element.**

If `Σᵢ cᵢ gᵢ` is any element of the ideal, its degree-`N` coefficient vector is the combination of
the family vectors with coefficients the relevant coefficients of the `cᵢ`.  This is what turns
ideal membership into membership in the span of the family. -/
theorem sum_smul_famVec {g : Fin m → MvPolynomial σ k} {d : Fin m → ℕ} {N : ℕ}
    (hg : ∀ i, (g i).IsHomogeneous (d i)) (hdN : ∀ i, d i ≤ N)
    (c : Fin m → MvPolynomial σ k) :
    (∑ p : famIndex σ d N, (coeff p.2.1 (c p.1)) • famVec g d N p)
      = fun τ : monomsOfDeg σ N => coeff τ.1 (∑ i, c i * g i) := by
  classical
  funext τ
  have hτ : τ.1.degree = N := mem_monomsOfDeg.mp τ.2
  rw [Finset.sum_apply]
  calc ∑ p : famIndex σ d N, ((coeff p.2.1 (c p.1)) • famVec g d N p) τ
      = ∑ i : Fin m, ∑ ν : {ν : σ →₀ ℕ // ν ∈ monomsOfDeg σ (N - d i)},
          (coeff ν.1 (c i)) * coeff τ.1 (monomial ν.1 1 * g i) := by
        rw [Fintype.sum_sigma]
        rfl
    _ = ∑ i : Fin m, coeff τ.1 (∑ ν ∈ monomsOfDeg σ (N - d i),
          (coeff ν (c i)) • (monomial ν 1 * g i)) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [coeff_sum, ← Finset.sum_attach (monomsOfDeg σ (N - d i))
          (fun ν => coeff τ.1 ((coeff ν (c i)) • (monomial ν 1 * g i)))]
        exact Finset.sum_congr rfl fun ν _ => by rw [coeff_smul, smul_eq_mul]
    _ = ∑ i : Fin m, coeff τ.1 (c i * g i) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← homogeneousComponent_mul_eq_sum,
          ← coeff_mul_eq_coeff_homogeneousComponent_mul (hg i) (hdN i) hτ]
    _ = coeff τ.1 (∑ i, c i * g i) := by rw [coeff_sum]

/-! ### The two directions -/

/-- **A nonzero certificate forces the absence of a nontrivial common zero.**

If some maximal minor is nonzero, the family spans the degree-`N` part, so every degree-`N` monomial
lies in the ideal generated by the forms; a common zero `r` would then satisfy `r_j^N = 0` for every
`j`, forcing `r = 0`.  Neither algebraic closure nor the Nullstellensatz is used here. -/
theorem forall_ne_zero_of_det_ne_zero {g : Fin m → MvPolynomial σ k} {d : Fin m → ℕ}
    (hg : ∀ i, (g i).IsHomogeneous (d i)) {N : ℕ} (hdN : ∀ i, d i ≤ N)
    {c : monomsOfDeg σ N → famIndex σ d N} (hdet : (famMatrix g d N c).det ≠ 0) :
    ∀ r : σ → k, r ≠ 0 → ∃ i, eval r (g i) ≠ 0 := by
  classical
  intro r hr
  by_contra hcon
  push Not at hcon
  obtain ⟨j, hj⟩ : ∃ j, r j ≠ 0 := by
    by_contra hall
    push Not at hall
    exact hr (funext hall)
  have hspan : Submodule.span k (Set.range (famVec g d N)) = ⊤ :=
    (span_eq_top_iff_exists_det_ne_zero (famVec g d N)).mpr ⟨c, hdet⟩
  have hμ₀ : (Finsupp.single j N) ∈ monomsOfDeg σ N :=
    mem_monomsOfDeg.mpr (Finsupp.degree_single j N)
  have hmem : (Pi.single (⟨_, hμ₀⟩ : monomsOfDeg σ N) (1 : k))
      ∈ Submodule.span k (Set.range (famVec g d N)) := by
    rw [hspan]; trivial
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp hmem
  set h : MvPolynomial σ k := ∑ p : famIndex σ d N, a p • famPoly g d N p with hh
  have hhom : h.IsHomogeneous N := by
    refine IsHomogeneous.sum _ _ _ fun p _ => ?_
    rw [smul_eq_C_mul]
    simpa using (isHomogeneous_C σ (a p)).mul (famPoly_isHomogeneous hg hdN p)
  have hcoeff : ∀ μ ∈ monomsOfDeg σ N,
      coeff μ h = coeff μ (monomial (Finsupp.single j N) (1 : k)) := by
    intro μ hμ
    have h1 : coeff μ h = ∑ p : famIndex σ d N, a p * coeff μ (famPoly g d N p) := by
      rw [hh, coeff_sum]
      exact Finset.sum_congr rfl fun p _ => by rw [coeff_smul, smul_eq_mul]
    have h2 := congrFun ha ⟨μ, hμ⟩
    rw [Finset.sum_apply] at h2
    rw [h1, show (∑ p : famIndex σ d N, a p * coeff μ (famPoly g d N p))
      = ∑ p : famIndex σ d N, (a p • famVec g d N p) ⟨μ, hμ⟩ from
        Finset.sum_congr rfl fun p _ => by rw [Pi.smul_apply, famVec, smul_eq_mul], h2,
      coeff_monomial, Pi.single_apply]
    by_cases hcase : μ = Finsupp.single j N
    · subst hcase; simp
    · rw [if_neg fun hh' => hcase (Subtype.ext_iff.mp hh'), if_neg fun hh' => hcase hh'.symm]
  have heq : h = monomial (Finsupp.single j N) (1 : k) :=
    eq_of_isHomogeneous_of_coeff_eq hhom
      (isHomogeneous_monomial _ (Finsupp.degree_single j N)) hcoeff
  have hev : eval r h = 0 := by
    rw [hh, map_sum]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [smul_eq_C_mul, famPoly, map_mul, map_mul, hcon p.1, mul_zero, mul_zero]
  have hprod : (Finsupp.single j N).prod (fun n e => r n ^ e) = r j ^ N :=
    Finsupp.prod_single_index (by simp)
  rw [heq, eval_monomial, hprod, one_mul] at hev
  exact pow_ne_zero N hj hev

/-- **No nontrivial common zero produces a nonzero certificate.**

The Nullstellensatz puts a power of each variable in the ideal, hence every monomial of large enough
degree; so the family spans the degree-`N` part and some maximal minor is nonzero.  This is the only
place where algebraic closure is used. -/
theorem exists_det_ne_zero_of_forall_ne_zero [IsAlgClosed k] [Nonempty σ]
    {g : Fin m → MvPolynomial σ k} {d : Fin m → ℕ} (hg : ∀ i, (g i).IsHomogeneous (d i))
    (hns : ∀ r : σ → k, r ≠ 0 → ∃ i, eval r (g i) ≠ 0) :
    ∃ N : ℕ, (∀ i, d i ≤ N) ∧
      ∃ c : monomsOfDeg σ N → famIndex σ d N, (famMatrix g d N c).det ≠ 0 := by
  classical
  set I : Ideal (MvPolynomial σ k) := Ideal.span (Set.range g) with hI
  -- Only the origin is a common zero, so by the Nullstellensatz every variable is in the radical.
  have hzl : MvPolynomial.zeroLocus k I ⊆ {0} := by
    intro x hx
    by_contra hx0
    obtain ⟨i, hi⟩ := hns x (by simpa using hx0)
    exact hi (by simpa using hx (g i) (Ideal.subset_span ⟨i, rfl⟩))
  have hrad : ∀ j : σ, ∃ M : ℕ, (X j : MvPolynomial σ k) ^ (M + 1) ∈ I := by
    intro j
    have hvan : MvPolynomial.vanishingIdeal k ({0} : Set (σ → k)) ≤ I.radical := by
      rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := k) I]
      exact MvPolynomial.vanishingIdeal_anti_mono hzl
    have hXj : (X j : MvPolynomial σ k) ∈ I.radical := by
      refine hvan ?_
      rw [MvPolynomial.mem_vanishingIdeal_iff]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      simp
    obtain ⟨M, hM⟩ := Ideal.mem_radical_iff.mp hXj
    exact ⟨M, by rw [pow_succ]; exact Ideal.mul_mem_right _ _ hM⟩
  choose M hM using hrad
  refine ⟨(∑ j, (M j + 1)) + ∑ i, d i, fun i => le_add_self.trans' ?_, ?_⟩
  · exact Finset.single_le_sum (f := d) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
  set N := (∑ j, (M j + 1)) + ∑ i, d i with hN
  have hdN : ∀ i, d i ≤ N := fun i =>
    le_add_self.trans'
      (Finset.single_le_sum (f := d) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i))
  -- Every monomial of degree `N` lies in the ideal.
  have hmono : ∀ μ : σ →₀ ℕ, μ.degree = N → monomial μ (1 : k) ∈ I := by
    intro μ hμ
    obtain ⟨j, hj⟩ : ∃ j, M j + 1 ≤ μ j := by
      by_contra hall
      push Not at hall
      have h1 : μ.degree ≤ ∑ j, M j := by
        rw [Finsupp.degree_eq_sum]
        exact Finset.sum_le_sum fun j _ => Nat.lt_succ_iff.mp (hall j)
      have h2 : ∑ j, M j < ∑ j, (M j + 1) :=
        Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun j _ => Nat.lt_succ_self _
      omega
    have hle : Finsupp.single j (M j + 1) ≤ μ := by
      rw [Finsupp.le_def]
      intro a
      by_cases hab : a = j
      · subst hab; simpa using hj
      · simp [hab]
    have hsplit : monomial μ (1 : k)
        = (X j) ^ (M j + 1) * monomial (μ - Finsupp.single j (M j + 1)) 1 := by
      rw [X_pow_eq_monomial, monomial_mul, one_mul, add_tsub_cancel_of_le hle]
    rw [hsplit]
    exact Ideal.mul_mem_right _ _ (hM j)
  -- Hence the family spans, and a nonzero minor exists.
  have hspan : Submodule.span k (Set.range (famVec g d N)) = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← (Pi.basisFun k (monomsOfDeg σ N)).span_eq]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨μ, rfl⟩
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hmono μ.1 (mem_monomsOfDeg.mp μ.2))
    refine SetLike.mem_coe.mpr ((Submodule.mem_span_range_iff_exists_fun k).mpr
      ⟨fun p => coeff p.2.1 (c p.1), ?_⟩)
    rw [sum_smul_famVec hg hdN c, hc]
    funext τ
    rw [Pi.basisFun_apply, coeff_monomial, Pi.single_apply]
    by_cases hcase : μ = τ
    · subst hcase; simp
    · rw [if_neg fun hh' => hcase (Subtype.ext hh'), if_neg fun hh' => hcase hh'.symm]
  obtain ⟨c, hc⟩ := (span_eq_top_iff_exists_det_ne_zero (famVec g d N)).mp hspan
  exact ⟨c, hc⟩

/-! ### Specialisation, and the elimination theorem -/

/-- Specialising the coefficients specialises the matrix. -/
theorem famMatrix_map (f : Fin m → MvPolynomial σ A) (d : Fin m → ℕ) (N : ℕ)
    (c : monomsOfDeg σ N → famIndex σ d N) (φ : A →+* k) :
    (famMatrix f d N c).map φ = famMatrix (fun i => map φ (f i)) d N c := by
  ext μ ν
  simp only [Matrix.map_apply, famMatrix, Matrix.of_apply, famPoly, ← coeff_map, map_mul,
    map_monomial, map_one]

/-- **Projective elimination on points, with explicit certificates.**

The certificates cut out exactly the points at which the forms acquire a nontrivial common zero:
some maximal minor survives at `φ` if and only if the specialised forms have no common zero besides
the origin. -/
theorem elimCertificates_spec [IsAlgClosed k] [Nonempty σ] (f : Fin m → MvPolynomial σ A)
    (d : Fin m → ℕ) (hf : ∀ i, (f i).IsHomogeneous (d i)) (φ : A →+* k) :
    (∃ Δ ∈ elimCertificates f d, φ Δ ≠ 0) ↔
      ∀ r : σ → k, r ≠ 0 → ∃ i, eval r (map φ (f i)) ≠ 0 := by
  have hmapf : ∀ i, (map φ (f i)).IsHomogeneous (d i) := fun i => (hf i).map φ
  constructor
  · rintro ⟨Δ, ⟨N, hdN, c, rfl⟩, hΔ⟩
    refine forall_ne_zero_of_det_ne_zero hmapf hdN (c := c) ?_
    rw [← famMatrix_map]
    rwa [RingHom.map_det, RingHom.mapMatrix_apply] at hΔ
  · intro hns
    obtain ⟨N, hdN, c, hc⟩ := exists_det_ne_zero_of_forall_ne_zero hmapf hns
    refine ⟨(famMatrix f d N c).det, ⟨N, hdN, c, rfl⟩, ?_⟩
    rw [RingHom.map_det, RingHom.mapMatrix_apply, famMatrix_map]
    exact hc

omit [Fintype σ] [DecidableEq σ] in
/-- **Projective elimination on points.**

For a finite family of forms with coefficients in `A`, the points of `A` at which the forms acquire
a nontrivial common zero over an algebraically closed field are cut out by a subset `S ⊆ A`: the
complement of the locus is the union of the basic opens `D(Δ)`, `Δ ∈ S`.

The equivalence is an *iff*, which is what makes this composable: `V(S)` is the bad locus exactly,
not merely a closed set containing it. -/
theorem exists_defining_set_forms_no_common_zero [IsAlgClosed k] [Finite σ] [Nonempty σ]
    (f : Fin m → MvPolynomial σ A) (d : Fin m → ℕ) (hf : ∀ i, (f i).IsHomogeneous (d i)) :
    ∃ S : Set A, ∀ φ : A →+* k,
      ((∃ Δ ∈ S, φ Δ ≠ 0) ↔ ∀ r : σ → k, r ≠ 0 → ∃ i, eval r (map φ (f i)) ≠ 0) := by
  classical
  haveI : Fintype σ := Fintype.ofFinite σ
  exact ⟨elimCertificates f d, elimCertificates_spec f d hf⟩

/-! ### The geometric forms

The base field carries no hypothesis; the points are taken in an algebraically closed extension.
This is forced, not incidental — over `ℝ` the pair `x, y` of forms `x² + y²` has no nonzero real
zero, so the `k`-point form of the equivalence would claim a nonzero certificate where none exists.
The certificates themselves live in `A` and are unchanged: only the field the test points are drawn
from moves. -/

/-- **Geometric form of `elimCertificates_spec`.**  The certificate lives over `A` and the test
points over an algebraically closed extension `L` of the specialisation field `k`. -/
theorem elimCertificates_spec_of_geometric [Nonempty σ]
    {L : Type*} [Field L] [IsAlgClosed L] [Algebra k L]
    (f : Fin m → MvPolynomial σ A)
    (d : Fin m → ℕ) (hf : ∀ i, (f i).IsHomogeneous (d i)) (φ : A →+* k) :
    (∃ Δ ∈ elimCertificates f d, φ Δ ≠ 0) ↔
      ∀ r : σ → L, r ≠ 0 →
        ∃ i, eval r (map ((algebraMap k L).comp φ) (f i)) ≠ 0 := by
  have hbase := elimCertificates_spec (k := L) f d hf ((algebraMap k L).comp φ)
  refine Iff.trans ?_ hbase
  constructor
  · rintro ⟨Δ, hΔmem, hΔ⟩
    exact ⟨Δ, hΔmem, fun h => hΔ ((algebraMap k L).injective (by simpa using h))⟩
  · rintro ⟨Δ, hΔmem, hΔ⟩
    exact ⟨Δ, hΔmem, fun h => hΔ (by simp [RingHom.comp_apply, h])⟩

omit [Fintype σ] [DecidableEq σ] in
/-- **Geometric form of `exists_defining_set_forms_no_common_zero`.** -/
theorem exists_defining_set_forms_no_common_zero_of_geometric [Finite σ] [Nonempty σ]
    {L : Type*} [Field L] [IsAlgClosed L] [Algebra k L]
    (f : Fin m → MvPolynomial σ A) (d : Fin m → ℕ) (hf : ∀ i, (f i).IsHomogeneous (d i)) :
    ∃ S : Set A, ∀ φ : A →+* k,
      ((∃ Δ ∈ S, φ Δ ≠ 0) ↔
        ∀ r : σ → L, r ≠ 0 →
          ∃ i, eval r (map ((algebraMap k L).comp φ) (f i)) ≠ 0) := by
  classical
  haveI : Fintype σ := Fintype.ofFinite σ
  exact ⟨elimCertificates f d, fun φ => elimCertificates_spec_of_geometric f d hf φ⟩

end Family

/-! ### The plane cubic fibre of a bidegree-`(2,3)` equation

Instantiating the elimination theorem at the family `G, ∂₀G, ∂₁G, ∂₂G`, where `G` is the cubic fibre
of `F` read as a form in the second block whose coefficients are polynomials in the first block. -/

section CubicFibre

variable {k : Type u} [Field k]

/-- A change of coefficient ring commutes with first-block specialisation, provided the
specialisation point is transported along the same map.

The tree has this for the affine-plane ring
(`SpecializedConicFreeDir.map_specializeFirstCoordinates`); this is the same induction with the
coefficient rings left general. -/
theorem map_specializeFirstCoordinates_general {m n : ℕ} {R S : Type*} [CommRing R] [CommRing S]
    (x : Fin (m + 1) → R) (φ : R →+* S) (H : MvPolynomial (BiprojectiveCoordinate m n) R) :
    map φ (specializeFirstCoordinates (n := n) x H)
      = specializeFirstCoordinates (n := n) (fun i => φ (x i)) (map φ H) := by
  induction H using MvPolynomial.induction_on with
  | C c => simp [map_C]
  | add f g hf hg => simp [map_add, hf, hg]
  | mul_X f i hf =>
      cases i with
      | inl j => simp [map_mul, map_C, map_X, hf, specializeFirstCoordinates_X_inl]
      | inr j => simp [map_mul, map_X, hf, specializeFirstCoordinates_X_inr]

/-- **The universal cubic fibre**: `F` read as a ternary cubic whose ten coefficients are the
quadratic forms in the first-block coordinates that they are.  Specialising the coefficients at a
point `x` gives the cubic fibre over `x`. -/
def universalCubicFiber (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) :
    MvPolynomial (Fin 3) (MvPolynomial (Fin 3) k) :=
  specializeFirstCoordinates (n := 2) (fun i => X i)
    (map (C : k →+* MvPolynomial (Fin 3) k) F)

theorem map_eval_universalCubicFiber (F : MvPolynomial (BiprojectiveCoordinate 2 2) k)
    (x : Fin 3 → k) :
    map (eval x) (universalCubicFiber F) = specializeFirstCoordinates (n := 2) x F := by
  rw [universalCubicFiber, map_specializeFirstCoordinates_general]
  have hmap : map (eval x) (map (C : k →+* MvPolynomial (Fin 3) k) F) = F := by
    rw [MvPolynomial.map_map]
    have hcomp : (eval x).comp (C : k →+* MvPolynomial (Fin 3) k) = RingHom.id k := by
      ext a; simp
    rw [hcomp, map_id]
  rw [hmap]
  simp

theorem universalCubicFiber_isHomogeneous {F : MvPolynomial (BiprojectiveCoordinate 2 2) k}
    (hF : IsBidegree23 F) : (universalCubicFiber F).IsHomogeneous 3 :=
  (hF.map_coefficients
    (C : k →+* MvPolynomial (Fin 3) k)).specializeFirstCoordinates_isHomogeneous _

/-- The family of four forms whose common nontrivial zeros are the singular points of the fibre:
the fibre itself and its three partial derivatives. -/
def cubicFiberJacobianFamily (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) :
    Fin 4 → MvPolynomial (Fin 3) (MvPolynomial (Fin 3) k) :=
  Fin.cases (universalCubicFiber F) fun i => pderiv i (universalCubicFiber F)

theorem cubicFiberJacobianFamily_isHomogeneous {F : MvPolynomial (BiprojectiveCoordinate 2 2) k}
    (hF : IsBidegree23 F) :
    ∀ j : Fin 4, (cubicFiberJacobianFamily F j).IsHomogeneous (![3, 2, 2, 2] j) := by
  intro j
  refine Fin.cases ?_ (fun i => ?_) j
  · exact universalCubicFiber_isHomogeneous hF
  · have h := (universalCubicFiber_isHomogeneous hF).pderiv (i := i)
    revert h
    simp only [cubicFiberJacobianFamily, Fin.cases_succ]
    intro h
    have hi : (![3, 2, 2, 2] : Fin 4 → ℕ) i.succ = 2 := by fin_cases i <;> rfl
    rw [hi]
    simpa using h

theorem map_eval_cubicFiberJacobianFamily (F : MvPolynomial (BiprojectiveCoordinate 2 2) k)
    (x : Fin 3 → k) :
    (map (eval x) (cubicFiberJacobianFamily F 0)
        = specializeFirstCoordinates (n := 2) x F) ∧
      ∀ i : Fin 3, map (eval x) (cubicFiberJacobianFamily F i.succ)
        = pderiv i (specializeFirstCoordinates (n := 2) x F) := by
  refine ⟨map_eval_universalCubicFiber F x, fun i => ?_⟩
  simp only [cubicFiberJacobianFamily, Fin.cases_succ]
  rw [← pderiv_map, map_eval_universalCubicFiber]

/-! ### The certificates are homogeneous

The Jacobian criterion of `AlgebraicIndependenceJacobian.lean` — which is what turns "the stereo
image is two-dimensional" into "the image meets the nonsingular locus" — applies only to
*homogeneous* forms.  The certificates are: every entry of `famMatrix` is a coefficient of the cubic
fibre, hence a quadratic form in the parameters, so a maximal minor is homogeneous of degree twice
the size of the matrix. -/

/-- **A polynomial whose values scale by `r^d` is homogeneous of degree `d`**, over an infinite
field.  The converse of `eval_smul_point_of_isHomogeneous`, and the cheapest way to read off
homogeneity of the coefficients of the cubic fibre from bihomogeneity of `F`. -/
theorem isHomogeneous_of_eval_smul [Infinite k] {σ' : Type v}
    {p : MvPolynomial σ' k} {d : ℕ}
    (h : ∀ (r : k) (x : σ' → k), eval (fun i => r * x i) p = r ^ d * eval x p) :
    p.IsHomogeneous d := by
  classical
  set N := p.totalDegree with hN
  -- every component other than the `d`-th vanishes
  have hcomp : ∀ n, n ≠ d → homogeneousComponent n p = 0 := by
    intro n hn
    by_cases hnN : n ≤ N
    · refine MvPolynomial.funext fun x => ?_
      -- the two univariate polynomials in the scaling parameter agree at every point
      set P₁ : Polynomial k :=
        ∑ m ∈ Finset.range (N + 1), Polynomial.monomial m (eval x (homogeneousComponent m p))
        with hP₁
      set P₂ : Polynomial k := Polynomial.monomial d (eval x p) with hP₂
      have hev : ∀ r : k, P₁.eval r = P₂.eval r := by
        intro r
        have hexp : eval (fun i => r * x i) p
            = ∑ m ∈ Finset.range (N + 1), r ^ m * eval x (homogeneousComponent m p) := by
          conv_lhs => rw [← sum_homogeneousComponent p]
          rw [map_sum]
          exact Finset.sum_congr rfl fun m _ =>
            eval_smul_point_of_isHomogeneous (homogeneousComponent_isHomogeneous m p) r x
        rw [hP₁, hP₂]
        simp only [Polynomial.eval_finsetSum, Polynomial.eval_monomial]
        calc ∑ m ∈ Finset.range (N + 1), eval x (homogeneousComponent m p) * r ^ m
            = ∑ m ∈ Finset.range (N + 1), r ^ m * eval x (homogeneousComponent m p) :=
              Finset.sum_congr rfl fun m _ => mul_comm _ _
          _ = r ^ d * eval x p := by rw [← hexp]; exact h r x
          _ = eval x p * r ^ d := mul_comm _ _
      have hPeq : P₁ = P₂ := Polynomial.funext hev
      have hc := congrArg (fun q : Polynomial k => q.coeff n) hPeq
      simp only [hP₁, hP₂, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial] at hc
      rw [Finset.sum_eq_single n (fun m _ hm => by simp [hm])
        (fun hmem => absurd (Finset.mem_range.mpr (by omega)) hmem)] at hc
      simpa [Ne.symm hn] using hc
    · exact homogeneousComponent_eq_zero n p (by omega)
  -- so `p` is its `d`-th component
  have hpd : p = homogeneousComponent d p := by
    by_cases hdN : d ≤ N
    · conv_lhs => rw [← sum_homogeneousComponent p]
      refine Finset.sum_eq_single d (fun m _ hm => hcomp m hm) fun hmem => ?_
      exact absurd (Finset.mem_range.mpr (by omega)) hmem
    · have hp0 : p = 0 := by
        conv_lhs => rw [← sum_homogeneousComponent p]
        refine Finset.sum_eq_zero fun m hm => hcomp m ?_
        have hm' := Finset.mem_range.mp hm
        omega
      rw [hp0]
      simp
  rw [hpd]
  exact homogeneousComponent_isHomogeneous d p

/-- **The determinant of a matrix of forms of a fixed degree is a form.** -/
theorem isHomogeneous_det {ι : Type*} [Fintype ι] [DecidableEq ι] {σ' : Type*}
    (M : Matrix ι ι (MvPolynomial σ' k)) (e : ℕ) (h : ∀ i j, (M i j).IsHomogeneous e) :
    M.det.IsHomogeneous (e * Fintype.card ι) := by
  rw [Matrix.det_apply']
  refine IsHomogeneous.sum _ _ _ fun τ _ => ?_
  have hprod : (∏ i, M (τ i) i).IsHomogeneous (e * Fintype.card ι) := by
    have hp := IsHomogeneous.prod Finset.univ (fun i => M (τ i) i) (fun _ => e)
      fun i _ => h _ _
    simpa [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_comm] using hp
  have hsign : ((Equiv.Perm.sign τ : ℤ) : MvPolynomial σ' k)
      = C ((Equiv.Perm.sign τ : ℤ) : k) := (map_intCast (C : k →+* MvPolynomial σ' k) _).symm
  rw [hsign]
  simpa using (isHomogeneous_C σ' ((Equiv.Perm.sign τ : ℤ) : k)).mul hprod

/-- **Each coefficient of the cubic fibre, and of its partial derivatives, is a quadratic form in
the parameters.**

This is bihomogeneity of `F` read through the fibre: the fibre over `r · x` is `r²` times the fibre
over `x`, so each of its coefficients scales by `r²`, and over an infinite field that characterises
a quadratic form (`isHomogeneous_of_eval_smul`).  Differentiating in the second block commutes with
the scaling, so the partials behave the same way. -/
theorem coeff_cubicFiberJacobianFamily_isHomogeneous [Infinite k]
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F)
    (j : Fin 4) (e : Fin 3 →₀ ℕ) :
    (coeff e (cubicFiberJacobianFamily F j)).IsHomogeneous 2 := by
  refine isHomogeneous_of_eval_smul fun r x => ?_
  have hcm : ∀ y : Fin 3 → k, eval y (coeff e (cubicFiberJacobianFamily F j))
      = coeff e (map (eval y) (cubicFiberJacobianFamily F j)) := fun y => (coeff_map _ _ _).symm
  have hsmul : specializeFirstCoordinates (n := 2) (fun i => r * x i) F
      = C (r ^ 2) * specializeFirstCoordinates (n := 2) x F := by
    have h := hF.specializeFirstCoordinates_smul r x
    rwa [show (r • x : Fin 3 → k) = fun i => r * x i from
      funext fun i => by simp [Pi.smul_apply, smul_eq_mul]] at h
  rw [hcm (fun i => r * x i), hcm x]
  obtain ⟨h0, hsucc⟩ := map_eval_cubicFiberJacobianFamily F (fun i => r * x i)
  obtain ⟨h0', hsucc'⟩ := map_eval_cubicFiberJacobianFamily F x
  refine Fin.cases ?_ (fun i => ?_) j
  · rw [h0, h0', hsmul, coeff_C_mul]
  · rw [hsucc i, hsucc' i, hsmul, pderiv_C_mul, coeff_C_mul]

/-! #### Removing `[Infinite k]` from the certificate-homogeneity chain

`isHomogeneous_of_eval_smul` reads homogeneity off a scaling identity checked at every `k`-point,
which needs `k` infinite.  Homogeneity is a statement about the support, so it descends along any
injective change of coefficients, and the scaling identity is available over the algebraic closure
because the whole construction commutes with base change.  So the chain below reaches the same
conclusions over an arbitrary field. -/

/-- **Homogeneity descends along an injective change of coefficients.**  A support statement, so
the first row of the descent table applies: no flatness, no infiniteness. -/
theorem isHomogeneous_of_map_isHomogeneous {R S : Type*} [CommSemiring R] [CommSemiring S]
    {σ' : Type*} (φ : R →+* S) (hφ : Function.Injective φ)
    {p : MvPolynomial σ' R} {d : ℕ} (h : (map φ p).IsHomogeneous d) :
    p.IsHomogeneous d := by
  intro s hs
  refine h ?_
  rw [coeff_map]
  exact fun hz => hs ((map_eq_zero_iff φ hφ).mp hz)

/-- The universal cubic fibre commutes with a change of coefficient field. -/
theorem map_map_universalCubicFiber {K : Type*} [Field K] (φ : k →+* K)
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) :
    map (map φ) (universalCubicFiber F) = universalCubicFiber (map φ F) := by
  rw [universalCubicFiber, map_specializeFirstCoordinates_general]
  have hX : (fun i : Fin 3 =>
      (map φ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) K) (X i))
      = fun i : Fin 3 => (X i : MvPolynomial (Fin 3) K) := by
    funext i; simp
  have hcomp :
      ((map φ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) K).comp
        (C : k →+* MvPolynomial (Fin 3) k))
        = ((C : K →+* MvPolynomial (Fin 3) K).comp φ) :=
    RingHom.ext fun a => by
      rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C]
  have hC : map (map φ) (map (C : k →+* MvPolynomial (Fin 3) k) F)
      = map (C : K →+* MvPolynomial (Fin 3) K) (map φ F) := by
    rw [MvPolynomial.map_map, hcomp, ← MvPolynomial.map_map]
  rw [hX, hC, universalCubicFiber]

/-- The Jacobian family commutes with a change of coefficient field. -/
theorem map_map_cubicFiberJacobianFamily {K : Type*} [Field K] (φ : k →+* K)
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (j : Fin 4) :
    map (map φ) (cubicFiberJacobianFamily F j) = cubicFiberJacobianFamily (map φ F) j := by
  refine Fin.cases ?_ (fun i => ?_) j
  · simpa [cubicFiberJacobianFamily] using map_map_universalCubicFiber φ F
  · simp only [cubicFiberJacobianFamily, Fin.cases_succ]
    rw [← pderiv_map, map_map_universalCubicFiber]

/-- **Each coefficient of the cubic fibre is a quadratic form, over an arbitrary field.**

Same conclusion as `coeff_cubicFiberJacobianFamily_isHomogeneous`, with `[Infinite k]` discharged
over the algebraic closure rather than assumed. -/
theorem coeff_cubicFiberJacobianFamily_isHomogeneous_of_geometric
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F)
    (j : Fin 4) (e : Fin 3 →₀ ℕ) :
    (coeff e (cubicFiberJacobianFamily F j)).IsHomogeneous 2 := by
  classical
  set φ : k →+* AlgebraicClosure k := algebraMap k (AlgebraicClosure k) with hφdef
  refine isHomogeneous_of_map_isHomogeneous φ (algebraMap k _).injective ?_
  have hmapcoeff : map φ (coeff e (cubicFiberJacobianFamily F j))
      = coeff e (cubicFiberJacobianFamily (map φ F) j) := by
    rw [← map_map_cubicFiberJacobianFamily φ F j, coeff_map]
  rw [hmapcoeff]
  exact coeff_cubicFiberJacobianFamily_isHomogeneous (map φ F) (hF.map_coefficients φ) j e

/-- Every entry of the elimination matrix of the cubic-fibre family is a quadratic form, over an
arbitrary field. -/
theorem famMatrix_cubicFiber_isHomogeneous_of_geometric
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F) (N : ℕ)
    (c : monomsOfDeg (Fin 3) N → famIndex (Fin 3) ![3, 2, 2, 2] N)
    (μ ν : monomsOfDeg (Fin 3) N) :
    (famMatrix (cubicFiberJacobianFamily F) ![3, 2, 2, 2] N c μ ν).IsHomogeneous 2 := by
  rw [famMatrix, Matrix.of_apply, famPoly, coeff_monomial_mul']
  split_ifs
  · rw [one_mul]
    exact coeff_cubicFiberJacobianFamily_isHomogeneous_of_geometric F hF _ _
  · exact isHomogeneous_zero _ _ _

/-- **The elimination certificates are homogeneous, over an arbitrary field.** -/
theorem elimCertificates_isHomogeneous_of_geometric
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F)
    {Δ : MvPolynomial (Fin 3) k}
    (hΔ : Δ ∈ elimCertificates (cubicFiberJacobianFamily F) ![3, 2, 2, 2]) :
    ∃ n : ℕ, Δ.IsHomogeneous n := by
  obtain ⟨N, -, c, rfl⟩ := hΔ
  exact ⟨2 * Fintype.card (monomsOfDeg (Fin 3) N),
    isHomogeneous_det _ 2 fun μ ν => famMatrix_cubicFiber_isHomogeneous_of_geometric F hF N c μ ν⟩

/-- Every entry of the elimination matrix of the cubic-fibre family is a quadratic form. -/
theorem famMatrix_cubicFiber_isHomogeneous [Infinite k]
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F) (N : ℕ)
    (c : monomsOfDeg (Fin 3) N → famIndex (Fin 3) ![3, 2, 2, 2] N)
    (μ ν : monomsOfDeg (Fin 3) N) :
    (famMatrix (cubicFiberJacobianFamily F) ![3, 2, 2, 2] N c μ ν).IsHomogeneous 2 := by
  rw [famMatrix, Matrix.of_apply, famPoly, coeff_monomial_mul']
  split_ifs
  · rw [one_mul]
    exact coeff_cubicFiberJacobianFamily_isHomogeneous F hF _ _
  · exact isHomogeneous_zero _ _ _

/-- **The elimination certificates are homogeneous.**

A certificate is a maximal minor of a matrix all of whose entries are quadratic forms in the
parameters, so it is a form of degree twice the size of the matrix.  This is what lets the Jacobian
criterion of `AlgebraicIndependenceJacobian.lean` be applied to a certificate. -/
theorem elimCertificates_isHomogeneous [Infinite k]
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F)
    {Δ : MvPolynomial (Fin 3) k}
    (hΔ : Δ ∈ elimCertificates (cubicFiberJacobianFamily F) ![3, 2, 2, 2]) :
    ∃ n : ℕ, Δ.IsHomogeneous n := by
  obtain ⟨N, -, c, rfl⟩ := hΔ
  exact ⟨2 * Fintype.card (monomsOfDeg (Fin 3) N),
    isHomogeneous_det _ 2 fun μ ν => famMatrix_cubicFiber_isHomogeneous F hF N c μ ν⟩

/-- **The singular cubic fibres of a bidegree-`(2,3)` equation are a Zariski-closed subset of the
first-block affine space.**

This is input (i) of the split of obligation 1; see
`ResidualYNonvanishing.exists_defining_set_nonsingularCubicFiber`, which is this statement written
with the predicate `NonsingularCubicFiber`.

The cubic fibre over `x` is singular exactly when the four forms `G, ∂₀G, ∂₁G, ∂₂G` — whose
coefficients are quadratic forms in `x` — have a common zero other than the origin, so this is
`exists_defining_set_forms_no_common_zero` at that family.  No hypothesis on the characteristic, no
smoothness of the total space, and nothing about the multisection line is used. -/
theorem exists_defining_set_nonsingular_cubicFiber_of_bidegree23 [IsAlgClosed k]
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F) :
    ∃ S : Set (MvPolynomial (Fin 3) k), (∀ Δ ∈ S, ∃ n : ℕ, Δ.IsHomogeneous n) ∧
      ∀ x : Fin 3 → k,
      ((∃ Δ ∈ S, eval x Δ ≠ 0) ↔
        ∀ r : Fin 3 → k, r ≠ 0 → eval r (specializeFirstCoordinates (n := 2) x F) = 0 →
          ∃ i : Fin 3, eval r (pderiv i (specializeFirstCoordinates (n := 2) x F)) ≠ 0) := by
  have hS := elimCertificates_spec (k := k)
    (cubicFiberJacobianFamily F) ![3, 2, 2, 2] (cubicFiberJacobianFamily_isHomogeneous hF)
  refine ⟨elimCertificates (cubicFiberJacobianFamily F) ![3, 2, 2, 2],
    fun Δ hΔ => elimCertificates_isHomogeneous F hF hΔ, fun x => ?_⟩
  obtain ⟨h0, hsucc⟩ := map_eval_cubicFiberJacobianFamily F x
  rw [hS (eval x)]
  constructor
  · intro hall r hr hG
    obtain ⟨j, hj⟩ := hall r hr
    revert hj
    refine Fin.cases (fun hj0 => ?_) (fun i hji => ?_) j
    · rw [h0] at hj0
      exact absurd hG hj0
    · exact ⟨i, by rwa [hsucc i] at hji⟩
  · intro hns r hr
    by_cases hG : eval r (specializeFirstCoordinates (n := 2) x F) = 0
    · obtain ⟨i, hi⟩ := hns r hr hG
      exact ⟨i.succ, by rw [hsucc i]; exact hi⟩
    · exact ⟨0, by rw [h0]; exact hG⟩

/-- **Geometric form: the cubic fibres that are singular over an algebraically closed extension
are cut out by the same certificates.**

The certificates are unchanged — they are the maximal minors of the same matrix over
`MvPolynomial (Fin 3) k` — and the parameter `x` still ranges over `k`.  Only the singular points
move to `L`, which is what makes the equivalence true over a base field that is not closed. -/
theorem exists_defining_set_nonsingular_cubicFiber_of_bidegree23_of_geometric
    {L : Type*} [Field L] [IsAlgClosed L] [Algebra k L]
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F) :
    ∃ S : Set (MvPolynomial (Fin 3) k), (∀ Δ ∈ S, ∃ n : ℕ, Δ.IsHomogeneous n) ∧
      ∀ x : Fin 3 → k,
      ((∃ Δ ∈ S, eval x Δ ≠ 0) ↔
        ∀ r : Fin 3 → L, r ≠ 0 →
          eval r (map (algebraMap k L) (specializeFirstCoordinates (n := 2) x F)) = 0 →
            ∃ i : Fin 3,
              eval r (pderiv i
                (map (algebraMap k L) (specializeFirstCoordinates (n := 2) x F))) ≠ 0) := by
  have hS := elimCertificates_spec_of_geometric (k := k) (L := L)
    (cubicFiberJacobianFamily F) ![3, 2, 2, 2] (cubicFiberJacobianFamily_isHomogeneous hF)
  refine ⟨elimCertificates (cubicFiberJacobianFamily F) ![3, 2, 2, 2],
    fun Δ hΔ => elimCertificates_isHomogeneous_of_geometric F hF hΔ, fun x => ?_⟩
  obtain ⟨h0, hsucc⟩ := map_eval_cubicFiberJacobianFamily F x
  have hcomp : ∀ j : Fin 4,
      map ((algebraMap k L).comp (eval x)) (cubicFiberJacobianFamily F j) =
        map (algebraMap k L) (map (eval x) (cubicFiberJacobianFamily F j)) :=
    fun j => (map_map (eval x) (algebraMap k L) (cubicFiberJacobianFamily F j)).symm
  have h0' : map ((algebraMap k L).comp (eval x)) (cubicFiberJacobianFamily F 0) =
      map (algebraMap k L) (specializeFirstCoordinates (n := 2) x F) := by
    rw [hcomp 0, h0]
  have hsucc' : ∀ i : Fin 3,
      map ((algebraMap k L).comp (eval x)) (cubicFiberJacobianFamily F i.succ) =
        pderiv i (map (algebraMap k L) (specializeFirstCoordinates (n := 2) x F)) := by
    intro i
    rw [hcomp i.succ, hsucc i, pderiv_map]
  rw [hS (eval x)]
  constructor
  · intro hall r hr hG
    obtain ⟨j, hj⟩ := hall r hr
    revert hj
    refine Fin.cases (fun hj0 => ?_) (fun i hji => ?_) j
    · rw [h0'] at hj0
      exact absurd hG hj0
    · exact ⟨i, by rwa [hsucc' i] at hji⟩
  · intro hns r hr
    by_cases hG : eval r (map (algebraMap k L) (specializeFirstCoordinates (n := 2) x F)) = 0
    · obtain ⟨i, hi⟩ := hns r hr hG
      exact ⟨i.succ, by rw [hsucc' i]; exact hi⟩
    · exact ⟨0, by rw [h0']; exact hG⟩

end CubicFibre


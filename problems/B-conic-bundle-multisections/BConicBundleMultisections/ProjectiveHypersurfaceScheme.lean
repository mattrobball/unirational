public import BConicBundleMultisections.BiprojectiveAffineChart
public import BConicBundleMultisections.BiprojectiveOverlapScheme
public import BConicBundleMultisections.BiprojectiveSpaceProperties
public import BConicBundleMultisections.ChartHomogenization
public import BConicBundleMultisections.IdealSheafDescent

/-!
# Scheme-theoretic projective hypersurfaces

This file constructs the closed subscheme of `ProjectiveSpace n R` cut out by one homogeneous
polynomial.  The construction descends the principal equations on the standard affine charts.
It also records the affine quotient presentation of every chart and the pullback square relating
each chart to the global closed subscheme.
-/

@[expose] public section

open CategoryTheory Limits
open scoped AlgebraicGeometry

namespace BConicBundleMultisections

noncomputable section

universe u

open AlgebraicGeometry

namespace ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

instance hypersurfaceProjectiveSpaceIsSeparated
    (n : ℕ) (R : Type u) [CommRing R] :
    Scheme.IsSeparated (ProjectiveSpace n R) := by
  letI : IsSeparated (toSpec n R) := by infer_instance
  constructor
  rw [← terminal.comp_from (toSpec n R)]
  infer_instance

instance hypersurfaceStandardChartIsAffineHom
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1)) :
    IsAffineHom (standardChartι n R i) := by
  let f := standardChartι n R i
  constructor
  intro V hV
  rw [← f.isAffineOpen_iff_of_isOpenImmersion,
    f.image_preimage_eq_opensRange_inf]
  exact (isAffineOpen_opensRange f).inf hV

instance hypersurfaceStandardChartQuasiCompact
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1)) :
    QuasiCompact (standardChartι n R i) := by
  infer_instance

/-- The value of a homogeneous polynomial in normalized coordinates on a standard chart. -/
def hypersurfaceChartEquation
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) : StandardChartRing n R i :=
  MvPolynomial.aeval (fun l ↦ normalizedCoordinate n R i l) H

/-- Global sections of the standard chart identify with its homogeneous-localization ring. -/
def hypersurfaceChartΓIso
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1)) :
    Γ(Spec (.of (StandardChartRing n R i)), ⊤) ≅ .of (StandardChartRing n R i) :=
  Scheme.ΓSpecIso (.of (StandardChartRing n R i))

/-- The chart equation as a global section of the affine standard chart. -/
def hypersurfaceChartEquationSection
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    Γ(Spec (.of (StandardChartRing n R i)), ⊤) :=
  (hypersurfaceChartΓIso n R i).inv (hypersurfaceChartEquation n R i H)

@[simp]
theorem hypersurfaceChartΓIso_hom_equationSection
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (hypersurfaceChartΓIso n R i).hom
        (hypersurfaceChartEquationSection n R i H) =
      hypersurfaceChartEquation n R i H := by
  simp [hypersurfaceChartEquationSection]

/-- The principal ideal generated by the chart equation. -/
def hypersurfaceChartIdealTop
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    Ideal Γ(Spec (.of (StandardChartRing n R i)), ⊤) :=
  Ideal.span {hypersurfaceChartEquationSection n R i H}

/-- The corresponding principal ideal sheaf on one standard chart. -/
def hypersurfaceChartIdealSheaf
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (Spec (.of (StandardChartRing n R i))).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (hypersurfaceChartIdealTop n R i H)

@[simp]
theorem hypersurfaceChartIdealSheaf_ideal_top
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (hypersurfaceChartIdealSheaf n R i H).ideal ⟨⊤, isAffineOpen_top _⟩ =
      hypersurfaceChartIdealTop n R i H := by
  simp [hypersurfaceChartIdealSheaf]

/-- The transition coordinate from the `i`-chart to the `i'`-chart. -/
def hypersurfaceTransition
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1)) :
    OverlapRing n R i i' :=
  toOverlap n R i i' (normalizedCoordinate n R i i')

theorem isUnit_hypersurfaceTransition
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1)) :
    IsUnit (hypersurfaceTransition n R i i') :=
  isUnit_toOverlap_normalizedCoordinate n R i i'

private theorem hypersurface_map_aeval_algHom
    {R A S : Type u} [CommSemiring R] [CommSemiring A] [CommSemiring S]
    [Algebra R A] [Algebra R S] (f : A →ₐ[R] S) {n : ℕ}
    (x : Fin (n + 1) → A) (H : MvPolynomial (Fin (n + 1)) R) :
    f (MvPolynomial.aeval x H) =
      MvPolynomial.aeval (fun l ↦ f (x l)) H := by
  change f.toRingHom (MvPolynomial.aeval x H) = _
  rw [MvPolynomial.map_aeval]
  rw [show f.toRingHom.comp (algebraMap R A) = algebraMap R S by
    ext r
    exact f.commutes r]
  rfl

/-- Homogeneous chart equations differ by a power of the transition unit. -/
theorem hypersurfaceChartEquation_overlap
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1))
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d) :
    toOverlap n R i i' (hypersurfaceChartEquation n R i H) =
      hypersurfaceTransition n R i i' ^ d *
        fromOtherToOverlap n R i i' (hypersurfaceChartEquation n R i' H) := by
  change toOverlapAlgHom n R i i'
        (MvPolynomial.aeval (fun l ↦ normalizedCoordinate n R i l) H) =
      hypersurfaceTransition n R i i' ^ d *
        fromOtherToOverlapAlgHom n R i i'
          (MvPolynomial.aeval (fun l ↦ normalizedCoordinate n R i' l) H)
  have hleft := hypersurface_map_aeval_algHom
    (toOverlapAlgHom n R i i')
    (fun l ↦ normalizedCoordinate n R i l) H
  have hright := hypersurface_map_aeval_algHom
    (fromOtherToOverlapAlgHom n R i i')
    (fun l ↦ normalizedCoordinate n R i' l) H
  rw [hleft, hright]
  change MvPolynomial.aeval
      (fun l ↦ toOverlap n R i i' (normalizedCoordinate n R i l)) H =
    hypersurfaceTransition n R i i' ^ d *
      MvPolynomial.aeval
        (fun l ↦ fromOtherToOverlap n R i i'
          (normalizedCoordinate n R i' l)) H
  have hscale := aeval_smul_point_of_isHomogeneous hH
    (hypersurfaceTransition n R i i')
    (fun l ↦ fromOtherToOverlap n R i i'
      (normalizedCoordinate n R i' l))
  rw [← hscale]
  apply congrArg (fun x : Fin (n + 1) → OverlapRing n R i i' ↦
    MvPolynomial.aeval x H)
  funext l
  exact toOverlap_normalizedCoordinate n R i i' l

/-- The two restricted chart equations generate the same ideal on their overlap. -/
theorem span_hypersurfaceChartEquation_overlap
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1))
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d) :
    Ideal.span
        {toOverlap n R i i' (hypersurfaceChartEquation n R i H)} =
      Ideal.span
        {fromOtherToOverlap n R i i' (hypersurfaceChartEquation n R i' H)} := by
  rw [hypersurfaceChartEquation_overlap n R i i' H hH]
  exact Ideal.span_singleton_mul_left_unit
    ((isUnit_hypersurfaceTransition n R i i').pow d) _

private lemma hypersurface_ideal_comap_ofIdealTop_eq_map_appTop
    {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (I : Ideal Γ(Y, ⊤)) (f : X ⟶ Y) [IsOpenImmersion f] :
    ((Scheme.IdealSheafData.ofIdealTop I).comap f).ideal
        ⟨⊤, isAffineOpen_top X⟩ = Ideal.map f.appTop.hom I := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
  rw [Scheme.IdealSheafData.ofIdealTop_ideal]
  let U : Y.Opens := f ''ᵁ (⊤ : X.Opens)
  let e : Γ(Y, U) ≃+* Γ(X, ⊤) :=
    (f.appIso (⊤ : X.Opens)).commRingCatIsoToRingEquiv
  let J : Ideal Γ(Y, U) :=
    Ideal.map (Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom I
  change Ideal.comap e.symm.toRingHom J = _
  calc
    _ = Ideal.map e.toRingHom J := (Ideal.map_comap_of_equiv (I := J) e).symm
    _ = Ideal.map f.appTop.hom I := by
      dsimp only [J]
      rw [Ideal.map_map]
      congr 1
      change
        (Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫
          (f.appIso (⊤ : X.Opens)).hom).hom = f.appTop.hom
      congr 1
      rw [Scheme.Hom.appIso_hom']
      rw [f.map_appLE
        (V := (⊤ : X.Opens)) (U := U) (U' := ⊤)
        ((f.preimage_image_eq (⊤ : X.Opens)).ge)
        (homOfLE (le_top : U ≤ ⊤)).op]
      unfold Scheme.Hom.appLE
      change f.appTop ≫ _ = f.appTop
      rw [← Category.comp_id f.appTop]
      congr 1
      rw [← X.presheaf.map_id]
      exact congrArg X.presheaf.map (Subsingleton.elim _ _)

@[reassoc]
theorem overlapToChart_appTop_hypersurfaceChartΓIso
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1)) :
    (Spec.map (CommRingCat.ofHom (toOverlap n R i i'))).appTop ≫
        (Scheme.ΓSpecIso (.of (OverlapRing n R i i'))).hom =
      (hypersurfaceChartΓIso n R i).hom ≫
        CommRingCat.ofHom (toOverlap n R i i') := by
  exact Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (toOverlap n R i i'))

@[reassoc]
theorem overlapToOtherChart_appTop_hypersurfaceChartΓIso
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1)) :
    (Spec.map (CommRingCat.ofHom (fromOtherToOverlap n R i i'))).appTop ≫
        (Scheme.ΓSpecIso (.of (OverlapRing n R i i'))).hom =
      (hypersurfaceChartΓIso n R i').hom ≫
        CommRingCat.ofHom (fromOtherToOverlap n R i i') := by
  exact Scheme.ΓSpecIso_naturality
    (CommRingCat.ofHom (fromOtherToOverlap n R i i'))

private lemma map_hypersurfaceChartIdealTop_toOverlap
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1))
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d) :
    Ideal.map (toOverlap n R i i')
        (Ideal.span {hypersurfaceChartEquation n R i H}) =
      Ideal.map (fromOtherToOverlap n R i i')
        (Ideal.span {hypersurfaceChartEquation n R i' H}) := by
  rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton]
  exact span_hypersurfaceChartEquation_overlap n R i i' H hH

private lemma map_hypersurfaceChartIdealTop_chartΓIso
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    Ideal.map (hypersurfaceChartΓIso n R i).hom.hom
        (hypersurfaceChartIdealTop n R i H) =
      Ideal.span {hypersurfaceChartEquation n R i H} := by
  unfold hypersurfaceChartIdealTop
  rw [Ideal.map_span, Set.image_singleton,
    hypersurfaceChartΓIso_hom_equationSection]

/-- The local principal ideal sheaves agree on standard-chart overlaps. -/
theorem hypersurfaceChartIdealSheaf_comap_overlap_eq
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1))
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d) :
    (hypersurfaceChartIdealSheaf n R i H).comap
        (Spec.map (CommRingCat.ofHom (toOverlap n R i i'))) =
      (hypersurfaceChartIdealSheaf n R i' H).comap
        (Spec.map (CommRingCat.ofHom (fromOtherToOverlap n R i i'))) := by
  let h := overlap_isPullback n R i i'
  letI : IsOpenImmersion
      (Spec.map (CommRingCat.ofHom (toOverlap n R i i'))) :=
    IsOpenImmersion.of_isPullback h.flip inferInstance
  letI : IsOpenImmersion
      (Spec.map (CommRingCat.ofHom (fromOtherToOverlap n R i i'))) :=
    IsOpenImmersion.of_isPullback h inferInstance
  apply Scheme.IdealSheafData.ext_of_isAffine
  unfold hypersurfaceChartIdealSheaf
  rw [hypersurface_ideal_comap_ofIdealTop_eq_map_appTop]
  rw [hypersurface_ideal_comap_ofIdealTop_eq_map_appTop]
  let E : Γ(Spec (.of (OverlapRing n R i i')), ⊤) ≃+* OverlapRing n R i i' :=
    (Scheme.ΓSpecIso (.of (OverlapRing n R i i'))).commRingCatIsoToRingEquiv
  have hleft : E.toRingHom.comp
      (Spec.map (CommRingCat.ofHom (toOverlap n R i i'))).appTop.hom =
        (toOverlap n R i i').comp (hypersurfaceChartΓIso n R i).hom.hom := by
    exact congrArg CommRingCat.Hom.hom
      (overlapToChart_appTop_hypersurfaceChartΓIso n R i i')
  have hright : E.toRingHom.comp
      (Spec.map (CommRingCat.ofHom (fromOtherToOverlap n R i i'))).appTop.hom =
        (fromOtherToOverlap n R i i').comp
          (hypersurfaceChartΓIso n R i').hom.hom := by
    exact congrArg CommRingCat.Hom.hom
      (overlapToOtherChart_appTop_hypersurfaceChartΓIso n R i i')
  have hmapped :
      Ideal.map E.toRingHom
          (Ideal.map
            (Spec.map (CommRingCat.ofHom (toOverlap n R i i'))).appTop.hom
            (hypersurfaceChartIdealTop n R i H)) =
        Ideal.map E.toRingHom
          (Ideal.map
            (Spec.map
              (CommRingCat.ofHom (fromOtherToOverlap n R i i'))).appTop.hom
            (hypersurfaceChartIdealTop n R i' H)) := by
    rw [Ideal.map_map, Ideal.map_map, hleft, hright]
    rw [← Ideal.map_map, ← Ideal.map_map]
    rw [map_hypersurfaceChartIdealTop_chartΓIso,
      map_hypersurfaceChartIdealTop_chartΓIso]
    exact map_hypersurfaceChartIdealTop_toOverlap n R i i' H hH
  have hback := congrArg (Ideal.map E.symm.toRingHom) hmapped
  have hcancel (K : Ideal Γ(Spec (.of (OverlapRing n R i i')), ⊤)) :
      Ideal.map E.symm.toRingHom (Ideal.map E.toRingHom K) = K :=
    Ideal.map_of_equiv E
  rw [hcancel, hcancel] at hback
  exact hback

/-- The global ideal sheaf obtained by descending the homogeneous chart equations. -/
def projectiveZeroLocusIdeal
    (n : ℕ) (R : Type u) [CommRing R]
    (H : MvPolynomial (Fin (n + 1)) R) :
    (ProjectiveSpace n R).IdealSheafData :=
  ⨅ i : Fin (n + 1),
    (hypersurfaceChartIdealSheaf n R i H).map (standardChartι n R i)

/-- The projective hypersurface cut out by `H`. -/
abbrev projectiveZeroLocus
    (n : ℕ) (R : Type u) [CommRing R]
    (H : MvPolynomial (Fin (n + 1)) R) : Scheme.{u} :=
  (projectiveZeroLocusIdeal n R H).subscheme

/-- Its canonical closed immersion into projective space. -/
abbrev projectiveZeroLocusι
    (n : ℕ) (R : Type u) [CommRing R]
    (H : MvPolynomial (Fin (n + 1)) R) :
    projectiveZeroLocus n R H ⟶ ProjectiveSpace n R :=
  (projectiveZeroLocusIdeal n R H).subschemeι

theorem ker_projectiveZeroLocusι
    (n : ℕ) (R : Type u) [CommRing R]
    (H : MvPolynomial (Fin (n + 1)) R) :
    (projectiveZeroLocusι n R H).ker = projectiveZeroLocusIdeal n R H :=
  Scheme.IdealSheafData.ker_subschemeι _

/-- A local chart ideal is contained in every other chart's extended ideal. -/
theorem hypersurfaceChartIdealSheaf_le_comap_map
    (n : ℕ) (R : Type u) [CommRing R] (i i' : Fin (n + 1))
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d) :
    hypersurfaceChartIdealSheaf n R i' H ≤
      ((hypersurfaceChartIdealSheaf n R i H).map
        (standardChartι n R i)).comap (standardChartι n R i') := by
  apply Scheme.IdealSheafData.le_comap_map_of_isPullback
    (Spec.map (CommRingCat.ofHom (toOverlap n R i i')))
    (Spec.map (CommRingCat.ofHom (fromOtherToOverlap n R i i')))
    (standardChartι n R i) (standardChartι n R i')
    (overlap_isPullback n R i i')
  exact hypersurfaceChartIdealSheaf_comap_overlap_eq n R i i' H hH

/-- The descended global ideal restricts to the prescribed principal chart ideal. -/
theorem projectiveZeroLocusIdeal_comap_standardChartι
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    (projectiveZeroLocusIdeal n R H).comap (standardChartι n R i) =
      hypersurfaceChartIdealSheaf n R i H := by
  apply Scheme.IdealSheafData.finiteOpenClosure_comap_eq
    (fun j : Fin (n + 1) ↦ Spec (.of (StandardChartRing n R j)))
    (fun j ↦ standardChartι n R j)
    (fun j ↦ hypersurfaceChartIdealSheaf n R j H) i
  intro j j'
  exact hypersurfaceChartIdealSheaf_le_comap_map n R j j' H hH

/-- A chartwise zero locus is the pullback of the global projective hypersurface. -/
noncomputable def hypersurfaceChartIsoPullback
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    (hypersurfaceChartIdealSheaf n R i H).subscheme ≅
      pullback (standardChartι n R i) (projectiveZeroLocusι n R H) := by
  let ι := pullback.fst (standardChartι n R i) (projectiveZeroLocusι n R H)
  let ι' := (hypersurfaceChartIdealSheaf n R i H).subschemeι
  have hker : ι.ker = ι'.ker := by
    rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,
      ker_projectiveZeroLocusι,
      projectiveZeroLocusIdeal_comap_standardChartι n R H hH i,
      Scheme.IdealSheafData.ker_subschemeι]
  let f := IsClosedImmersion.lift ι ι' hker.le
  letI : IsIso f := IsClosedImmersion.isIso_lift ι ι' hker
  exact asIso f

@[reassoc]
theorem hypersurfaceChartIsoPullback_hom_fst
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    (hypersurfaceChartIsoPullback n R H hH i).hom ≫ pullback.fst _ _ =
      (hypersurfaceChartIdealSheaf n R i H).subschemeι := by
  change IsClosedImmersion.lift _ _ _ ≫ _ = _
  exact IsClosedImmersion.lift_fac _ _ _

/-- The canonical open immersion from a chartwise hypersurface to the global hypersurface. -/
def hypersurfaceChartToGlobal
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    (hypersurfaceChartIdealSheaf n R i H).subscheme ⟶
      projectiveZeroLocus n R H :=
  (hypersurfaceChartIsoPullback n R H hH i).hom ≫
    pullback.snd (standardChartι n R i) (projectiveZeroLocusι n R H)

@[reassoc]
theorem hypersurfaceChartToGlobal_ι
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    hypersurfaceChartToGlobal n R H hH i ≫ projectiveZeroLocusι n R H =
      (hypersurfaceChartIdealSheaf n R i H).subschemeι ≫
        standardChartι n R i := by
  unfold hypersurfaceChartToGlobal
  rw [Category.assoc, ← pullback.condition]
  rw [← Category.assoc, hypersurfaceChartIsoPullback_hom_fst]

instance
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    IsOpenImmersion (hypersurfaceChartToGlobal n R H hH i) := by
  unfold hypersurfaceChartToGlobal
  infer_instance

/-- The range of a hypersurface chart is the inverse image of the ambient standard chart. -/
theorem opensRange_hypersurfaceChartToGlobal
    (n : ℕ) (R : Type u) [CommRing R]
    {d : ℕ} (H : MvPolynomial (Fin (n + 1)) R) (hH : H.IsHomogeneous d)
    (i : Fin (n + 1)) :
    (hypersurfaceChartToGlobal n R H hH i).opensRange =
      projectiveZeroLocusι n R H ⁻¹ᵁ standardChart n R i := by
  rw [← opensRange_standardChartι n R i]
  rw [← Scheme.Hom.opensRange_pullbackSnd
    (standardChartι n R i) (projectiveZeroLocusι n R H)]
  apply TopologicalSpace.Opens.ext
  change Set.range (hypersurfaceChartToGlobal n R H hH i).base = _
  unfold hypersurfaceChartToGlobal
  rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
    Set.range_eq_univ.mpr
      ((hypersurfaceChartIsoPullback n R H hH i).hom.surjective),
    Set.image_univ]
  rfl

/-! ## Explicit affine quotient presentation -/

/-- Global chart sections expressed as an ordinary affine polynomial ring. -/
noncomputable def hypersurfaceChartSectionsEquivMvPolynomial
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1)) :
    Γ(Spec (.of (StandardChartRing n R i)), ⊤) ≃+* MvPolynomial (Fin n) R :=
  (hypersurfaceChartΓIso n R i).commRingCatIsoToRingEquiv.trans
    (standardChartRingEquivMvPolynomial n R i).toRingEquiv

theorem map_hypersurfaceChartIdealTop_sectionsEquiv
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    Ideal.map (hypersurfaceChartSectionsEquivMvPolynomial n R i)
        (hypersurfaceChartIdealTop n R i H) =
      Ideal.span {chartDehomogenization n R i H} := by
  unfold hypersurfaceChartIdealTop
  rw [Ideal.map_span, Set.image_singleton]
  apply congrArg (Ideal.span : Set (MvPolynomial (Fin n) R) → _)
  apply congrArg (fun x : MvPolynomial (Fin n) R ↦ ({x} : Set _))
  rw [hypersurfaceChartSectionsEquivMvPolynomial]
  change standardChartRingEquivMvPolynomial n R i
      ((hypersurfaceChartΓIso n R i).hom
        (hypersurfaceChartEquationSection n R i H)) = _
  rw [hypersurfaceChartΓIso_hom_equationSection]
  change standardChartToMvPolynomial n R i
      (MvPolynomial.aeval (fun l ↦ normalizedCoordinate n R i l) H) = _
  calc
    _ = standardChartToMvPolynomial n R i
        (mvPolynomialToStandardChart n R i
          (chartDehomogenization n R i H)) := by
      congr 1
      exact (DFunLike.congr_fun
        (mvPolynomialToStandardChart_comp_chartDehomogenization n R i) H).symm
    _ = chartDehomogenization n R i H := by
      exact DFunLike.congr_fun
        (standardChartToMvPolynomial_comp_mvPolynomialToStandardChart n R i)
        (chartDehomogenization n R i H)

/-- The quotient of chart sections is the explicit dehomogenized hypersurface ring. -/
noncomputable def hypersurfaceChartIdealQuotientEquivMvPolynomial
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (Γ(Spec (.of (StandardChartRing n R i)), ⊤) ⧸
      (hypersurfaceChartIdealSheaf n R i H).ideal
        ⟨⊤, isAffineOpen_top _⟩) ≃+*
      (MvPolynomial (Fin n) R ⧸
        Ideal.span {chartDehomogenization n R i H}) :=
  Ideal.quotientEquiv
    ((hypersurfaceChartIdealSheaf n R i H).ideal
      ⟨⊤, isAffineOpen_top _⟩)
    (Ideal.span {chartDehomogenization n R i H})
    (hypersurfaceChartSectionsEquivMvPolynomial n R i)
    (by
      rw [hypersurfaceChartIdealSheaf_ideal_top]
      exact (map_hypersurfaceChartIdealTop_sectionsEquiv n R i H).symm)

instance hypersurfaceChartSubschemeCoverTopIsIso
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    IsIso ((hypersurfaceChartIdealSheaf n R i H).subschemeCover.f
      ⟨⊤, isAffineOpen_top _⟩) := by
  let q := (hypersurfaceChartIdealSheaf n R i H).subschemeCover.f
    ⟨⊤, isAffineOpen_top _⟩
  letI : Epi q.base := by
    rw [TopCat.epi_iff_surjective]
    intro x
    rw [← Set.mem_range, ← Scheme.Hom.coe_opensRange]
    simp [q]
  exact IsOpenImmersion.isIso q

/-- A projective hypersurface chart is the spectrum of the dehomogenized quotient. -/
noncomputable def hypersurfaceChartIsoSpecAffineQuotient
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (hypersurfaceChartIdealSheaf n R i H).subscheme ≅
      Spec (.of (MvPolynomial (Fin n) R ⧸
        Ideal.span {chartDehomogenization n R i H})) :=
  (asIso ((hypersurfaceChartIdealSheaf n R i H).subschemeCover.f
    ⟨⊤, isAffineOpen_top _⟩)).symm ≪≫
    Scheme.Spec.mapIso
      (hypersurfaceChartIdealQuotientEquivMvPolynomial
        n R i H).symm.toCommRingCatIso.op

/-- The standard-chart ring maps to the explicit affine hypersurface quotient by ordinary
dehomogenization coordinates followed by the quotient map. -/
def hypersurfaceAffineChartQuotientMap
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    StandardChartRing n R i →+*
      (MvPolynomial (Fin n) R ⧸
        Ideal.span {chartDehomogenization n R i H}) :=
  (Ideal.Quotient.mk
      (Ideal.span {chartDehomogenization n R i H})).comp
    (standardChartRingEquivMvPolynomial n R i).toRingHom

/-- Ordinary affine coordinates send every normalized homogeneous coordinate to the
dehomogenization of the corresponding variable. -/
theorem standardChartRingEquivMvPolynomial_normalizedCoordinate_eq_chartDehomogenization_X
    (n : ℕ) (R : Type u) [CommRing R] (i l : Fin (n + 1)) :
    standardChartRingEquivMvPolynomial n R i
        (normalizedCoordinate n R i l) =
      chartDehomogenization n R i (MvPolynomial.X l) := by
  rcases Fin.eq_self_or_eq_succAbove i l with rfl | ⟨r, rfl⟩
  · rw [normalizedCoordinate_self, chartDehomogenization_X_self]
    exact map_one _
  · rw [standardChartRingEquivMvPolynomial_normalizedCoordinate_succAbove,
      chartDehomogenization_X_succAbove]

@[reassoc]
theorem hypersurfaceChartSubschemeCover_comp_isoSpecAffineQuotient
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (hypersurfaceChartIdealSheaf n R i H).subschemeCover.f
        ⟨⊤, isAffineOpen_top _⟩ ≫
      (hypersurfaceChartIsoSpecAffineQuotient n R i H).hom =
    Spec.map
      (hypersurfaceChartIdealQuotientEquivMvPolynomial
        n R i H).symm.toCommRingCatIso.hom := by
  unfold hypersurfaceChartIsoSpecAffineQuotient
  simp
  rfl

private theorem hypersurface_subschemeCover_map_subschemeι_fromSpec
    {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens) :
    I.subschemeCover.f U ≫ I.subschemeι =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.ideal U))) ≫
        U.2.fromSpec := by
  rw [Scheme.IdealSheafData.subschemeCover_map_subschemeι,
    Scheme.IdealSheafData.glueDataObjι_ι]

set_option backward.isDefEq.respectTransparency false in
/-- Under the explicit affine quotient presentation, the chart's inclusion into the ambient
standard projective chart is induced by `hypersurfaceAffineChartQuotientMap`. -/
theorem hypersurfaceChartIsoSpecAffineQuotient_hom_subschemeι
    (n : ℕ) (R : Type u) [CommRing R] (i : Fin (n + 1))
    (H : MvPolynomial (Fin (n + 1)) R) :
    (hypersurfaceChartIsoSpecAffineQuotient n R i H).hom ≫
        Spec.map (CommRingCat.ofHom
          (hypersurfaceAffineChartQuotientMap n R i H)) =
      (hypersurfaceChartIdealSheaf n R i H).subschemeι := by
  rw [← cancel_epi
    ((hypersurfaceChartIdealSheaf n R i H).subschemeCover.f
      ⟨⊤, isAffineOpen_top _⟩)]
  rw [← Category.assoc,
    hypersurfaceChartSubschemeCover_comp_isoSpecAffineQuotient]
  rw [← Spec.map_comp]
  rw [hypersurface_subschemeCover_map_subschemeι_fromSpec]
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
  rw [← Spec.map_comp]
  congr 1
  ext a
  change
    (hypersurfaceChartIdealQuotientEquivMvPolynomial n R i H).symm
        (hypersurfaceAffineChartQuotientMap n R i H a) =
      Ideal.Quotient.mk _ ((hypersurfaceChartΓIso n R i).inv a)
  apply (hypersurfaceChartIdealQuotientEquivMvPolynomial n R i H).injective
  rw [RingEquiv.apply_symm_apply]
  unfold hypersurfaceChartIdealQuotientEquivMvPolynomial
  rw [Ideal.quotientEquiv_mk]
  unfold hypersurfaceAffineChartQuotientMap
  unfold hypersurfaceChartSectionsEquivMvPolynomial
  change
    Ideal.Quotient.mk _ (standardChartRingEquivMvPolynomial n R i a) =
      Ideal.Quotient.mk _
        (standardChartRingEquivMvPolynomial n R i
          ((hypersurfaceChartΓIso n R i).hom
            ((hypersurfaceChartΓIso n R i).inv a)))
  rw [Iso.inv_hom_id_apply]


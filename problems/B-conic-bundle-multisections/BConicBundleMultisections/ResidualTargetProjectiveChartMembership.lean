module

public import BConicBundleMultisections.BiprojectiveTwoEquationAffine
public import BConicBundleMultisections.ResidualTargetExhaustionMembership

/-!
# Projective target-relation containment on affine charts

Scheme-theoretic exhaustion of a target relation says that the ideal sheaf of the residual
equation is contained in the target-relation ideal sheaf.  This is a saturated/projective
statement; it does **not** imply membership in the unsaturated Cox ideal at the irrelevant cone.

This file records its exact affine-chart consequence.  On every standard biprojective chart, the
dehomogenized residual equation belongs to the ideal generated by the dehomogenizations of `F`
and the lifted target relation `H`.  This is the correct input for the negative-twist argument on
the projective relation curve.
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry Matrix

namespace BConicBundleMultisections

noncomputable section

universe u

open AlgebraicGeometry
open _root_.MvPolynomial

namespace BiprojectiveSpace

/-- Scheme-theoretic exhaustion gives literal two-equation membership after dehomogenizing on
any standard biprojective chart. -/
theorem affineChartEquation_residualEquationOn_mem_targetRelationChart_of_isIso
    {k : Type u} [Field k]
    (p₀ q₀ r : Fin 3 → k) (N : Matrix (Fin 3) (Fin 3) k)
    (hMN : lineFrame p₀ q₀ r * N = 1)
    (F : MvPolynomial (BiprojectiveCoordinate 2 2) k) (hF : IsBidegree23 F)
    (v : Fin 3 → Polynomial k)
    (hv : TernaryQuadraticPoly.eval (lineTernaryQuadraticPoly p₀ q₀ F) v = 0)
    (i j : Fin 3) {d : ℕ} (H : MvPolynomial (Fin 3) k)
    (hH : H.IsHomogeneous d)
    (hvan : aeval (residualYCoordsOn p₀ q₀ r N F v) H = 0)
    [IsIso (residualTargetComponentOnι
      p₀ q₀ r N hMN F hF v hv i j H hH hvan)]
    (a b : Fin 3) :
    affineChartEquation 2 2 k a b
        (residualEquationOn (lineFrame p₀ q₀ r) N F) ∈
      twoEquationAffineChartIdeal 2 2 k a b F
        (MvPolynomial.rename
          (Sum.inr : Fin 3 → BiprojectiveCoordinate 2 2) H) := by
  let Q := residualEquationOn (lineFrame p₀ q₀ r) N F
  have hglobal : biprojectiveZeroLocusIdeal 2 2 k Q ≤ targetRelationIdeal F H :=
    biprojectiveZeroLocusIdeal_residualEquationOn_le_targetRelationIdeal_of_isIso
      p₀ q₀ r N hMN F hF v hv i j H hH hvan
  have hlocal := Scheme.IdealSheafData.comap_mono
    (standardChartι 2 2 k a b) hglobal
  change (biprojectiveZeroLocusIdeal 2 2 k Q).comap
      (standardChartι 2 2 k a b) ≤
    (targetRelationIdeal F H).comap (standardChartι 2 2 k a b) at hlocal
  have hQhom : IsBihomogeneousOfBidegree 10 1 Q :=
    ResidualDivisor.residualEquationOn_isBihomogeneous
      (lineFrame p₀ q₀ r) N hF
  rw [biprojectiveZeroLocusIdeal_comap_standardChartι
      2 2 k Q hQhom,
    targetRelationIdeal_comap_standardChartι F H hF hH a b] at hlocal
  have hsection : chartEquationSection 2 2 k a b Q ∈
      (twoEquationChartIdealSheaf 2 2 k a b F
        (MvPolynomial.rename
          (Sum.inr : Fin 3 → BiprojectiveCoordinate 2 2) H)).ideal
        (chartTopAffineOpen 2 2 k a b) := by
    apply hlocal
    rw [chartIdealSheaf_ideal_chartTopAffineOpen]
    exact chartEquationSection_mem_chartIdealTop 2 2 k a b Q
  have hmapped := Ideal.mem_map_of_mem
    (chartSectionsEquivMvPolynomial 2 2 k a b).toRingHom hsection
  have hsectionEq :
      chartSectionsEquivMvPolynomial 2 2 k a b
          (chartEquationSection 2 2 k a b Q) =
        affineChartEquation 2 2 k a b Q := by
    unfold chartSectionsEquivMvPolynomial
    change standardChartRingEquivMvPolynomial 2 2 k a b
      ((standardChartΓIso 2 2 k a b).hom
        (chartEquationSection 2 2 k a b Q)) = _
    rw [standardChartΓIso_hom_chartEquationSection]
    exact standardChartRingEquivMvPolynomial_chartEquation 2 2 k a b Q
  rw [← map_twoEquationChartIdeal_standardChartRingEquivMvPolynomial
    2 2 k a b F (MvPolynomial.rename Sum.inr H)]
  rw [← hsectionEq]
  exact hmapped

end BiprojectiveSpace

end

end BConicBundleMultisections

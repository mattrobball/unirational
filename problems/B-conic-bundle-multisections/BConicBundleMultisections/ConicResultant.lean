/-!
# Eliminating one variable from two ternary quadratic forms

Read two quadratic forms `q, q' : MvPolynomial (Fin 3) K` as quadratics in `t = X 0` with
coefficients binary forms in `X 1, X 2`:

```
q  = a * t ^ 2 + b * t + c,        q' = a' * t ^ 2 + b' * t + c'
```

with `a, a'` constants, `b, b'` linear and `c, c'` quadratic in `(X 1, X 2)`.  Their **resultant**

```
Res (q, q') = (a * c' - a' * c) ^ 2 - (a * b' - a' * b) * (b * c' - b' * c)
```

is a binary quartic in `(X 1, X 2)`.  This file proves both halves of the elimination statement,
in the concrete form needed downstream: a common projective zero of `q` and `q'` produces a
**nonzero** binary form of degree at most `4` over `K` killing the last two coordinates.

## Main results

* `quadResultant_eq_zero_of_isRoot` — the easy direction, over any commutative ring.  It is a
  `ring` identity (`quadResultant_eq_bezout`), sidestepping Sylvester matrices entirely: the
  resultant lies in the ideal generated by the two quadratics, with explicit cofactors.
* `conicResultant_ne_zero` — the hard direction.  If `q` and `q'` have no common non-unit factor
  **and do not both vanish at the centre of projection `(1 : 0 : 0)`**, the resultant is nonzero.
* `exists_isHomogeneous_ne_zero_aeval_eq_zero` — the packaged form.  Coprimality alone (no
  hypothesis at the centre of projection) already forces a nonzero binary form of degree `≤ 4`
  over `K` to vanish at the last two coordinates of any common zero.
* `exists_polynomial_ne_zero_natDegree_le_four` — the univariate consequence: the coordinate
  ratio is a root of a nonzero polynomial of degree at most `4` over `K`.

## The hypothesis at the centre of projection is necessary

`conicResultant_ne_zero` needs `q` or `q'` to be nonzero at `(1 : 0 : 0)`, i.e. `a ≠ 0` or
`a' ≠ 0`.  This is not an artefact.  Both `X 0 * X 1 + X 2 ^ 2` and `X 0 * X 2 + X 1 ^ 2` are
irreducible and non-associate, yet both have `a = 0`, so their resultant vanishes identically.
See `conicResultant_degenerate_counterexample`.  Geometrically, the resultant of the projection
away from a point that lies on *both* conics carries no information.

The packaged statement `exists_isHomogeneous_ne_zero_aeval_eq_zero` survives that degeneration by
falling back on the binary **cubic** `b * c' - b' * c`, and then on `c` itself.
-/

@[expose] public section

namespace BConicBundleMultisections

noncomputable section

open MvPolynomial

universe u v

/-! ### Divisors of homogeneous polynomials

The substance is `MvPolynomial.exists_isHomogeneous_of_mul_isHomogeneous` in
`BConicBundleMultisections.HomogeneousFactor`; this is the divisibility phrasing. -/

/-- A divisor of a nonzero homogeneous polynomial over a domain is homogeneous, of degree at most
that of the multiple. -/
theorem MvPolynomial.exists_isHomogeneous_of_dvd_isHomogeneous
    {K : Type u} [CommRing K] [IsDomain K] {σ : Type v}
    {p h : MvPolynomial σ K} {n : ℕ} (hp : p.IsHomogeneous n) (hp0 : p ≠ 0) (hdvd : h ∣ p) :
    ∃ m : ℕ, h.IsHomogeneous m ∧ m ≤ n := by
  obtain ⟨g, rfl⟩ := hdvd
  have hh0 : h ≠ 0 := fun hz => hp0 (by rw [hz, zero_mul])
  have hg0 : g ≠ 0 := fun hz => hp0 (by rw [hz, mul_zero])
  obtain ⟨i, j, hi, _, hij⟩ :=
    MvPolynomial.exists_isHomogeneous_of_mul_isHomogeneous hh0 hg0 hp
  exact ⟨i, hi, by omega⟩

/-! ### The resultant of two quadratics -/

section QuadResultant

variable {R : Type u} [CommRing R]

/-- The resultant of the two quadratics `a * t ^ 2 + b * t + c` and `a' * t ^ 2 + b' * t + c'`. -/
def quadResultant (a b c a' b' c' : R) : R :=
  (a * c' - a' * c) ^ 2 - (a * b' - a' * b) * (b * c' - b' * c)

theorem quadResultant_comm (a b c a' b' c' : R) :
    quadResultant a' b' c' a b c = quadResultant a b c a' b' c' := by
  simp only [quadResultant]; ring

/-- **The easy direction, as an identity.**  The resultant is an explicit combination of the two
quadratics, with cofactors of degree at most one in `t`.  No Sylvester matrix, no division, no
hypothesis on `R`. -/
theorem quadResultant_eq_bezout (a b c a' b' c' t : R) :
    quadResultant a b c a' b' c' =
      ((a * c' - a' * c) - (a * b' - a' * b) * t) *
          (a * (a' * t ^ 2 + b' * t + c') - a' * (a * t ^ 2 + b * t + c)) +
        (a * b' - a' * b) *
          (b' * (a * t ^ 2 + b * t + c) - b * (a' * t ^ 2 + b' * t + c')) := by
  simp only [quadResultant]; ring

/-- **The easy direction.**  A common root of two quadratics kills their resultant. -/
theorem quadResultant_eq_zero_of_isRoot {a b c a' b' c' t : R}
    (h : a * t ^ 2 + b * t + c = 0) (h' : a' * t ^ 2 + b' * t + c' = 0) :
    quadResultant a b c a' b' c' = 0 := by
  rw [quadResultant_eq_bezout a b c a' b' c' t, h, h']; ring

/-- Rescaling the first quadratic scales the resultant by the square of the factor. -/
theorem quadResultant_smul_left (l a b c a' b' c' : R) :
    quadResultant (l * a) (l * b) (l * c) a' b' c' = l ^ 2 * quadResultant a b c a' b' c' := by
  simp only [quadResultant]; ring

/-- The resultant, rewritten as `p ^ 2` times the first quadratic evaluated at `-q₂ / p`, where
`p = a * b' - a' * b` and `q₂ = a * c' - a' * c`.  This is the identity that drives the hard
direction. -/
theorem mul_quadResultant (a b c a' b' c' : R) :
    a * quadResultant a b c a' b' c' =
      a * (a * c' - a' * c) ^ 2 - b * (a * b' - a' * b) * (a * c' - a' * c) +
        c * (a * b' - a' * b) ^ 2 := by
  simp only [quadResultant]; ring

/-- If `e` is a root of `a * t ^ 2 - b * t + c`, then `t + e` splits off. -/
theorem quadratic_eq_mul_of_root {a b c e : R} (h : a * e ^ 2 - b * e + c = 0) (t : R) :
    a * t ^ 2 + b * t + c = (t + e) * (a * t + (b - a * e)) := by
  linear_combination h

end QuadResultant

/-! ### Reading a ternary form as a quadratic in `X 0` -/

section Ternary

variable {K : Type u} [Field K]

/-- The `i`-th coefficient of a ternary form read as a polynomial in `X 0`, as a binary form in
`X 1, X 2`. -/
def ternaryCoeff (q : MvPolynomial (Fin 3) K) (i : ℕ) : MvPolynomial (Fin 2) K :=
  (MvPolynomial.finSuccEquiv K 2 q).coeff i

/-- Inclusion of binary forms in `X 1, X 2` into ternary forms. -/
abbrev succEmb : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 3) K :=
  MvPolynomial.rename Fin.succ

theorem succEmb_injective :
    Function.Injective (succEmb : MvPolynomial (Fin 2) K → MvPolynomial (Fin 3) K) :=
  MvPolynomial.rename_injective _ (Fin.succ_injective 2)

theorem finSuccEquiv_succEmb (u : MvPolynomial (Fin 2) K) :
    MvPolynomial.finSuccEquiv K 2 (succEmb u) = Polynomial.C u := by
  induction u using MvPolynomial.induction_on with
  | C r => simp [MvPolynomial.finSuccEquiv_apply]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp, MvPolynomial.finSuccEquiv_X_succ]

@[simp]
theorem ternaryCoeff_succEmb_mul_X_pow (u : MvPolynomial (Fin 2) K) (k i : ℕ) :
    ternaryCoeff (succEmb u * MvPolynomial.X 0 ^ k) i = if i = k then u else 0 := by
  simp only [ternaryCoeff, map_mul, map_pow, finSuccEquiv_succEmb,
    MvPolynomial.finSuccEquiv_X_zero, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
  split <;> simp_all

theorem ternaryCoeff_isHomogeneous {q : MvPolynomial (Fin 3) K} {n : ℕ}
    (hq : q.IsHomogeneous n) (i j : ℕ) (h : i + j = n) :
    (ternaryCoeff q i).IsHomogeneous j :=
  hq.finSuccEquiv_coeff_isHomogeneous i j h

/-- A ternary quadratic form is `a * X 0 ^ 2 + b * X 0 + c` with `a, b, c` its `X 0`-coefficients,
read as binary forms. -/
theorem ternary_decomposition {q : MvPolynomial (Fin 3) K} (hq : q.IsHomogeneous 2) :
    q = succEmb (ternaryCoeff q 2) * MvPolynomial.X 0 ^ 2 +
      succEmb (ternaryCoeff q 1) * MvPolynomial.X 0 + succEmb (ternaryCoeff q 0) := by
  have hdeg : (MvPolynomial.finSuccEquiv K 2 q).natDegree ≤ 2 := by
    rw [MvPolynomial.natDegree_finSuccEquiv]
    exact le_trans (MvPolynomial.degreeOf_le_totalDegree q 0) hq.totalDegree_le
  refine (MvPolynomial.finSuccEquiv K 2).injective ?_
  simp only [map_add, map_mul, map_pow, finSuccEquiv_succEmb,
    MvPolynomial.finSuccEquiv_X_zero]
  refine Polynomial.ext fun n => ?_
  match n with
  | 0 => simp [ternaryCoeff]
  | 1 => simp [ternaryCoeff]
  | 2 => simp [ternaryCoeff]
  | (n + 3) =>
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
      simp [ternaryCoeff, Polynomial.coeff_C, Polynomial.coeff_X_pow]

/-- Evaluating the inclusion of a binary form at a ternary point ignores the first coordinate. -/
theorem aeval_succEmb {L : Type v} [CommRing L] [Algebra K L] (t u v : L)
    (w : MvPolynomial (Fin 2) K) :
    MvPolynomial.aeval ![t, u, v] (succEmb w) = MvPolynomial.aeval ![u, v] w := by
  rw [succEmb, MvPolynomial.aeval_rename]
  congr 1

/-- The value of a ternary quadratic form at `(t, u, v)`, expanded in `t`. -/
theorem aeval_ternary_decomposition {L : Type v} [CommRing L] [Algebra K L]
    {q : MvPolynomial (Fin 3) K} (hq : q.IsHomogeneous 2) (t u v : L) :
    MvPolynomial.aeval ![t, u, v] q =
      MvPolynomial.aeval ![u, v] (ternaryCoeff q 2) * t ^ 2 +
        MvPolynomial.aeval ![u, v] (ternaryCoeff q 1) * t +
        MvPolynomial.aeval ![u, v] (ternaryCoeff q 0) := by
  conv_lhs => rw [ternary_decomposition hq]
  simp [aeval_succEmb]

/-- A degree-zero homogeneous polynomial is a constant. -/
theorem eq_C_of_isHomogeneous_zero {σ : Type*} {p : MvPolynomial σ K} (h : p.IsHomogeneous 0) :
    p = MvPolynomial.C (MvPolynomial.coeff 0 p) := by
  conv_lhs => rw [← MvPolynomial.homogeneousComponent_eq_self h]
  exact MvPolynomial.homogeneousComponent_zero p

/-- A homogeneous polynomial of positive degree vanishes at the origin. -/
theorem aeval_zero_of_isHomogeneous {σ : Type*} {L : Type v} [CommRing L] [Algebra K L]
    {p : MvPolynomial σ K} {n : ℕ} (h : p.IsHomogeneous n) (hn : n ≠ 0) :
    MvPolynomial.aeval (fun _ => (0 : L)) p = 0 := by
  simpa [zero_pow hn] using
    aeval_smul_point_of_isHomogeneous (S := L) h 0 (fun _ => (0 : L))

/-- The leading `X 0`-coefficient is the constant given by the value of the form at the centre of
projection `(1 : 0 : 0)`. -/
theorem ternaryCoeff_two_eq_C {q : MvPolynomial (Fin 3) K} (hq : q.IsHomogeneous 2) :
    ternaryCoeff q 2 = MvPolynomial.C (MvPolynomial.eval ![1, 0, 0] q) := by
  have ha : (ternaryCoeff q 2).IsHomogeneous 0 := ternaryCoeff_isHomogeneous hq 2 0 rfl
  have hz : (![0, 0] : Fin 2 → K) = fun _ => 0 := by funext i; fin_cases i <;> rfl
  have hb : MvPolynomial.aeval (![0, 0] : Fin 2 → K) (ternaryCoeff q 1) = 0 := by
    rw [hz]
    exact aeval_zero_of_isHomogeneous (ternaryCoeff_isHomogeneous hq 1 1 rfl) one_ne_zero
  have hc : MvPolynomial.aeval (![0, 0] : Fin 2 → K) (ternaryCoeff q 0) = 0 := by
    rw [hz]
    exact aeval_zero_of_isHomogeneous (ternaryCoeff_isHomogeneous hq 0 2 rfl) two_ne_zero
  have hcoeff : MvPolynomial.coeff 0 (ternaryCoeff q 2) =
      MvPolynomial.aeval (![0, 0] : Fin 2 → K) (ternaryCoeff q 2) := by
    conv_rhs => rw [eq_C_of_isHomogeneous_zero ha]
    simp
  have key := aeval_ternary_decomposition (L := K) hq 1 0 0
  conv_lhs => rw [eq_C_of_isHomogeneous_zero ha]
  congr 1
  rw [hcoeff]
  show _ = MvPolynomial.aeval ![(1 : K), 0, 0] q
  rw [key, hb, hc]
  ring

end Ternary

end

end BConicBundleMultisections
